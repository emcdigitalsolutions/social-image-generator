<%- include('layout', { title, user }) %>

<style>
  .plan-actions { display:flex; gap:8px; flex-wrap:wrap; }
  .json-editor-card { margin-top:24px; }
  .json-editor-card .card-header { display:flex; align-items:center; justify-content:space-between; }
  .json-toolbar { display:flex; gap:6px; align-items:center; }
  #json-editor {
    width:100%; min-height:400px; font-family: 'SF Mono', Menlo, Monaco, Consolas, monospace;
    font-size:12px; line-height:1.45; padding:12px;
    border:1px solid var(--gray-200); border-radius:6px; background:#fafafa;
    resize:vertical; tab-size:2;
  }
  #json-editor.has-error { border-color:var(--red); background:#fef2f2; }
  #json-error { color:var(--red); font-size:12px; margin-top:6px; display:none; }
  .raw-warning {
    background:#fef3c7; border:1px solid #fde047; border-radius:6px;
    padding:12px; margin-bottom:16px; font-size:13px; color:#854d0e;
  }
  .month-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:10px; }
  .month-card {
    display:block; padding:12px 14px;
    background:white; border:1px solid var(--gray-200); border-radius:8px;
    text-decoration:none; color:inherit; transition: border-color .1s, box-shadow .15s, transform .1s;
  }
  .month-card:hover { border-color:var(--blue); box-shadow:0 4px 12px rgba(59,130,246,.12); transform:translateY(-1px); }
  .month-card .mc-title { font-weight:700; font-size:14px; color:var(--gray-800); margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; }
  .month-card .mc-total { font-size:11px; color:var(--gray-400); font-weight:500; }
  .month-card .mc-bar { display:flex; height:6px; border-radius:3px; overflow:hidden; background:var(--gray-100); margin-bottom:8px; }
  .month-card .mc-bar > span { display:block; height:100%; }
  .month-card .mc-bar .seg-published { background:#059669; }
  .month-card .mc-bar .seg-ready     { background:#10b981; }
  .month-card .mc-bar .seg-wip       { background:#3b82f6; }
  .month-card .mc-bar .seg-draft     { background:#9ca3af; }
  .month-card .mc-bar .seg-failed    { background:#dc2626; }
  .month-card .mc-stats { display:flex; flex-wrap:wrap; gap:6px 10px; font-size:11px; color:var(--gray-600); }
  .month-card .mc-stats span { display:inline-flex; align-items:center; gap:3px; }
  .month-card .mc-dot { width:8px; height:8px; border-radius:50%; display:inline-block; }
  .month-card.empty { background:var(--gray-50); border-style:dashed; color:var(--gray-400); }

  /* Approval section */
  .approvals-card { margin-top:24px; }
  .approvals-card .card-header { display:flex; align-items:center; justify-content:space-between; }
  .approval-row {
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:10px 12px; border:1px solid var(--gray-200); border-radius:6px; margin-bottom:6px;
    background:white; flex-wrap:wrap;
  }
  .approval-row .ap-meta { font-size:13px; }
  .approval-row .ap-status {
    padding:3px 10px; border-radius:12px; font-size:11px; font-weight:600; text-transform:uppercase;
  }
  .ap-status.pending           { background:var(--gray-100); color:var(--gray-600); }
  .ap-status.in_review         { background:#dbeafe; color:#1e3a8a; }
  .ap-status.approved          { background:#dcfce7; color:#15803d; }
  .ap-status.changes_requested { background:#fef3c7; color:#b45309; }
  .ap-status.expired           { background:#fee2e2; color:#991b1b; }
  .approval-row .ap-actions { display:flex; gap:6px; }
  .approval-row .ap-link {
    flex:1; padding:6px 10px; background:var(--gray-50); border:1px solid var(--gray-200);
    border-radius:4px; font-family:monospace; font-size:11px; user-select:all; min-width:200px;
    color:var(--gray-700);
  }
  .approval-row .ap-counts { font-size:11px; color:var(--gray-500); display:flex; gap:8px; flex-wrap:wrap; }
  .approval-row .ap-counts strong { color:var(--gray-700); }
  .cat-table input,
  .cat-table textarea {
    width:100%; border:1px solid transparent; padding:4px 6px;
    font-size:13px; border-radius:3px; background:transparent;
    font-family: inherit; line-height:1.45;
  }
  .cat-table input:hover,
  .cat-table textarea:hover { border-color:var(--gray-200); background:white; }
  .cat-table input:focus,
  .cat-table textarea:focus { border-color:var(--blue); background:white; outline:none; }
  .cat-table textarea {
    min-height:80px; resize:vertical;
  }
  .cat-table td { vertical-align:top; padding-top:8px; }
  .cat-table .cat-actions { display:flex; gap:4px; white-space:nowrap; }
  .cat-table .cat-actions button { font-size:11px; padding:4px 8px; border:1px solid var(--gray-200); background:white; border-radius:4px; cursor:pointer; color:var(--gray-700); }
  .cat-table .cat-actions button:hover { background:var(--gray-100); }
  .cat-table .cat-actions button.danger:hover { background:#fef2f2; color:var(--red); border-color:#fca5a5; }
  .cat-table .cat-actions button.regen:hover { background:#eff6ff; color:var(--blue); border-color:#93c5fd; }
  .cat-dirty-bar { display:none; align-items:center; justify-content:space-between; gap:10px; padding:10px 14px; margin-top:10px; background:#fef3c7; border:1px solid #fde047; border-radius:6px; font-size:13px; }
  .cat-dirty-bar.show { display:flex; }

  /* Page header sticky: titolo fisso a sinistra, azioni fisse a destra */
  .page-header.plan-header {
    position:sticky; top:0; z-index:20;
    background:white; padding:14px 0; margin:0 0 20px;
    border-bottom:1px solid var(--gray-200);
    gap:16px;
  }
  .page-header.plan-header > div:first-child {
    display:flex; flex-direction:column; gap:4px;
    min-width:0; /* permette ellipsis */
    flex:1 1 auto;
  }
  .page-header.plan-header h1 {
    margin:0;
    font-size:22px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .page-header.plan-header .plan-actions {
    display:flex; gap:6px; flex:0 0 auto; flex-wrap:wrap; justify-content:flex-end;
  }
  @media (max-width:720px) {
    .page-header.plan-header { flex-direction:row; flex-wrap:wrap; }
    .page-header.plan-header .plan-actions { width:100%; justify-content:flex-start; }
  }

  /* Sezioni collassabili: click sull'header per chiudere/riaprire.
     Default: aperte. Stato persistito in localStorage per piano. */
  .card-collapsible > .card-header { cursor:pointer; user-select:none; }
  .card-collapsible > .card-header::after {
    content:''; width:10px; height:10px; margin-left:10px;
    border-right:2px solid var(--gray-500);
    border-bottom:2px solid var(--gray-500);
    transform:rotate(45deg); transition:transform .2s ease;
    align-self:center; flex:none;
  }
  .card-collapsible.card-collapsed > .card-header::after {
    transform:rotate(-45deg);
  }
  .card-collapsible.card-collapsed > :not(.card-header) { display:none !important; }
  /* Stessa idea per sezioni non-card (es. Mesi) */
  .section-collapsible .section-header {
    display:flex; align-items:center; gap:10px; cursor:pointer; user-select:none;
    margin:0 0 6px;
  }
  .section-collapsible .section-header h3 { margin:0; }
  .section-collapsible .section-header::after {
    content:''; width:10px; height:10px;
    border-right:2px solid var(--gray-500);
    border-bottom:2px solid var(--gray-500);
    transform:rotate(45deg); transition:transform .2s ease; flex:none;
  }
  .section-collapsible.section-collapsed .section-header::after { transform:rotate(-45deg); }
  .section-collapsible.section-collapsed .section-body { display:none; }
</style>

<div class="breadcrumb">
  <a href="/dashboard">Clienti</a> / <a href="/dashboard/clients/<%= client.id %>"><%= client.display_name %></a> / Piano Editoriale
</div>

<div class="page-header plan-header">
  <div>
    <h1 title="<%= plan.title || 'Piano Editoriale' %>"><%= plan.title || 'Piano Editoriale' %></h1>
    <span class="badge badge-<%= plan.status %>" style="align-self:flex-start"><%= plan.status %></span>
  </div>
  <div class="plan-actions">
    <button class="btn btn-secondary" onclick="renamePlan()" title="Cambia il nome del piano editoriale">&#9998; Rinomina</button>
    <button class="btn btn-secondary" onclick="duplicatePlan()" title="Crea una copia del piano con tutti i post (senza media e in stato draft)">&#9112; Duplica</button>
    <button class="btn btn-secondary" onclick="exportJson()" title="Scarica il piano come file JSON (re-importabile, con caption correnti)">&#8595; Esporta JSON</button>
    <button class="btn btn-secondary" onclick="exportPdf()" title="Scarica un PDF stampabile del piano">&#8595; Esporta PDF</button>
    <% if (plan.status !== 'active') { %>
      <button class="btn btn-primary" onclick="activatePlan()" title="Attiva il piano: da questo momento i post con status 'ready' e scheduled_date passata verranno pubblicati automaticamente su FB/IG ogni 60s.">▶ Attiva piano</button>
    <% } else { %>
      <button class="btn btn-secondary" onclick="deactivatePlan()" title="Disattiva l'auto-publish (il piano torna a 'confirmed').">⏸ Disattiva</button>
    <% } %>
  </div>
</div>

<% if (plan.ai_raw && !plan.plan_data) { %>
  <div class="raw-warning">
    <strong>&#9888; L'output AI non &egrave; un JSON valido</strong> (probabilmente troncato o malformato).
    L'editor sotto ti permette di modificarlo manualmente. Quando l'hai sistemato, click <em>Salva e ricostruisci post</em> per applicarlo.
  </div>
<% } %>

<% if (plan.plan_data && plan.plan_data.categories) { %>
<div class="card card-collapsible" data-section="categorie" style="margin-bottom:24px">
  <div class="card-header">
    <h3>Categorie</h3>
    <button class="btn btn-sm btn-secondary" onclick="event.stopPropagation();addCategory()">+ Aggiungi categoria</button>
  </div>
  <p style="font-size:12px;color:var(--gray-500);margin:0 0 10px">Modifica codice/nome/frequenza/descrizione direttamente. <em>Rigenera</em> chiama l'AI per ricreare i post draft di quella categoria mantenendo intatto il resto del piano.</p>
  <table class="cat-table">
    <thead><tr><th style="width:80px">Codice</th><th>Nome</th><th style="width:110px">Frequenza</th><th>Descrizione</th><th style="width:170px">Azioni</th></tr></thead>
    <tbody id="categories-tbody"></tbody>
  </table>
  <div class="cat-dirty-bar" id="cat-dirty-bar">
    <span><strong>Modifiche non salvate</strong> alle categorie</span>
    <div style="display:flex;gap:6px">
      <button class="btn btn-sm btn-secondary" onclick="resetCategories()">Annulla</button>
      <button class="btn btn-sm btn-primary" onclick="saveCategories()">Salva categorie</button>
    </div>
  </div>
</div>
<% } %>

<% if (plan.plan_data && plan.plan_data.months) { %>
<div class="section-collapsible" data-section="mesi" style="margin-bottom:24px">
  <div class="section-header"><h3>Mesi</h3></div>
  <div class="section-body">
    <p style="font-size:12px;color:var(--gray-500);margin:0 0 12px">Click su un mese per aprire la vista calendario/lista. La barra colorata mostra a colpo d'occhio lo stato dei post.</p>
<div class="month-grid">
  <% const totalMonths = plan.plan_data.months.length; %>
  <% for (let m = 1; m <= totalMonths; m++) {
    const s = (typeof monthStats !== 'undefined' && monthStats[m]) || { total: 0, draft_count: 0, wip_count: 0, ready_count: 0, published_count: 0, failed_count: 0 };
    const t = s.total || 0;
    const pct = (n) => t > 0 ? (n / t * 100).toFixed(0) + '%' : '0%';
  %>
    <a href="/dashboard/clients/<%= client.id %>/plan/<%= plan.id %>/month/<%= m %>" class="month-card <%= t === 0 ? 'empty' : '' %>">
      <div class="mc-title">
        <span>Mese <%= m %></span>
        <span class="mc-total"><%= t %> post</span>
      </div>
      <% if (t > 0) { %>
        <div class="mc-bar">
          <% if (s.published_count) { %><span class="seg-published" style="width:<%= pct(s.published_count) %>"></span><% } %>
          <% if (s.ready_count)     { %><span class="seg-ready"     style="width:<%= pct(s.ready_count)     %>"></span><% } %>
          <% if (s.wip_count)       { %><span class="seg-wip"       style="width:<%= pct(s.wip_count)       %>"></span><% } %>
          <% if (s.draft_count)     { %><span class="seg-draft"     style="width:<%= pct(s.draft_count)     %>"></span><% } %>
          <% if (s.failed_count)    { %><span class="seg-failed"    style="width:<%= pct(s.failed_count)    %>"></span><% } %>
        </div>
        <div class="mc-stats">
          <% if (s.published_count) { %><span><i class="mc-dot" style="background:#059669"></i><%= s.published_count %> pubbl.</span><% } %>
          <% if (s.ready_count)     { %><span><i class="mc-dot" style="background:#10b981"></i><%= s.ready_count %> pronti</span><% } %>
          <% if (s.wip_count)       { %><span><i class="mc-dot" style="background:#3b82f6"></i><%= s.wip_count %> wip</span><% } %>
          <% if (s.draft_count)     { %><span><i class="mc-dot" style="background:#9ca3af"></i><%= s.draft_count %> draft</span><% } %>
          <% if (s.failed_count)    { %><span><i class="mc-dot" style="background:#dc2626"></i><%= s.failed_count %> falliti</span><% } %>
        </div>
      <% } else { %>
        <div style="font-size:11px">Nessun post in questo mese</div>
      <% } %>
    </a>
  <% } %>
</div>
  </div>
</div>
<% } %>

<% if (plan.plan_data && plan.plan_data.months) { %>
<div class="card approvals-card card-collapsible" data-section="approvazioni">
  <div class="card-header">
    <h3>Approvazioni cliente</h3>
    <span style="font-size:12px;color:var(--gray-500)">Genera un link per ogni mese e mandalo al cliente per farglielo approvare</span>
  </div>
  <div id="approvals-list">
    <p style="font-size:12px;color:var(--gray-500)">Caricamento...</p>
  </div>
</div>
<% } %>

<!-- Editor JSON sempre disponibile (collassato per default se plan_data è valido) -->
<div class="card json-editor-card">
  <div class="card-header">
    <h3>Editor JSON del piano</h3>
    <div class="json-toolbar">
      <button class="btn btn-sm btn-secondary" onclick="toggleEditor()" id="toggle-editor-btn"><%= !plan.plan_data ? 'Nascondi editor' : 'Mostra editor' %></button>
    </div>
  </div>
  <div id="json-editor-wrap" style="display:<%= !plan.plan_data ? 'block' : 'none' %>">
    <p style="font-size:12px;color:var(--gray-500);margin:0 0 8px">
      Modifica il JSON per correggere errori dell'AI o personalizzare il piano. Validazione automatica al salvataggio.
    </p>
    <textarea id="json-editor" spellcheck="false"></textarea>
    <div id="json-error"></div>
    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
      <button class="btn btn-sm btn-secondary" onclick="formatJson()">Riformatta</button>
      <button class="btn btn-sm btn-secondary" onclick="loadFromRaw()" <%= !plan.ai_raw ? 'disabled' : '' %>>Ricarica dall'output AI grezzo</button>
      <div style="flex:1"></div>
      <button class="btn btn-sm btn-primary" onclick="saveJson(true)" title="Aggiorna plan_data E ricrea i post draft del piano (i post non-draft non vengono toccati)">Salva e ricostruisci post</button>
    </div>
  </div>
</div>

<% if (plan.ai_raw && !plan.plan_data) { %>
<div class="card" style="margin-top:16px">
  <div class="card-header"><h3>Output AI (raw)</h3></div>
  <pre style="white-space:pre-wrap;font-size:12px;max-height:400px;overflow-y:auto;background:var(--gray-50);padding:16px;border-radius:6px;font-family:monospace"><%= plan.ai_raw %></pre>
</div>
<% } %>

<script>
  const PLAN_ID = '<%= plan.id %>';
  const CLIENT_ID = '<%= client.id %>';
  const PLAN_DATA = <%- plan.plan_data ? JSON.stringify(plan.plan_data) : 'null' %>;
  const PLAN_RAW  = <%- JSON.stringify(plan.ai_raw || '') %>;

  function getToken() {
    return localStorage.getItem('dashboard_token') || (document.cookie.split(';').find(c => c.trim().startsWith('dashboard_token=')) || '').split('=')[1] || '';
  }

  function toggleEditor() {
    const wrap = document.getElementById('json-editor-wrap');
    const btn = document.getElementById('toggle-editor-btn');
    if (wrap.style.display === 'none') {
      wrap.style.display = 'block';
      btn.textContent = 'Nascondi editor';
      // Inizializza textarea se vuota
      const ta = document.getElementById('json-editor');
      if (!ta.value) {
        ta.value = PLAN_DATA ? JSON.stringify(PLAN_DATA, null, 2) : (PLAN_RAW || '');
      }
    } else {
      wrap.style.display = 'none';
      btn.textContent = 'Mostra editor';
    }
  }

  function formatJson() {
    const ta = document.getElementById('json-editor');
    try {
      const obj = JSON.parse(ta.value);
      ta.value = JSON.stringify(obj, null, 2);
      clearJsonError();
    } catch (e) {
      showJsonError('JSON non valido: ' + e.message);
    }
  }

  function loadFromRaw() {
    if (!PLAN_RAW) return;
    document.getElementById('json-editor').value = PLAN_RAW;
    clearJsonError();
  }

  function showJsonError(msg) {
    const err = document.getElementById('json-error');
    err.textContent = msg; err.style.display = 'block';
    document.getElementById('json-editor').classList.add('has-error');
  }
  function clearJsonError() {
    document.getElementById('json-error').style.display = 'none';
    document.getElementById('json-editor').classList.remove('has-error');
  }

  async function saveJson(rebuild) {
    const ta = document.getElementById('json-editor');
    let obj;
    try {
      obj = JSON.parse(ta.value);
      clearJsonError();
    } catch (e) {
      showJsonError('JSON non valido: ' + e.message);
      return;
    }
    if (rebuild && !await showConfirm('Salvare il JSON e ricostruire i post draft? I post non-draft (ready/published) NON verranno toccati.')) return;
    try {
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID + '/save-data', {
        method: 'POST',
        body: { plan_data: obj, rebuild_posts: !!rebuild }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast('Salvato' + (res.posts_created ? ' (' + res.posts_created + ' post draft creati)' : ''));
      window.location.reload();
    } catch (err) {
      await showAlert('Errore salvataggio: ' + err.message);
    }
  }

  // Inizializza textarea se editor è già visibile (caso plan_data null)
  (function init() {
    const wrap = document.getElementById('json-editor-wrap');
    if (wrap.style.display !== 'none') {
      const ta = document.getElementById('json-editor');
      ta.value = PLAN_DATA ? JSON.stringify(PLAN_DATA, null, 2) : (PLAN_RAW || '');
    }
  })();

  async function activatePlan() {
    if (!await showConfirm('Attivare questo piano?\n\nDa ora in poi i post con status "ready" e data di pubblicazione passata verranno pubblicati automaticamente su Facebook / Instagram ogni 60 secondi.')) return;
    try {
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID + '/activate', { method: 'POST', body: {} });
      if (res.error) { await showAlert(res.error); return; }
      toast('Piano attivato');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function deactivatePlan() {
    if (!await showConfirm('Disattivare l\'auto-publish? Il piano tornerà in stato "confirmed" e nessun post sarà pubblicato automaticamente finché non riattivi.')) return;
    try {
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID + '/deactivate', { method: 'POST', body: {} });
      if (res.error) { await showAlert(res.error); return; }
      toast('Piano disattivato');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  // ─────────────────────────── Editor categorie ───────────────────────────

  let CATEGORIES = PLAN_DATA && Array.isArray(PLAN_DATA.categories) ? JSON.parse(JSON.stringify(PLAN_DATA.categories)) : [];
  const ORIGINAL_CATEGORIES = JSON.stringify(CATEGORIES);

  function escapeAttr(s) { return String(s == null ? '' : s).replace(/"/g, '&quot;'); }
  function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  function renderCategories() {
    const tbody = document.getElementById('categories-tbody');
    if (!tbody) return;
    tbody.innerHTML = CATEGORIES.map((c, i) =>
      '<tr data-idx="' + i + '">'
      + '<td><input type="text" value="' + escapeAttr(c.code) + '" onchange="updateCat(' + i + ',\'code\',this.value)" placeholder="C7"></td>'
      + '<td><input type="text" value="' + escapeAttr(c.name) + '" onchange="updateCat(' + i + ',\'name\',this.value)" placeholder="Nome categoria"></td>'
      + '<td><input type="text" value="' + escapeAttr(c.frequency || '') + '" onchange="updateCat(' + i + ',\'frequency\',this.value)" placeholder="1-2/mese"></td>'
      + '<td><textarea rows="3" onchange="updateCat(' + i + ',\'description\',this.value)" placeholder="Descrizione (puoi scrivere su pi\u00f9 righe e trascinare l\u2019angolo per ingrandire)">' + escapeHtml(c.description || '') + '</textarea></td>'
      + '<td class="cat-actions">'
      +   '<button class="regen" onclick="regenerateCategory(\'' + escapeAttr(c.code) + '\')" title="Ricrea i post draft di questa categoria via AI">\u2728 Rigenera</button>'
      +   '<button class="danger" onclick="removeCategory(' + i + ')" title="Rimuovi questa categoria dal piano (salva per applicare)">\u00d7</button>'
      + '</td>'
      + '</tr>'
    ).join('');
  }

  function updateCat(idx, field, value) {
    CATEGORIES[idx][field] = value;
    refreshDirty();
  }

  function refreshDirty() {
    const dirty = JSON.stringify(CATEGORIES) !== ORIGINAL_CATEGORIES;
    document.getElementById('cat-dirty-bar').classList.toggle('show', dirty);
  }

  function addCategory() {
    // Auto-genera prossimo codice C8 se l'ultimo era C7
    const codes = CATEGORIES.map(c => c.code).filter(Boolean);
    let nextNum = 1;
    codes.forEach(code => {
      const m = /^C(\d+)$/i.exec(code);
      if (m) nextNum = Math.max(nextNum, parseInt(m[1]) + 1);
    });
    CATEGORIES.push({ code: 'C' + nextNum, name: '', frequency: '1/mese', description: '' });
    renderCategories();
    refreshDirty();
  }

  function removeCategory(idx) {
    CATEGORIES.splice(idx, 1);
    renderCategories();
    refreshDirty();
  }

  function resetCategories() {
    CATEGORIES = JSON.parse(ORIGINAL_CATEGORIES);
    renderCategories();
    refreshDirty();
  }

  async function saveCategories() {
    // Validazione
    for (const c of CATEGORIES) {
      if (!c.code || !c.name) {
        await showAlert('Ogni categoria deve avere almeno un Codice e un Nome.');
        return;
      }
    }
    try {
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID + '/categories', {
        method: 'PUT', body: { categories: CATEGORIES }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast('Categorie salvate');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function regenerateCategory(code) {
    if (!await showConfirm('Rigenerare i post draft della categoria ' + code + ' tramite AI? I post draft attuali di questa categoria verranno sostituiti, gli altri post del piano restano intatti.')) return;
    try {
      toast('Rigenerazione AI in corso (10-30s)...');
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID + '/regenerate-category', {
        method: 'POST', body: { category_code: code }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast(res.posts_created + ' post creati per ' + code);
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  renderCategories();

  // ─────────────────────────── Approvazioni cliente ───────────────────────────

  const APPROVAL_BASE = window.location.origin + '/dashboard/approve/';
  let APPROVALS = [];
  let APPROVAL_SUMMARY = {};

  function statusLabelAp(s) {
    return s === 'approved' ? 'Approvato'
      : s === 'changes_requested' ? 'Modifiche richieste'
      : s === 'in_review' ? 'In revisione'
      : s === 'expired' ? 'Scaduto'
      : 'In attesa';
  }

  function renderApprovals() {
    const root = document.getElementById('approvals-list');
    if (!root) return;
    const totalMonths = (PLAN_DATA && PLAN_DATA.months) ? PLAN_DATA.months.length : 0;
    if (!totalMonths) { root.innerHTML = '<p style="color:var(--gray-500)">Genera prima un piano editoriale.</p>'; return; }

    const byMonth = {};
    APPROVALS.forEach(a => { byMonth[a.month_number] = a; });

    let html = '';
    for (let m = 1; m <= totalMonths; m++) {
      const a = byMonth[m];
      if (!a) {
        html += '<div class="approval-row">'
          + '<div class="ap-meta"><strong>Mese ' + m + '</strong> &middot; <span style="color:var(--gray-500)">nessun link generato</span></div>'
          + '<div class="ap-actions"><button class="btn btn-sm btn-primary" onclick="createApproval(' + m + ')">Genera link</button></div>'
          + '</div>';
      } else {
        const link = APPROVAL_BASE + a.token;
        const s = APPROVAL_SUMMARY[a.id] || { approved:0, change_requested:0, rejected:0, pending:0, total:0 };
        const counts = ''
          + (s.approved ? '<span><strong>' + s.approved + '</strong> approvati</span>' : '')
          + (s.change_requested ? '<span><strong>' + s.change_requested + '</strong> modifiche</span>' : '')
          + (s.rejected ? '<span><strong>' + s.rejected + '</strong> rifiutati</span>' : '')
          + (s.pending ? '<span><strong>' + s.pending + '</strong> in attesa</span>' : '');
        html += '<div class="approval-row">'
          + '<div style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:280px">'
          +   '<div class="ap-meta"><strong>Mese ' + m + '</strong> '
          +     '<span class="ap-status ' + a.status + '">' + statusLabelAp(a.status) + '</span>'
          +     (a.expires_at ? ' <span style="color:var(--gray-500);font-size:11px">scade ' + a.expires_at.slice(0,10) + '</span>' : '')
          +   '</div>'
          +   '<div class="ap-counts">' + (counts || '<span>' + s.total + ' post totali</span>') + '</div>'
          +   '<input class="ap-link" readonly value="' + link.replace(/"/g, '&quot;') + '" onclick="this.select()">'
          + '</div>'
          + '<div class="ap-actions">'
          +   '<button class="btn btn-sm btn-secondary" onclick="copyApprovalLink(\'' + link.replace(/'/g, "\\'") + '\')">Copia</button>'
          +   '<button class="btn btn-sm" style="background:#ef4444;color:#fff" onclick="deleteApproval(\'' + a.id + '\')" title="Elimina questo link (revoca l\u2019accesso)">\u00d7</button>'
          + '</div>'
          + '</div>';
      }
    }
    root.innerHTML = html;
  }

  async function loadApprovals() {
    try {
      const res = await apiFetch('/dashboard/api/approvals/admin/plans/' + PLAN_ID);
      APPROVALS = res.approvals || [];
      APPROVAL_SUMMARY = res.summaries || {};
      renderApprovals();
    } catch (err) {
      const root = document.getElementById('approvals-list');
      if (root) root.innerHTML = '<p style="color:var(--red)">Errore: ' + escapeHtml(err.message) + '</p>';
    }
  }

  async function createApproval(month) {
    try {
      const res = await apiFetch('/dashboard/api/approvals/admin/plans/' + PLAN_ID + '/months/' + month, {
        method: 'POST', body: { expires_days: 30 }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast('Link creato per Mese ' + month);
      await loadApprovals();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function copyApprovalLink(link) {
    try {
      await navigator.clipboard.writeText(link);
      toast('Link copiato negli appunti');
    } catch (_) {
      toast('Copia manuale: il link \u00e8 selezionato');
    }
  }

  async function deleteApproval(id) {
    if (!await showConfirm('Eliminare questo link di approvazione? Il cliente non potr\u00e0 pi\u00f9 accedere alla pagina.')) return;
    try {
      const res = await apiFetch('/dashboard/api/approvals/admin/' + id, { method: 'DELETE' });
      if (res.error) { await showAlert(res.error); return; }
      toast('Link revocato');
      await loadApprovals();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  // Carica le approvazioni — aspetta che layout-end abbia caricato dashboard.js
  // (serve apiFetch, definita lì). Se DOM è già pronto, eseguo subito, altrimenti
  // attendo DOMContentLoaded.
  function _initApprovals() {
    if (PLAN_DATA && PLAN_DATA.months && typeof apiFetch === 'function') loadApprovals();
    else if (PLAN_DATA && PLAN_DATA.months) setTimeout(_initApprovals, 50);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', _initApprovals);
  } else {
    _initApprovals();
  }

  // ─────────────────────── Rinomina / Duplica / Export JSON ───────────────────────

  async function renamePlan() {
    const current = <%- JSON.stringify(plan.title || '') %>;
    const next = prompt('Nuovo nome del piano editoriale:', current);
    if (next === null) return;
    const trimmed = next.trim();
    if (!trimmed) { await showAlert('Il nome non può essere vuoto.'); return; }
    if (trimmed === current) return;
    try {
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID, {
        method: 'PUT',
        body: { title: trimmed }
      });
      if (res.error) throw new Error(res.error);
      toast('Nome aggiornato');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function duplicatePlan() {
    const baseName = <%- JSON.stringify(plan.title || 'Piano Editoriale') %>;
    const suggested = 'Copia di ' + baseName;
    const name = prompt('Nome del nuovo piano (duplicato):', suggested);
    if (name === null) return;
    const trimmed = name.trim() || suggested;
    if (!await showConfirm('Duplicare questo piano?\n\nVerranno copiati tutti i ' + (typeof PLAN_DATA !== 'undefined' && PLAN_DATA.months ? '' : '') + 'post (caption incluse), in stato draft. I media (foto/video) NON vengono duplicati: li ricaricherai nel nuovo piano.')) return;
    try {
      const res = await apiFetch('/dashboard/api/plans/' + PLAN_ID + '/duplicate', {
        method: 'POST',
        body: { title: trimmed }
      });
      if (res.error) throw new Error(res.error);
      toast('Piano duplicato (' + res.posts_copied + ' post copiati)');
      // Vai al nuovo piano
      window.location.href = '/dashboard/clients/' + CLIENT_ID + '/plan/' + res.plan.id;
    } catch (err) {
      await showAlert('Duplicazione fallita: ' + err.message);
    }
  }

  async function exportJson() {
    try {
      toast('Export JSON in corso...');
      const res = await fetch('/dashboard/api/plans/' + PLAN_ID + '/export', {
        headers: { 'Authorization': 'Bearer ' + getToken() }
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        await showAlert('Export fallito: ' + (err.error || ('HTTP ' + res.status)));
        return;
      }
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = '<%= (plan.title || "piano").replace(/[^a-z0-9_-]/gi, "_").slice(0,60) %>.json';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  // ─────────────────────────── PDF Export ───────────────────────────

  async function exportPdf() {
    try {
      toast('Generazione PDF in corso...');
      const res = await fetch('/dashboard/api/plans/' + PLAN_ID + '/pdf', {
        headers: { 'Authorization': 'Bearer ' + getToken() }
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        await showAlert('PDF fallito: ' + (err.error || ('HTTP ' + res.status)));
        return;
      }
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = '<%= (plan.title || "piano").replace(/[^a-z0-9_-]/gi, "_").slice(0,60) %>.pdf';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  // Sezioni collassabili: click sull'header chiude/riapre. Stato salvato per
  // piano in localStorage così ciascun utente mantiene le sue preferenze.
  (function initCollapsibles() {
    const storageKey = 'plan-collapse-' + PLAN_ID;
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(storageKey) || '{}') || {}; } catch (_) { saved = {}; }

    const sections = document.querySelectorAll('.card-collapsible, .section-collapsible');
    sections.forEach(sec => {
      const key = sec.dataset.section;
      if (!key) return;
      const collapsedClass = sec.classList.contains('card-collapsible') ? 'card-collapsed' : 'section-collapsed';
      if (saved[key]) sec.classList.add(collapsedClass);
      const header = sec.querySelector(':scope > .card-header, :scope > .section-header');
      if (!header) return;
      header.addEventListener('click', (e) => {
        // Non collassare se l'utente ha cliccato un controllo interno (bottoni/link)
        if (e.target.closest('button, a, input, textarea, select')) return;
        sec.classList.toggle(collapsedClass);
        saved[key] = sec.classList.contains(collapsedClass);
        try { localStorage.setItem(storageKey, JSON.stringify(saved)); } catch (_) {}
      });
    });
  })();
</script>

<%- include('layout-end') %>
