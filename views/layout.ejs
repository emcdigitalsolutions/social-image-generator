<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — SMM Dashboard</title>
  <link rel="stylesheet" href="/dashboard/css/dashboard.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : Date.now() %>">
  <link rel="stylesheet" href="/dashboard/css/dashboard-theme.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : Date.now() %>">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230f1e4a'/%3E%3Cpath d='M22 30 L42 50 L22 70 M36 30 L56 50 L36 70 M50 30 L70 50 L50 70' stroke='%23d4a574' stroke-width='6' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
</head>
<body>
  <!-- Topbar mobile (visibile solo < 900px) -->
  <div class="mobile-topbar">
    <button class="mobile-menu-btn" onclick="toggleSidebar()" aria-label="Apri menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="mobile-topbar-brand">
      <svg width="28" height="28" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="mt-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0f1e4a"/>
            <stop offset="1" stop-color="#1e3a8a"/>
          </linearGradient>
          <linearGradient id="mt-chev" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e8c389"/>
            <stop offset="1" stop-color="#b8895d"/>
          </linearGradient>
        </defs>
        <rect width="100" height="100" rx="22" fill="url(#mt-grad)"/>
        <path d="M22 28 L44 50 L22 72 M38 28 L60 50 L38 72 M54 28 L76 50 L54 72" stroke="url(#mt-chev)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
      <span>SMM Dashboard</span>
    </div>
  </div>

  <div class="layout">
    <div class="sidebar-backdrop" onclick="toggleSidebar()"></div>
    <aside class="sidebar">
      <button class="sidebar-close" onclick="toggleSidebar()" aria-label="Chiudi menu">&times;</button>
      <div class="sidebar-brand">
        <div style="display:flex;align-items:center;gap:10px">
          <!-- Logo EMC: 3 chevron + testo -->
          <svg width="36" height="36" viewBox="0 0 100 100" aria-hidden="true">
            <defs>
              <linearGradient id="emc-logo-bars" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#d4a574"/>
                <stop offset="1" stop-color="#f5ebd9"/>
              </linearGradient>
            </defs>
            <rect width="100" height="100" rx="20" fill="rgba(255,255,255,0.05)" stroke="rgba(212,165,116,0.3)" stroke-width="1.5"/>
            <path d="M28 28 L48 50 L28 72 M40 28 L60 50 L40 72 M52 28 L72 50 L52 72"
                  stroke="url(#emc-logo-bars)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <div>
            <h2>SMM Dashboard</h2>
            <small>EMC Digital Solutions</small>
          </div>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/dashboard" <%= (typeof activeNav !== 'undefined' && activeNav === 'clients') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Clienti
        </a>
        <a href="/dashboard/archived" <%= (typeof activeNav !== 'undefined' && activeNav === 'archived') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="4" rx="1"/><path d="M5 7v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
          Archiviati
        </a>
        <a href="/dashboard/insights" <%= (typeof activeNav !== 'undefined' && activeNav === 'insights') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          Insights
        </a>
        <a href="/dashboard/plan-templates" <%= (typeof activeNav !== 'undefined' && activeNav === 'plan-templates') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Template Piani
        </a>
        <a href="/dashboard/logs" <%= (typeof activeNav !== 'undefined' && activeNav === 'logs') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
          Log
        </a>
        <a href="/dashboard/audit" <%= (typeof activeNav !== 'undefined' && activeNav === 'audit') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Audit
        </a>
        <a href="/dashboard/settings" <%= (typeof activeNav !== 'undefined' && activeNav === 'settings') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Impostazioni
        </a>
        <a href="/dashboard/manuale" <%= (typeof activeNav !== 'undefined' && activeNav === 'manuale') ? 'class="active"' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          Manuale
        </a>
      </nav>
      <div class="sidebar-user">
        <span><%= user.display_name || user.username %></span>
        <a href="#" onclick="logout()">Esci</a>
      </div>
    </aside>
    <main class="main">
