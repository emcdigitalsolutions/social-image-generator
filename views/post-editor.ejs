  // ── CTA + menzioni: replica client-side di lib/post-caption.js per l'anteprima ──
  function normalizeMentionsClient(input) {
    if (!input) return [];
    const out = [], seen = new Set();
    for (const raw of String(input).split(/[\s,]+/)) {
      const h = raw.trim().replace(/^@+/, '').replace(/[^A-Za-z0-9._]/g, '').slice(0, 30);
      if (!h) continue;
      const k = h.toLowerCase();
      if (seen.has(k)) continue;
      seen.add(k); out.push('@' + h);
      if (out.length >= 30) break;
    }
    return out;
  }
  function formatCtaLineClient(label, url) {
    const l = (label || '').trim();
    let t = (url || '').trim();
    if (/^tel:/i.test(t)) t = t.replace(/^tel:/i, '').trim();
    if (!l && !t) return '';
    if (l && t) return '\u{1F449} ' + l + ': ' + t;
    return '\u{1F449} ' + (l || t);
  }
  function elVal(id) { const e = document.getElementById(id); return e ? e.value : ''; }
  function composeCaptionClient() {
    const base = (elVal('caption-text') || POST.caption || '').replace(/\s+$/, '');
    const mentions = normalizeMentionsClient(elVal('post-mentions'));
    const ctaLine = formatCtaLineClient(elVal('cta-label'), elVal('cta-url'));
    const blocks = [];
    if (base) blocks.push(base);
    if (mentions.length) blocks.push(mentions.join(' '));
    if (ctaLine) blocks.push(ctaLine);
    return blocks.join('\n\n').trim();
  }
