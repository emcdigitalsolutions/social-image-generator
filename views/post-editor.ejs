  // Mostra/aggiorna in alto la data programmata (read-only, formato italiano).
  // Si aggiorna automaticamente quando l'utente modifica i campi data/ora.
  (function setupPostDateDisplay() {
    const display = document.getElementById('post-date-display');
    const dateInp = document.getElementById('post-date');
    const timeInp = document.getElementById('post-time');
    if (!display || !dateInp) return;
    const days = ['dom', 'lun', 'mar', 'mer', 'gio', 'ven', 'sab'];
    const months = ['gen', 'feb', 'mar', 'apr', 'mag', 'giu', 'lug', 'ago', 'set', 'ott', 'nov', 'dic'];
    function update() {
      const d = dateInp.value;
      const t = (timeInp && timeInp.value) || '';
      if (!d) {
        display.textContent = '📅 Senza data';
        display.style.color = 'var(--gray-400)';
        return;
      }
      // d in formato YYYY-MM-DD; uso parts manuali per evitare timezone shift
      const [y, m, dd] = d.split('-').map(Number);
      const dt = new Date(y, m - 1, dd);
      const dayName = days[dt.getDay()];
      const monthName = months[m - 1];
      const timeStr = t ? ' · ' + t.slice(0, 5) : '';
      display.textContent = '📅 ' + dayName + ' ' + dd + ' ' + monthName + ' ' + y + timeStr;
      display.style.color = 'var(--gray-700)';
    }
    update();
    dateInp.addEventListener('change', update);
    if (timeInp) timeInp.addEventListener('change', update);
  })();

  // Apre un picker dalla libreria video del cliente. Click "Usa" → POST a
