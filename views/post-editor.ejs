          MEDIA.push(r.media);
          renderMedia();
          // Se il post non è già reel/video, switcha automaticamente a reel
          if (MEDIA_TYPE !== 'reel' && MEDIA_TYPE !== 'video' && MEDIA_TYPE !== 'story' && aspectRatio === '9:16') {
            try {
              await apiFetch('/dashboard/api/posts/' + POST_ID, { method: 'PUT', body: { media_type: 'reel' } });
              if (typeof setType === 'function') setType('reel');
            } catch (_) {}
          }
        }
        toast('Reel generato (' + r.duration_sec + 's)');
        close();
      } catch (err) {
        applyBtn.disabled = false;
        applyBtn.innerHTML = '\uD83C\uDFAC Genera Reel';
        await showAlert('Errore: ' + err.message);
      }
    });
  }
  window.openAnimateImageModal = openAnimateImageModal;

  async function generateImage() {
    const btn = document.getElementById('gen-image-btn');
    btn.disabled = true;
    btn.innerHTML = '<span class="loading"></span> Generazione...';
    try {
      await saveDetails();
      const res = await apiFetch('/dashboard/api/posts/' + POST_ID + '/generate-image', { method: 'POST' });
      if (res.error) { await showAlert(res.error); return; }
      // Ricarico la lista media. L'endpoint registra il file in post_media
      // (via attachGeneratedFile, che sposta il file in posts/{id}/ → URL diverso
      // da res.image_url). Se generavamo un fallback legacy basato su res.image_url
      // si creava un duplicato fantasma non eliminabile ("media not found").
      // Usiamo post_media come unica sorgente di verità; un fallback legacy ha senso
      // SOLO se post_media è rimasto vuoto (attachGeneratedFile fallito).
      const mediaRes = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media');
      MEDIA = mediaRes.media || [];
      if (!MEDIA.length && res.image_url) {
        MEDIA.push({ id: 'legacy-' + Date.now(), kind: 'image', source: 'generated', url: res.image_url, position: 0 });
      }
      renderMedia();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span style="margin-right:3px">🖼️</span>Da template';
    }
  }

  // Mostra un modal con textarea editabile per il prompt visivo. Risolve con la
  // stringa finale (utente ha confermato) o null (annullato).
  function promptEditorModal(initialPrompt, aspect) {
    return new Promise((resolve) => {
      const overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
      overlay.innerHTML = `
        <div style="background:#fff;border-radius:10px;max-width:680px;width:100%;max-height:90vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,.3)">
          <div style="padding:16px 20px;border-bottom:1px solid var(--gray-200);display:flex;justify-content:space-between;align-items:center">
            <strong style="font-size:15px">✨ Affina il prompt visivo (${aspect})</strong>
            <button id="pe-close" style="background:none;border:none;font-size:22px;cursor:pointer;color:var(--gray-500);line-height:1">×</button>
          </div>
          <div style="padding:16px 20px;overflow-y:auto;flex:1">
            <p style="font-size:12px;color:var(--gray-600);margin:0 0 8px">Modifica il prompt (in inglese, per qualità ottimale dell'AI). Suggerimenti: aggiungi dettagli su lighting, mood, palette colori, soggetti specifici. Mantieni "no text, no typography, no watermark" per evitare lettere malformate.</p>
            <textarea id="pe-textarea" style="width:100%;min-height:200px;padding:10px;border:1px solid var(--gray-300);border-radius:6px;font-family:inherit;font-size:13px;line-height:1.5;resize:vertical;box-sizing:border-box"></textarea>
            <div style="margin-top:6px;font-size:11px;color:var(--gray-500)"><span id="pe-count">0</span> caratteri</div>

            <div style="margin-top:14px;padding:10px 12px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:6px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                <strong style="font-size:11px;color:#0369a1;text-transform:uppercase;letter-spacing:0.05em">💬 Cosa stai chiedendo all'AI (italiano)</strong>
                <button id="pe-retranslate" type="button" class="btn btn-sm" style="background:#bae6fd;color:#0c4a6e;font-size:11px;padding:3px 8px" title="Aggiorna la traduzione dopo aver modificato il prompt">🔄 Aggiorna</button>
              </div>
              <div id="pe-translation" style="font-size:13px;line-height:1.5;color:#0c4a6e;font-style:italic">— traduzione in corso —</div>
            </div>
          </div>
          <div style="padding:14px 20px;border-top:1px solid var(--gray-200);display:flex;gap:8px;justify-content:flex-end">
            <button id="pe-cancel" class="btn btn-sm" style="background:var(--gray-200)">Annulla</button>
            <button id="pe-reset" class="btn btn-sm" style="background:var(--gray-200)" title="Ripristina il prompt auto-generato">↺ Reset</button>
            <button id="pe-confirm" class="btn btn-sm btn-primary">✨ Genera immagine</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);

      const ta = overlay.querySelector('#pe-textarea');
      const counter = overlay.querySelector('#pe-count');
      const trDiv = overlay.querySelector('#pe-translation');
      const retransBtn = overlay.querySelector('#pe-retranslate');
      ta.value = initialPrompt;
      counter.textContent = ta.value.length;
      ta.addEventListener('input', () => { counter.textContent = ta.value.length; });
      ta.focus();
      ta.setSelectionRange(ta.value.length, ta.value.length);

      // Cache traduzioni: stesso testo → no rifetch.
      const trCache = new Map();
      let lastTranslated = '';

      async function refreshTranslation(force = false) {
        const text = ta.value.trim();
        if (!text) { trDiv.textContent = '—'; return; }
        if (!force && text === lastTranslated) return;
        if (trCache.has(text)) {
          trDiv.textContent = trCache.get(text);
          lastTranslated = text;
          return;
        }
        retransBtn.disabled = true;
        const prevHtml = retransBtn.innerHTML;
        retransBtn.innerHTML = '<span class="loading"></span>';
        trDiv.style.opacity = '0.6';
        try {
          const r = await apiFetch('/dashboard/api/posts/' + POST_ID + '/translate-prompt', {
            method: 'POST',
            body: { prompt: text }
          });
          if (r && r.translation) {
            trCache.set(text, r.translation);
            trDiv.textContent = r.translation;
            lastTranslated = text;
          } else {
            trDiv.textContent = (r && r.error) ? '(' + r.error + ')' : '(traduzione non disponibile)';
          }
        } catch (err) {
          trDiv.textContent = '(errore traduzione: ' + err.message + ')';
        } finally {
          retransBtn.disabled = false;
          retransBtn.innerHTML = prevHtml;
          trDiv.style.opacity = '1';
        }
      }

      // Traduzione iniziale (non blocca l'apertura della modale).
      refreshTranslation(true);
      // Re-traduzione on-blur del textarea (l'utente ha finito di modificare).
      ta.addEventListener('blur', () => refreshTranslation(false));
      retransBtn.addEventListener('click', () => refreshTranslation(true));

      const close = (val) => { document.body.removeChild(overlay); resolve(val); };
      overlay.querySelector('#pe-close').onclick = () => close(null);
      overlay.querySelector('#pe-cancel').onclick = () => close(null);
      overlay.querySelector('#pe-reset').onclick = () => {
        ta.value = initialPrompt;
        counter.textContent = ta.value.length;
        refreshTranslation(false);
      };
      overlay.querySelector('#pe-confirm').onclick = () => {
        const v = ta.value.trim();
        if (!v) { ta.focus(); return; }
        close(v);
      };
      overlay.addEventListener('click', (e) => { if (e.target === overlay) close(null); });
    });
  }

  async function generateAIImage() {
    const btn = document.getElementById('gen-ai-btn');
    const aspectSel = document.getElementById('ai-aspect');
    const aspect = aspectSel ? aspectSel.value : '1:1';
    btn.disabled = true;
    btn.innerHTML = '<span class="loading"></span> Costruzione prompt...';
    let editedPrompt = null;
    try {
      await saveDetails();
      const buildRes = await apiFetch('/dashboard/api/posts/' + POST_ID + '/build-visual-prompt', {
        method: 'POST',
        body: { aspect_ratio: aspect }
      });
      if (buildRes.error) { await showAlert(buildRes.error + (buildRes.details ? '\n' + buildRes.details : '')); return; }

      editedPrompt = await promptEditorModal(buildRes.prompt || '', aspect);
      if (!editedPrompt) { toast('Generazione annullata'); return; }

      btn.innerHTML = '<span class="loading"></span> Generazione AI...';
      const res = await apiFetch('/dashboard/api/posts/' + POST_ID + '/generate-ai-image', {
        method: 'POST',
        body: { aspect_ratio: aspect, prompt: editedPrompt }
      });
      if (res.error) { await showAlert(res.error + (res.details ? '\n' + res.details : '')); return; }
      const mediaRes = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media');
      MEDIA = mediaRes.media || [];
      renderMedia();
      toast('Immagine AI generata (' + aspect + ')');
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span style="margin-right:3px">✨</span>Genera AI';
    }
  }

  // Sceglie automaticamente dalla libreria del cliente le immagini più coerenti
  // con la caption e le allega al post. La prima volta le immagini vengono
  // analizzate dall'AI (poi il risultato resta in cache).
  async function autoPickLibrary() {
    const btn = document.getElementById('auto-lib-btn');
    if (!await showConfirm('Cercare nella libreria di questo cliente le immagini più coerenti con la caption e allegarle al post?\n\nLa prima volta le immagini vengono analizzate (pochi secondi ciascuna), poi il risultato è in cache.')) return;
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="loading"></span> Analisi libreria...';
    try {
      await saveDetails(); // persiste la caption corrente prima del match lato server
      const res = await apiFetch('/dashboard/api/posts/' + POST_ID + '/auto-pick-library-images', { method: 'POST', body: {} });
      if (res.error) { await showAlert(res.error + (res.details ? '\n' + res.details : '')); return; }
      if (!res.attached || !res.attached.length) {
        const extra = res.remaining ? '\n\n(' + res.remaining + ' immagini non ancora analizzate: riclicca per includerle)' : '';
        await showAlert((res.message || 'Nessuna immagine pertinente trovata in libreria.') + extra);
        return;
      }
      const mediaRes = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media');
      MEDIA = mediaRes.media || [];
      renderMedia();
      const lines = res.attached.map(a => '• ' + (a.original_name || a.library_item_id) + (a.reason ? ' — ' + a.reason : ''));
      const extra = res.remaining ? '\n\n(' + res.remaining + ' immagini non ancora analizzate: riclicca per includerle)' : '';
      toast(res.attached.length + ' immagine/i allegata/e dalla libreria');
      await showAlert('Allegate ' + res.attached.length + ' immagini dalla libreria:\n\n' + lines.join('\n') + extra);
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  }

  // Reel AI: slideshow Ken Burns da N immagini AI animate via ffmpeg server-side.
  // Apre un modal per configurare aspect/numero clip/durata + audio (silenzio /
  // libreria / genera AI), poi lancia il job. Job lato server: 20-40s.
  function aiVideoConfigModal() {
    return new Promise(async (resolve) => {
      // Pre-fetch libreria audio globale + libreria audio cliente (entrambi best-effort)
      let library = { tracks: [], hf_configured: false };
      let clientAudio = [];
      try {
        const lib = await apiFetch('/dashboard/api/music');
        if (lib && Array.isArray(lib.tracks)) library = lib;
      } catch (_) {}
      try {
        const cl = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/library?kind=audio');
        if (cl && Array.isArray(cl.items)) clientAudio = cl.items;
      } catch (_) {}

      const overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
      // Audio sources: prefisso "client:" identifica audio dalla libreria cliente,
      // valori senza prefisso sono filename della libreria globale /music/.
      // Backend distingue dal prefisso.
      const escAttr = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]));
      // Ogni <option> porta un data-url pronto per l'anteprima: audio cliente →
      // a.url; audio globale → /music/<filename urlencoded>. La preview legge il
      // data-url (come il modale "Anima immagine"), così funziona per entrambi.
      const clientOpts = clientAudio.length
        ? '<optgroup label="📚 Libreria del cliente">' + clientAudio.map(a => `<option value="client:${a.id}" data-url="${escAttr(a.url)}">${escAttr(a.original_name || a.filename)} (${(a.bytes/1024).toFixed(0)} KB)</option>`).join('') + '</optgroup>'
        : '';
      const globalOpts = library.tracks.length
        ? '<optgroup label="🌐 Libreria globale">' + library.tracks.map(t => `<option value="${escAttr(t.filename)}" data-url="/music/${encodeURIComponent(t.filename)}">${escAttr(t.filename)} (${(t.bytes/1024).toFixed(0)} KB)</option>`).join('') + '</optgroup>'
        : '';
      const tracksOptions = (clientOpts || globalOpts)
        ? clientOpts + globalOpts
        : '<option value="">— Nessuna traccia disponibile —</option>';
      overlay.innerHTML = `
        <div style="background:#fff;border-radius:10px;max-width:560px;width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,.3)">
          <div style="padding:16px 20px;border-bottom:1px solid var(--gray-200);display:flex;justify-content:space-between;align-items:center">
            <strong style="font-size:15px">🎬 Genera Reel AI (slideshow)</strong>
            <button id="vc-close" style="background:none;border:none;font-size:22px;cursor:pointer;color:var(--gray-500);line-height:1">×</button>
          </div>
          <div style="padding:16px 20px">
            <p style="font-size:12px;color:var(--gray-600);margin:0 0 14px">Genera N immagini AI variando angolo/inquadratura, le anima con effetto Ken Burns (zoom + pan) e crossfade. Costo: ~$0.04 × N immagini.</p>

            <div style="margin-bottom:12px">
              <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Aspect ratio</label>
              <select id="vc-aspect" style="width:100%;padding:7px 9px;border:1px solid var(--gray-300);border-radius:5px;font-size:13px">
                <option value="9:16" selected>9:16 — Reel / Story (verticale)</option>
                <option value="1:1">1:1 — IG quadrato</option>
                <option value="4:5">4:5 — IG verticale feed</option>
                <option value="16:9">16:9 — FB orizzontale</option>
              </select>
            </div>

            <div style="display:flex;gap:14px;margin-bottom:12px">
              <div style="flex:1">
                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Numero clip</label>
                <select id="vc-num" style="width:100%;padding:7px 9px;border:1px solid var(--gray-300);border-radius:5px;font-size:13px">
                  <option value="2">2 immagini</option>
                  <option value="3" selected>3 immagini</option>
                  <option value="4">4 immagini</option>
                  <option value="5">5 immagini</option>
                </select>
              </div>
              <div style="flex:1">
                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Durata per clip (sec)</label>
                <select id="vc-dur" style="width:100%;padding:7px 9px;border:1px solid var(--gray-300);border-radius:5px;font-size:13px">
                  <option value="3">3 sec</option>
                  <option value="4" selected>4 sec</option>
                  <option value="5">5 sec</option>
                  <option value="6">6 sec</option>
                </select>
              </div>
            </div>

            <fieldset style="border:1px solid var(--gray-200);border-radius:6px;padding:10px 12px;margin-bottom:12px">
              <legend style="font-size:12px;font-weight:600;padding:0 6px">🎵 Audio</legend>
              <div style="display:flex;gap:14px;margin-bottom:8px;flex-wrap:wrap">
                <label style="font-size:12px;cursor:pointer"><input type="radio" name="vc-audio-mode" value="none" checked> Silenzio</label>
                <label style="font-size:12px;cursor:pointer"><input type="radio" name="vc-audio-mode" value="library"> Libreria</label>
                <label style="font-size:12px;cursor:pointer"><input type="radio" name="vc-audio-mode" value="ai"> ✨ Genera con AI</label>
              </div>

              <div id="vc-audio-library" style="display:none;margin-top:8px">
                <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px">
                  <select id="vc-audio-track" style="flex:1;padding:6px 8px;border:1px solid var(--gray-300);border-radius:4px;font-size:12px">${tracksOptions}</select>
                  <button id="vc-audio-upload-btn" type="button" class="btn btn-sm" style="background:var(--gray-200);font-size:11px;padding:5px 8px">⬆ Upload</button>
                  <button id="vc-audio-refresh-btn" type="button" class="btn btn-sm" style="background:var(--gray-200);font-size:11px;padding:5px 8px">↻</button>
                </div>
                <audio id="vc-audio-preview" controls style="width:100%;height:36px"></audio>
                <input type="file" id="vc-audio-upload-input" accept="audio/mpeg,audio/wav,audio/mp4,audio/x-m4a,audio/ogg" style="display:none">
                <div style="font-size:10px;color:var(--gray-500);margin-top:4px">MP3/WAV/M4A/OGG · max 15MB · usa solo musica royalty-free</div>
              </div>

              <div id="vc-audio-ai" style="display:none;margin-top:8px">
                ${library.ai_configured
                  ? '<textarea id="vc-audio-prompt" rows="2" placeholder="es. upbeat acoustic guitar, mediterranean summer vibes, light percussion" style="width:100%;padding:6px 8px;border:1px solid var(--gray-300);border-radius:4px;font-size:12px;font-family:inherit;resize:vertical;box-sizing:border-box"></textarea>'
                  + '<div style="display:flex;gap:6px;align-items:center;margin-top:6px">'
                  + '<select id="vc-audio-ai-dur" style="padding:5px 7px;border:1px solid var(--gray-300);border-radius:4px;font-size:12px">'
                  + '<option value="10">10s</option><option value="15" selected>15s</option><option value="20">20s</option><option value="30">30s</option>'
                  + '</select>'
                  + '<button id="vc-audio-ai-btn" type="button" class="btn btn-sm btn-primary" style="font-size:12px;padding:5px 10px">✨ Genera traccia</button>'
                  + '<span id="vc-audio-ai-status" style="font-size:11px;color:var(--gray-500)"></span>'
                  + '</div>'
                  + '<div style="font-size:10px;color:var(--gray-500);margin-top:4px">MusicGen via ' + (library.replicate_configured ? 'Replicate (~$0.05/track)' : 'Hugging Face') + '. Tempo: 15-30s.</div>'
                  : '<div style="font-size:11px;color:#92400e;background:#fef3c7;padding:8px 10px;border-radius:4px">⚠ Nessun provider audio configurato. Vai su <a href="/dashboard/settings" target="_blank">Settings</a> e aggiungi <strong>Replicate token</strong> (consigliato, $5 gratis ≈ 100 tracce su <a href="https://replicate.com/account/api-tokens" target="_blank">replicate.com</a>).</div>'}
              </div>
            </fieldset>

            <label style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--gray-700);margin-bottom:10px;padding:8px 10px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:5px;cursor:pointer">
              <input type="checkbox" id="vc-save-library" style="margin-top:2px">
              <span><strong>💾 Salva anche in libreria del cliente</strong><br><span style="font-size:11px;color:var(--gray-500)">Una copia del Reel finisce in Libreria Media così puoi riusarlo in altri post. Il video resta comunque allegato a questo post.</span></span>
            </label>

            <div id="vc-summary" style="font-size:11px;color:var(--gray-500);padding:8px 10px;background:var(--gray-50);border-radius:5px"></div>
          </div>
          <div style="padding:14px 20px;border-top:1px solid var(--gray-200);display:flex;gap:8px;justify-content:flex-end">
            <button id="vc-cancel" class="btn btn-sm" style="background:var(--gray-200)">Annulla</button>
            <button id="vc-confirm" class="btn btn-sm btn-primary" style="background:#7c3aed">🎬 Genera Reel</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);

      const updateSummary = () => {
        const n = parseInt(overlay.querySelector('#vc-num').value, 10);
        const d = parseInt(overlay.querySelector('#vc-dur').value, 10);
        const total = (n * d - (n - 1) * 0.5).toFixed(1);
        const cost = (0.04 * n).toFixed(2);
        overlay.querySelector('#vc-summary').textContent =
          `Durata video: ~${total}s · Costo stimato: ~$${cost} (${n} immagini AI)`;
      };
      overlay.querySelector('#vc-num').onchange = updateSummary;
      overlay.querySelector('#vc-dur').onchange = updateSummary;
      updateSummary();

      // Audio mode toggle
      const audioModeChange = () => {
        const mode = overlay.querySelector('input[name="vc-audio-mode"]:checked').value;
        overlay.querySelector('#vc-audio-library').style.display = mode === 'library' ? 'block' : 'none';
        overlay.querySelector('#vc-audio-ai').style.display = mode === 'ai' ? 'block' : 'none';
