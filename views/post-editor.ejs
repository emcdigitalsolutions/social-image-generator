<%- include('layout', { title, user }) %>
<%
  // Mappa code → name delle categorie del piano + display friendly del codice
  // del post corrente. Usato in più punti del template per mostrare il nome
  // leggibile invece del codice tipo "C1".
  const categoryNameMap = {};
  (typeof categories !== 'undefined' ? categories : []).forEach(c => { categoryNameMap[c.code] = c.name; });
  const categoryDisplay = post.category ? (categoryNameMap[post.category] || post.category) : '';
%>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<style>
  .type-chips { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; }
  .type-chip {
    padding:6px 14px; font-size:13px; border-radius:14px;
    border:1px solid var(--gray-200); background:white; cursor:pointer; user-select:none;
  }
  .type-chip.active { background:var(--blue); color:white; border-color:var(--blue); }
  .type-help { font-size:12px; color:var(--gray-500); margin:8px 0 16px; }

  .uploader {
    position:relative;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:10px; padding:36px 20px; min-height:180px;
    border:2px dashed var(--gray-300); border-radius:10px;
    background:var(--gray-50); color:var(--gray-600);
    text-align:center; cursor:pointer; user-select:none;
    transition: border-color .15s, background .15s, transform .1s, box-shadow .15s;
  }
  .uploader:hover {
    border-color:var(--blue); background:#eff6ff;
    box-shadow:0 2px 8px rgba(59,130,246,.08);
  }
  .uploader.dragover {
    border-color:var(--blue); background:#dbeafe;
    transform:scale(1.01); box-shadow:0 4px 16px rgba(59,130,246,.15);
  }
  .uploader.is-uploading { pointer-events:none; }

  /* Progress overlay durante upload */
  .upload-progress {
    position:absolute; inset:0; z-index:5;
    background:rgba(255,255,255,0.96);
    border-radius:10px;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px;
  }
  .upload-progress-bar {
    width:70%; max-width:320px; height:10px;
    background:var(--gray-200); border-radius:5px; overflow:hidden;
  }
  .upload-progress-fill {
    height:100%; background:var(--blue);
    transition: width .15s ease-out;
    border-radius:5px;
  }
  .upload-progress-text {
    font-size:14px; font-weight:600; color:var(--gray-700);
    font-variant-numeric: tabular-nums;
  }
  .upload-progress-sub {
    font-size:12px; color:var(--gray-500);
  }
  .uploader input[type=file] { display:none; }
  .uploader-icon {
    width:44px; height:44px; color:var(--gray-400);
    transition:color .15s, transform .15s;
  }
  .uploader:hover .uploader-icon,
  .uploader.dragover .uploader-icon { color:var(--blue); transform:translateY(-2px); }
  .uploader-title { font-size:15px; font-weight:600; color:var(--gray-700); }
  .uploader-title em { font-style:normal; color:var(--blue); }
  .uploader-hint { font-size:12px; color:var(--gray-500); line-height:1.5; max-width:360px; }

  .media-grid {
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));
    gap:12px; margin-top:14px;
  }
  .media-item {
    position:relative;
    border:1px solid var(--gray-200); border-radius:8px; overflow:hidden;
    display:flex; flex-direction:column; background:white;
    transition: transform .1s, box-shadow .15s;
  }
  .media-item:hover { transform:translateY(-1px); box-shadow:0 4px 12px rgba(0,0,0,.08); }
  .media-item.selected { box-shadow:0 0 0 3px var(--blue), 0 4px 12px rgba(59,130,246,.25); border-color:var(--blue); }
  .media-select {
    position:absolute; top:6px; right:6px; z-index:4;
    width:22px; height:22px; cursor:pointer;
    background:rgba(255,255,255,0.9); border-radius:4px;
    backdrop-filter:blur(4px); accent-color:var(--blue);
  }

  .media-toolbar {
    display:flex; align-items:center; justify-content:space-between; gap:8px;
    padding:8px 12px; margin-top:14px;
    background:#eff6ff; border:1px solid #bfdbfe; border-radius:6px;
    font-size:13px;
  }
  .media-toolbar-left { display:flex; align-items:center; gap:14px; }
  .media-toolbar a { color:var(--blue); text-decoration:none; font-weight:500; cursor:pointer; }
  .media-toolbar a:hover { text-decoration:underline; }
  .media-thumb {
    aspect-ratio:1/1; background:var(--gray-50);
    display:flex; align-items:center; justify-content:center;
    overflow:hidden; position:relative;
  }
  .media-thumb img, .media-thumb video { width:100%; height:100%; object-fit:cover; display:block; }

  /* Warning proporzioni Instagram */
  .media-item.ratio-warn { box-shadow: 0 0 0 2px #dc2626, 0 4px 12px rgba(220,38,38,.15); border-color: #dc2626; }
  .ratio-warn-badge {
    position: absolute; top: 6px; right: 6px;
    background: #dc2626; color: white;
    font-size: 10px; font-weight: 800; padding: 3px 7px;
    border-radius: 3px; letter-spacing: 0.3px;
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
  }
  .media-source-badge {
    position:absolute; top:6px; left:6px;
    padding:3px 8px; font-size:10px; font-weight:600; border-radius:4px;
    background:rgba(0,0,0,0.65); color:white; text-transform:uppercase; letter-spacing:0.5px;
    backdrop-filter:blur(4px);
  }
  .media-source-badge.styled    { background:var(--blue); }
  .media-source-badge.generated { background:#10b981; }
  .media-pos-badge {
    position:absolute; bottom:6px; right:6px;
    padding:2px 8px; font-size:11px; font-weight:600; border-radius:10px;
    background:rgba(0,0,0,0.7); color:white;
    backdrop-filter:blur(4px);
  }
  .media-actions {
    display:flex; gap:4px; padding:8px;
    border-top:1px solid var(--gray-200); justify-content:space-between; align-items:center;
  }
  .media-actions button {
    background:transparent; border:0; color:var(--gray-600);
    font-size:12px; padding:5px 8px; cursor:pointer; border-radius:4px;
    transition:background .1s;
  }
  .media-actions button:hover:not(:disabled) { background:var(--gray-100); color:var(--gray-800); }
  .media-actions button.danger:hover { background:#fef2f2; color:var(--red); }
  .media-actions button:disabled { opacity:.3; cursor:not-allowed; }
  .media-actions .btn-arrow { font-size:14px; font-weight:700; padding:3px 8px; }
  .media-thumb { cursor:zoom-in; }

  /* ─── Anteprima post (simula FB/IG nativo) ─── */
  .preview-tabs { display:flex; gap:4px; margin-bottom:12px; }
  .preview-tab {
    padding:6px 14px; font-size:13px; border-radius:14px;
    border:1px solid var(--gray-200); background:white; cursor:pointer;
  }
  .preview-tab.active { background:#111; color:white; border-color:#111; }
  .preview-frame {
    background:#f0f2f5; padding:14px; border-radius:8px;
    min-height:300px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif;
  }
  .pv-ratio-warn {
    background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; border-left: 4px solid #dc2626;
    padding: 8px 12px; border-radius: 6px; font-size: 12px; line-height: 1.45;
    margin-bottom: 10px;
  }
  .pv-ratio-warn strong { color: #7f1d1d; }

  .pv-card {
    background:white; border-radius:10px; overflow:hidden;
    max-width:470px; margin:0 auto;
    box-shadow:0 1px 2px rgba(0,0,0,.08);
  }
  .pv-header { display:flex; align-items:center; gap:10px; padding:10px 12px; }
  .pv-avatar {
    width:40px; height:40px; border-radius:50%; flex:none; overflow:hidden;
    background:#e5e7eb; display:flex; align-items:center; justify-content:center;
    font-weight:700; color:#6b7280; font-size:14px;
  }
  .pv-avatar.ig { background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); padding:2px; }
  .pv-avatar.ig .pv-avatar-inner { background:white; width:100%; height:100%; border-radius:50%; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .pv-avatar img { width:100%; height:100%; border-radius:50%; object-fit:cover; position:relative; z-index:2; }
  /* Iniziale come fallback: visibile solo quando img è nascosta (onerror) o assente */
  .pv-avatar .pv-avatar-init { position:absolute; z-index:1; }
  .pv-avatar, .pv-avatar-inner { position:relative; }
  .pv-avatar-inner[data-fallback="1"] .pv-avatar-init,
  .pv-avatar[data-fallback="1"] .pv-avatar-init { z-index:3; }
  .pv-name { font-weight:600; font-size:14px; line-height:1.2; color:#050505; }
  .pv-meta { font-size:12px; color:#65676b; margin-top:2px; }

  /* FB body */
  .pv-fb .pv-body { padding:0 12px 10px; font-size:14px; line-height:1.4; white-space:pre-wrap; word-wrap:break-word; color:#050505; }
  .pv-fb .pv-hashtag { color:#385898; }
  .pv-fb .pv-link { color:#385898; text-decoration:none; }
  .pv-fb .pv-media {
    background:#000; display:flex; justify-content:center; align-items:center;
    max-height:500px; overflow:hidden;
  }
  .pv-fb .pv-media img, .pv-fb .pv-media video { width:100%; height:auto; display:block; }
  .pv-fb .pv-actions {
    display:flex; border-top:1px solid #ced0d4; padding:2px 0;
    color:#65676b; font-size:13px; font-weight:600;
  }
  .pv-fb .pv-actions > div {
    flex:1; padding:8px; text-align:center;
    display:flex; align-items:center; justify-content:center; gap:6px;
  }

  /* IG body */
  .pv-ig .pv-media {
    position:relative; background:#fafafa;
    aspect-ratio:1/1; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .pv-ig .pv-media.reel { aspect-ratio:9/16; max-height:520px; }
  .pv-ig .pv-media img, .pv-ig .pv-media video { width:100%; height:100%; object-fit:cover; }
  .pv-ig .pv-carousel-dots {
    position:absolute; bottom:8px; left:50%; transform:translateX(-50%);
    display:flex; gap:4px; z-index:2;
  }
  .pv-ig .pv-carousel-dots span {
    width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.55);
  }
  .pv-ig .pv-carousel-dots span.active { background:white; }
  .pv-ig .pv-reel-badge {
    position:absolute; top:8px; right:8px; color:white; font-size:11px; font-weight:700;
    background:rgba(0,0,0,.5); padding:4px 8px; border-radius:10px; z-index:2;
  }
  .pv-ig .pv-actions {
    display:flex; justify-content:space-between; padding:10px 14px; font-size:22px;
  }
  .pv-ig .pv-actions-left { display:flex; gap:14px; }
  .pv-ig .pv-body { padding:0 14px 10px; font-size:13px; line-height:1.45; color:#262626; }
  .pv-ig .pv-body .ig-name { font-weight:700; margin-right:6px; }
  .pv-ig .pv-body .pv-hashtag { color:#00376b; }
  .pv-ig .pv-body .pv-link { color:#00376b; text-decoration:none; }
  .pv-ig .pv-body .pv-more { color:#8e8e8e; cursor:pointer; }

  /* Story: 9:16 full-bleed with text overlay */
  .pv-story {
    background:#000; aspect-ratio:9/16; max-width:260px; margin:0 auto;
    border-radius:14px; overflow:hidden; position:relative;
    display:flex; align-items:flex-end;
  }
  .pv-story-media { position:absolute; inset:0; }
  .pv-story-media img, .pv-story-media video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .pv-story-bar { position:absolute; top:6px; left:8px; right:8px; height:2px; background:rgba(255,255,255,.3); border-radius:1px; z-index:3; }
  .pv-story-bar::before { content:""; display:block; width:30%; height:100%; background:white; border-radius:1px; }
  .pv-story-header {
    position:absolute; top:14px; left:0; right:0; padding:0 10px;
    display:flex; align-items:center; gap:8px; z-index:3;
    color:white;
  }
  .pv-story-header .pv-avatar { width:30px; height:30px; font-size:12px; }
  .pv-story-header .pv-name { color:white; font-size:13px; text-shadow:0 1px 2px rgba(0,0,0,.6); }
  .pv-story-text {
    position:relative; color:white; padding:18px 14px; font-size:14px; line-height:1.3; z-index:2;
    text-shadow:0 1px 4px rgba(0,0,0,.8);
    max-height:50%; overflow:hidden;
  }
  .pv-empty { padding:40px; text-align:center; color:#8e8e8e; }

  /* Lightbox modal */
  .lightbox-backdrop {
    position:fixed; inset:0; background:rgba(0,0,0,0.82); z-index:1000;
    display:flex; align-items:center; justify-content:center;
  }
  .lightbox-card {
    background:white; border-radius:10px; max-width:95vw; max-height:95vh;
    width:900px; display:flex; flex-direction:column; overflow:hidden;
  }
  .lightbox-header {
    padding:12px 16px; border-bottom:1px solid var(--gray-200);
    display:flex; align-items:center; justify-content:space-between; gap:12px;
  }
  .lightbox-header h3 { margin:0; font-size:15px; font-weight:600; }
  .lightbox-body { flex:1; min-height:400px; max-height:70vh; overflow:auto; background:#111; display:flex; align-items:center; justify-content:center; }
  .lightbox-body img.cropper-target { display:block; max-width:100%; }
  .lightbox-body video { max-width:100%; max-height:70vh; }
  .lightbox-footer {
    padding:12px 16px; border-top:1px solid var(--gray-200);
    display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap;
  }
  .lightbox-ratios { display:flex; gap:4px; }
  .lightbox-ratios button {
    padding:4px 10px; font-size:12px; border-radius:4px;
    border:1px solid var(--gray-200); background:white; cursor:pointer; color:var(--gray-700);
  }
  .lightbox-ratios button.active { background:var(--blue); color:white; border-color:var(--blue); }
  .lightbox-close {
    background:transparent; border:0; font-size:22px; line-height:1; cursor:pointer;
    color:var(--gray-500); padding:4px 8px; border-radius:4px;
  }
  .lightbox-close:hover { background:var(--gray-100); color:var(--gray-800); }
</style>

<div class="breadcrumb">
  <a href="/dashboard">Clienti</a> /
  <a href="/dashboard/clients/<%= client.id %>#piano"><%= client.display_name %></a>
  <% if (post.editorial_plan_id) { %>
    / <a href="/dashboard/clients/<%= client.id %>/plan/<%= post.editorial_plan_id %>">Piano</a>
    <% if (post.month_number) { %>
      / <a href="/dashboard/clients/<%= client.id %>/plan/<%= post.editorial_plan_id %>/month/<%= post.month_number %>">Mese <%= post.month_number %></a>
    <% } %>
  <% } %>
  / Post
  <% if (post.category || post.sub_topic) { %>
    <span style="color:var(--gray-400)"> &mdash; <%= categoryDisplay %><%= post.sub_topic ? (post.category ? ' · ' : '') + post.sub_topic.substring(0,40) : '' %></span>
  <% } %>
</div>

<% if (typeof prevPostId !== 'undefined' && (prevPostId || nextPostId || monthUrl)) { %>
<div style="display:flex;gap:6px;align-items:center;margin:0 0 12px;flex-wrap:wrap">
  <% if (monthUrl) { %>
    <a href="<%= monthUrl %>" class="btn btn-sm btn-secondary" title="Torna alla vista del mese">&#8592; Tutti i post del mese</a>
  <% } %>
  <div style="flex:1"></div>
  <% if (prevPostId) { %>
    <a href="/dashboard/posts/<%= prevPostId %>" class="btn btn-sm btn-secondary" title="Post precedente">&#8592; Precedente</a>
  <% } else { %>
    <button class="btn btn-sm btn-secondary" disabled>&#8592; Precedente</button>
  <% } %>
  <% if (nextPostId) { %>
    <a href="/dashboard/posts/<%= nextPostId %>" class="btn btn-sm btn-secondary" title="Post successivo">Successivo &#8594;</a>
  <% } else { %>
    <button class="btn btn-sm btn-secondary" disabled>Successivo &#8594;</button>
  <% } %>
</div>
<% } %>

<% const calMonth = resolveCalendarMonth(post.month_number, planStartYM); %>
<div class="page-header">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <h1 style="margin:0"><%= categoryDisplay || 'Editor Post' %></h1>
    <span class="badge badge-<%= post.status %>" id="status-badge"><%= post.status %></span>
    <% if (post.month_number) { %>
      <span style="font-size:12px;color:var(--gray-600);background:#e0e7ff;padding:4px 10px;border-radius:6px;font-weight:600" title="Mese del piano editoriale<%= calMonth ? ' · ' + calMonth.label : '' %>">
        📅 Mese <%= post.month_number %><% if (calMonth) { %> · <%= calMonth.label %><% } %>
      </span>
    <% } %>
    <span id="post-date-display" style="font-size:13px;color:var(--gray-600);background:var(--gray-100);padding:4px 10px;border-radius:6px;font-weight:500"></span>
    <% if (post.approval_status === 'change_requested') { %>
      <span class="badge" style="background:#fef3c7;color:#92400e;font-weight:700">✏️ Modifiche richieste</span>
    <% } else if (post.approval_status === 'rejected') { %>
      <span class="badge" style="background:#fee2e2;color:#991b1b;font-weight:700">✗ Rifiutato dal cliente</span>
    <% } else if (post.approval_status === 'approved') { %>
      <span class="badge" style="background:#dcfce7;color:#14532d;font-weight:700">✓ Approvato</span>
    <% } else if (post.approval_status === 'pending') { %>
      <span class="badge" style="background:#e0e7ff;color:#3730a3;font-weight:700">⏳ In attesa approvazione</span>
    <% } %>
  </div>
  <div style="display:flex;gap:6px;flex-wrap:wrap">
    <% if (post.approval_status === 'change_requested' || post.approval_status === 'rejected') { %>
      <button class="btn btn-sm" style="background:#16a34a;color:#fff" onclick="markApplied('pending')" title="Le modifiche sono state applicate: rimette il post in 'pending' così il cliente può rivalutarlo al prossimo accesso al link di approvazione">✓ Modifiche applicate (rivaluta cliente)</button>
      <button class="btn btn-sm btn-secondary" onclick="markApplied('approved')" title="Segna direttamente come approvato (chiude la richiesta di modifica senza aspettare il cliente)">✓ Approva (admin)</button>
    <% } else if (post.approval_status === 'pending') { %>
      <button class="btn btn-sm" style="background:#16a34a;color:#fff" onclick="markApplied('approved')" title="Approva direttamente questo post (utile per post creati dopo l'approvazione mensile, che altrimenti resterebbero bloccati). Il publish guard non lo bloccherà più.">✓ Approva (admin)</button>
    <% } %>
    <% if (post.status !== 'published') { %>
      <button class="btn btn-sm" style="background:#0f1e4a;color:#fff" onclick="sendPostToClient()" title="Invia al cliente un'email con l'anteprima di questo singolo post (es. contenuto evento già concordato). Marca il post come approvato lato admin e lo mette in copia a EMC.">✉ Invia al cliente</button>
    <% } %>
    <% if (post.status !== 'ready' && post.status !== 'published') { %>
      <button class="btn btn-secondary btn-sm" onclick="markReady()" title="Cambia lo stato in 'ready': il post verrà pubblicato automaticamente alla scheduled_date se lo schedule del mese è attivo.">&#9654; Segna pronto</button>
    <% } else if (post.status === 'ready') { %>
      <button class="btn btn-secondary btn-sm" onclick="markDraft()" title="Rimette il post in bozza (non verrà pubblicato automaticamente)">&#8617; Torna in draft</button>
    <% } %>
    <% if (post.status !== 'published') { %>
      <button class="btn btn-sm" style="background:#dc2626;color:#fff" onclick="deleteCurrentPost()" title="Elimina definitivamente questo post (non disponibile per i post pubblicati)">🗑 Elimina post</button>
    <% } else { %>
      <button class="btn btn-sm" style="background:var(--gray-300);color:var(--gray-600);cursor:not-allowed" onclick="alertPublishedLocked()" title="I post pubblicati possono essere eliminati solo dall'amministratore">🔒 Pubblicato</button>
    <% } %>
  </div>
</div>

<% if (Array.isArray(comments) && comments.length) { %>
  <%
    const clientComments = comments.filter(c => c.author === 'client');
    const adminComments  = comments.filter(c => c.author === 'admin');
    const hasReviewState = post.approval_status === 'change_requested' || post.approval_status === 'rejected';
    const boxBg     = hasReviewState ? '#fef3c7' : '#f3f4f6';
    const boxBorder = hasReviewState ? '#f59e0b' : 'var(--gray-300)';
    const titleCol  = hasReviewState ? '#92400e' : 'var(--gray-700)';
  %>
  <div style="margin-bottom:16px;padding:14px 16px;background:<%= boxBg %>;border:1px solid <%= boxBorder %>;border-left:4px solid <%= boxBorder %>;border-radius:8px">
    <div style="font-weight:700;color:<%= titleCol %>;margin-bottom:10px;font-size:14px">
      <% if (hasReviewState) { %>✏️ Richieste del cliente<% } else { %>💬 Commenti<% } %>
      <% if (clientComments.length) { %>
        <span style="font-weight:500;font-size:12px;opacity:.85">· <%= clientComments.length %> dal cliente</span>
      <% } %>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px">
      <% comments.forEach(function(c){
           const isClient = c.author === 'client';
           const bg     = isClient ? '#fff' : '#eef2ff';
           const border = isClient ? '#fbbf24' : '#a5b4fc';
           const label  = isClient ? '👤 Cliente' : '🛠 Admin';
           const labelCol = isClient ? '#92400e' : '#3730a3';
      %>
        <div style="background:<%= bg %>;border:1px solid <%= border %>;border-radius:6px;padding:10px 12px">
          <div style="display:flex;justify-content:space-between;gap:10px;font-size:11px;margin-bottom:6px">
            <span style="font-weight:700;color:<%= labelCol %>"><%= label %></span>
            <span style="color:var(--gray-500)"><%= new Date(c.created_at + 'Z').toLocaleString('it-IT', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></span>
          </div>
          <div style="font-size:14px;color:var(--gray-800);white-space:pre-wrap;word-break:break-word"><%= c.text %></div>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<div class="post-editor-layout">
  <!-- Left: Caption + Dettagli -->
  <div>
    <div class="card" style="margin-bottom:16px">
      <div class="card-header">
        <h3>Caption</h3>
        <button class="btn btn-sm btn-secondary" onclick="generateCaption()" id="gen-caption-btn"><span style="margin-right:3px">✨</span>Genera Caption</button>
      </div>
      <div class="form-group">
        <textarea id="caption-text" rows="10" style="width:100%"><%= post.caption || '' %></textarea>
        <p style="font-size:11px;color:var(--gray-500);margin-top:4px;line-height:1.5">
          💡 <strong>Markdown supportato</strong> (FB e IG non lo fanno nativo, lo convertiamo in Unicode bold/italic):
          <code>**grassetto**</code>, <code>*corsivo*</code>, <code># Titolo</code>, <code>- lista</code> → clicca <em>Converti markdown</em> per vedere il risultato nel textarea.
        </p>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-sm btn-primary" onclick="saveCaption()">Salva Caption</button>
        <button class="btn btn-sm btn-secondary" onclick="convertMarkdown()" title="Converte ** *asterischi* e # titoli e - liste nel testo della caption in caratteri Unicode che FB/Instagram mostrano come grassetto/corsivo nativi">✨ Converti markdown</button>
      </div>
    </div>

    <%
      // Menzioni salvate come JSON array → stringa "@a @b" per il campo testo.
      let _mentionsStr = '';
      try {
        const _m = post.mentions ? JSON.parse(post.mentions) : [];
        if (Array.isArray(_m)) _mentionsStr = _m.join(' ');
      } catch (e) { _mentionsStr = post.mentions || ''; }
    %>
    <div class="card" style="margin-bottom:16px">
      <div class="card-header"><h3>Call to action &amp; menzioni</h3></div>
      <p style="font-size:11px;color:var(--gray-500);margin:0 0 12px;line-height:1.5">
        Vengono aggiunte in fondo alla caption alla pubblicazione (e nell'anteprima). I post organici non hanno bottoni cliccabili: la CTA è una riga di testo; su Instagram il link non è cliccabile → rimanda al «link in bio».
      </p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group">
          <label>Azione (CTA)</label>
          <input type="text" id="cta-label" list="cta-suggestions" placeholder="es. Prenota ora" value="<%= post.cta_label || '' %>" maxlength="120">
          <datalist id="cta-suggestions">
            <option value="Scopri di più"></option>
            <option value="Prenota ora"></option>
            <option value="Chiama ora"></option>
            <option value="Visita il sito"></option>
            <option value="Contattaci"></option>
            <option value="Acquista ora"></option>
            <option value="Scrivici in DM"></option>
            <option value="Link in bio"></option>
          </datalist>
        </div>
        <div class="form-group">
          <label>Link o telefono <span style="color:var(--gray-500);font-weight:400">(opzionale)</span></label>
          <input type="text" id="cta-url" placeholder="https://… oppure tel:+39…" value="<%= post.cta_url || '' %>" maxlength="300">
        </div>
      </div>
      <div class="form-group">
        <label>Menzioni / tag persone</label>
        <input type="text" id="post-mentions" placeholder="@mario_rossi @negozio_xyz" value="<%= _mentionsStr %>">
        <p style="font-size:11px;color:var(--gray-500);margin-top:4px;line-height:1.5">
          Username separati da spazio o virgola (con o senza «@»). Inseriti come menzioni in caption — IG e Pagine FB le rendono cliccabili. «Taggare tutti gli amici» non è permesso dalle API.
        </p>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn btn-sm btn-primary" onclick="saveCtaMentions()">Salva CTA &amp; menzioni</button>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-header"><h3>Dettagli</h3></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group">
          <label>Categoria</label>
          <%
            // Mappa code → name per display + flag "categoria orfana" se il
            // post ha un code non più presente nel piano (categoria rimossa).
            const _catMap = {};
            (categories || []).forEach(c => { _catMap[c.code] = c.name; });
            const _orphan = post.category && !_catMap[post.category];
          %>
          <select id="post-category">
            <option value="">— Senza categoria —</option>
            <% (categories || []).forEach(c => { %>
              <option value="<%= c.code %>" <%= post.category === c.code ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
            <% if (_orphan) { %>
              <option value="<%= post.category %>" selected><%= post.category %> (orfana)</option>
            <% } %>
          </select>
        </div>
        <div class="form-group">
          <label>Sub-topic</label>
          <input type="text" id="post-subtopic" value="<%= post.sub_topic || '' %>">
        </div>
        <div class="form-group">
          <label>Template (per generazione singola immagine)</label>
          <select id="post-template">
            <option value="quote"   <%= post.template === 'quote'   ? 'selected' : '' %>>Quote</option>
            <option value="service" <%= post.template === 'service' ? 'selected' : '' %>>Service</option>
            <option value="event"   <%= post.template === 'event'   ? 'selected' : '' %>>Event</option>
            <option value="floral"  <%= post.template === 'floral'  ? 'selected' : '' %>>Floral</option>
          </select>
        </div>
        <div class="form-group">
          <label>Immagine sorgente URL (background per template)</label>
          <input type="text" id="post-source-image" value="<%= post.source_image_url || '' %>" placeholder="URL immagine di sfondo">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">
        <div class="form-group">
          <label>Data pubblicazione</label>
          <input type="date" id="post-date" value="<%= post.scheduled_date || '' %>">
        </div>
        <div class="form-group">
          <label>Ora</label>
          <input type="time" id="post-time" value="<%= post.scheduled_time || '' %>">
        </div>
      </div>
      <button class="btn btn-sm btn-primary" onclick="saveDetails()" style="margin-top:12px">Salva Dettagli</button>
    </div>
  </div>

  <!-- Right: Tipo + Media + Pubblicazione -->
  <div>
    <div class="card" style="margin-bottom:16px">
      <div class="card-header"><h3>Tipo post</h3></div>
      <div class="type-chips" id="type-chips">
        <span class="type-chip" data-type="single_image">Singola</span>
        <span class="type-chip" data-type="carousel">Carousel</span>
        <span class="type-chip" data-type="reel">Reel</span>
        <span class="type-chip" data-type="story">Storia</span>
      </div>
      <p class="type-help" id="type-help"></p>
      <div id="reel-options" style="display:none;font-size:13px;border-top:1px solid var(--gray-200);padding-top:10px;margin-top:6px">
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
          <input type="checkbox" id="ig-share-to-feed" onchange="onShareToFeedChange()">
          Mostra anche nel feed Instagram (oltre alla tab Reels)
        </label>
        <p style="font-size:11px;color:var(--gray-500);margin:6px 0 0 22px">Se spuntato, il Reel appare nel feed normale + tab Reels (più visibilit&agrave;). Se non spuntato, &egrave; un "Reel puro" visibile solo nella tab Reels.</p>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-header">
        <h3>Media <span id="media-count" style="font-size:12px;color:var(--gray-400);font-weight:normal"></span></h3>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <select id="ai-aspect" title="Aspect ratio dell'immagine generata" style="padding:5px 8px;border:1px solid var(--gray-300);border-radius:6px;font-size:12px">
            <option value="1:1">1:1 — IG quadrato</option>
            <option value="4:5">4:5 — IG verticale feed</option>
            <option value="9:16">9:16 — Reel / Story</option>
            <option value="16:9">16:9 — FB orizzontale</option>
          </select>
          <button class="btn btn-sm btn-primary" onclick="generateAIImage()" id="gen-ai-btn" title="Genera un'immagine AI con Gemini (NanoBanana2) a partire dalla caption e dal contesto cliente"><span style="margin-right:3px">✨</span>Genera AI</button>
          <button class="btn btn-sm btn-primary" onclick="generateAIVideo()" id="gen-aivid-btn" title="Genera un Reel slideshow Ken Burns: 3 immagini AI animate con zoom/pan e crossfade" style="background:#7c3aed">🎬 Reel AI</button>
          <button class="btn btn-sm btn-primary" onclick="generateVeoVideo()" id="gen-veo-btn" title="Genera un video AI premium con Veo 3 (full-motion + audio nativo). Richiede billing attivo. Costo: ~$3-6 per 8s." style="background:linear-gradient(135deg,#f59e0b,#dc2626);border:none">💎 Veo Premium</button>
          <button class="btn btn-sm btn-secondary" onclick="generateImage()" id="gen-image-btn" title="Renderizza un'immagine dal template HTML selezionato (poster con testo)"><span style="margin-right:3px">🖼️</span>Da template</button>
          <button class="btn btn-sm btn-secondary" onclick="openLibraryPicker('video')" id="library-picker-btn" title="Scegli un video già presente nella libreria di questo cliente"><span style="margin-right:3px">📚</span>Video da libreria</button>
          <button class="btn btn-sm btn-secondary" onclick="openLibraryPicker('image')" id="library-picker-img-btn" title="Scegli un'immagine già presente nella libreria di questo cliente"><span style="margin-right:3px">📚</span>Immagine da libreria</button>
          <button class="btn btn-sm btn-secondary" onclick="autoPickLibrary()" id="auto-lib-btn" title="Sceglie automaticamente dalla libreria del cliente le immagini più coerenti con la caption e le allega al post (analisi AI delle immagini)"><span style="margin-right:3px">🎯</span>Scegli da libreria</button>
        </div>
      </div>

      <label class="uploader" id="uploader">
        <input type="file" id="media-input" multiple accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime">
        <svg class="uploader-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <div class="uploader-title"><em>Seleziona file</em> o trascinali qui</div>
        <div class="uploader-hint">Immagini: JPG / PNG / WEBP fino a 8MB<br>Video: MP4 / MOV fino a 250MB · massimo 10 file</div>
        <div class="upload-progress" id="upload-progress" style="display:none">
          <div class="upload-progress-text" id="upload-progress-text">Caricamento... 0%</div>
          <div class="upload-progress-bar"><div class="upload-progress-fill" id="upload-progress-fill"></div></div>
          <div class="upload-progress-sub" id="upload-progress-sub"></div>
        </div>
      </label>

      <div id="media-toolbar" class="media-toolbar" style="display:none">
        <div class="media-toolbar-left">
          <span><strong id="media-sel-count">0</strong> selezionati</span>
          <a onclick="selectAllMedia()">Seleziona tutti</a>
          <a onclick="clearMediaSelection()">Deseleziona</a>
        </div>
        <button class="btn btn-sm" style="background:#dc2626;color:#fff" onclick="bulkDeleteMedia()">&times; Rimuovi selezionati</button>
      </div>
      <div id="media-grid" class="media-grid"></div>
      <div id="carousel-warning" style="display:none;margin-top:12px;padding:12px 14px;background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;color:#92400e;font-size:13px;line-height:1.45">
        <strong>&#9888; Carousel incompleto</strong><br>
        Un post di tipo <strong>Carousel</strong> richiede almeno <strong>2 media</strong>. Con un solo media il post <strong>non verrà pubblicato</strong> finché non aggiungi almeno un'altra immagine (oppure cambia tipo a "Singola").
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-header"><h3>👁️ Anteprima</h3></div>
      <div class="preview-tabs">
        <button type="button" class="preview-tab active" data-pv="ig" onclick="setPreviewPlatform('ig')">Instagram</button>
        <button type="button" class="preview-tab" data-pv="fb" onclick="setPreviewPlatform('fb')">Facebook</button>
      </div>
      <div class="preview-frame" id="preview-frame"></div>
    </div>

    <% if (post.status === 'published') { %>
    <div class="card" style="margin-bottom:16px">
      <div class="card-header">
        <h3>📊 Insights</h3>
        <button class="btn btn-sm btn-secondary" onclick="refreshInsights()" id="refresh-insights-btn" title="Forza il recupero delle metriche Meta più recenti">↻ Aggiorna</button>
      </div>
      <div id="insights-container" style="font-size:13px;color:var(--gray-600)">Caricamento...</div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-header"><h3>Pubblicazione</h3></div>
      <% if (post.status === 'published') { %>
        <p style="color:var(--green);font-size:14px;margin-bottom:8px">Pubblicato il <%= fmtRome(post.published_at) %></p>
        <% if (post.fb_post_id) { %><p style="font-size:12px;color:var(--gray-500)">FB: <%= post.fb_post_id %></p><% } %>
        <% if (post.ig_media_id) { %><p style="font-size:12px;color:var(--gray-500)">IG: <%= post.ig_media_id %></p><% } %>
      <% } %>
      <div style="display:flex;gap:14px;margin:<%= post.status === 'published' ? '12px 0 10px' : '0 0 10px' %>;flex-wrap:wrap">
        <% if (client.fb_page_id) { %>
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
            <input type="checkbox" id="chan-fb" checked onchange="refreshPublishState()"> Facebook
          </label>
        <% } else { %>
          <span style="font-size:12px;color:var(--gray-400)">FB non configurato</span>
        <% } %>
        <% if (client.ig_user_id) { %>
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
            <input type="checkbox" id="chan-ig" checked onchange="refreshPublishState()"> Instagram
          </label>
        <% } else { %>
          <span style="font-size:12px;color:var(--gray-400)">IG non configurato</span>
        <% } %>
        <% if (client.linkedin_org_id && client.linkedin_access_token) { %>
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
            <input type="checkbox" id="chan-linkedin" checked onchange="refreshPublishState()"> LinkedIn
          </label>
        <% } else { %>
          <span style="font-size:12px;color:var(--gray-400)">LinkedIn non configurato</span>
        <% } %>
        <% if (client.tiktok_refresh_token || client.tiktok_access_token) { %>
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
            <input type="checkbox" id="chan-tiktok" checked onchange="refreshPublishState()"> TikTok
          </label>
        <% } else { %>
          <span style="font-size:12px;color:var(--gray-400)">TikTok non configurato</span>
        <% } %>
      </div>
      <button class="btn btn-primary" onclick="publishPost()" id="publish-btn">Pubblica</button>
      <p class="help" id="publish-help" style="margin-top:8px;color:var(--gray-500)"></p>
      <% if (post.publish_error) { %>
        <div class="form-error" style="margin-top:8px"><%= post.publish_error %></div>
      <% } %>
    </div>
  </div>
</div>

<!-- Lightbox modal -->
<div id="lightbox" style="display:none"></div>

<script>
  const POST_ID    = '<%= post.id %>';
  const CLIENT_ID  = '<%= client.id %>';
  const MONTH_URL  = '<%= (typeof monthUrl !== "undefined" && monthUrl) ? monthUrl : "" %>';
  const POST       = <%- JSON.stringify(post) %>;
  const HAS_IG     = <%= client.ig_user_id ? 'true' : 'false' %>;
  let   MEDIA      = <%- JSON.stringify(media || []) %>;
  let   MEDIA_TYPE = POST.media_type || 'single_image';
  const CLIENT_BRAND = {
    name: '<%= (client.brand_name || client.display_name || client.id).replace(/"/g, "&quot;") %>',
    website: '<%= (client.website || "").replace(/"/g, "&quot;") %>',
    // Endpoint dedicato che serve il logo estraendolo dal wrapper SVG (i raster dentro SVG non
    // sono caricabili da <img> via data: URI su certi browser). /assets/ non è un mount static.
    logo: '<%= client.logo_filename ? "/dashboard/api/clients/" + client.id + "/logo-preview" : "" %>'
  };
  let PREVIEW_PLATFORM = 'ig';

  const TYPE_HELP = {
    single_image: 'Una sola immagine. Caricala oppure generala da template.',
    carousel:     'Da 2 a 10 media dello stesso tipo (tutte immagini o tutti video). L\u2019ordine \u00e8 quello in cui appariranno nel carousel.',
    video:        'Tipo legacy. Su IG Meta lo tratta come Reel — usa direttamente Reel.',
    reel:         'Un video MP4/MOV verticale 9:16 (3-90s). Su Facebook va come video normale, su Instagram come Reel.',
    story:        '\u26a0\ufe0f Le storie devono essere pubblicate MANUALMENTE dal cliente dalla sua app (durano 24h). Qui le suggeriamo nel piano editoriale con caption + media di riferimento, ma non le pubblichiamo automaticamente.'
  };

  // Auth helper per fetch nativo (FormData usa boundary, non passabile via apiFetch)
  function getToken() {
    return localStorage.getItem('dashboard_token') || (document.cookie.split(';').find(c => c.trim().startsWith('dashboard_token=')) || '').split('=')[1] || '';
  }

  function setType(t) {
    MEDIA_TYPE = t;
    document.querySelectorAll('.type-chip').forEach(c => c.classList.toggle('active', c.dataset.type === t));
    document.getElementById('type-help').textContent = TYPE_HELP[t] || '';
    const reelOpts = document.getElementById('reel-options');
    if (reelOpts) {
      const isReelLike = (t === 'reel' || t === 'video');
      reelOpts.style.display = isReelLike ? 'block' : 'none';
      if (isReelLike) {
        document.getElementById('ig-share-to-feed').checked = (POST.ig_share_to_feed === 0 || POST.ig_share_to_feed === false) ? false : true;
      }
    }
    refreshPublishState();
    updateCarouselWarning();
    if (typeof renderPreview === 'function') renderPreview();
  }

  function updateCarouselWarning() {
    const el = document.getElementById('carousel-warning');
    if (!el) return;
    el.style.display = (MEDIA_TYPE === 'carousel' && MEDIA.length < 2) ? 'block' : 'none';
  }

  async function onShareToFeedChange() {
    const checked = document.getElementById('ig-share-to-feed').checked;
    POST.ig_share_to_feed = checked ? 1 : 0;
    await apiFetch('/dashboard/api/posts/' + POST_ID, {
      method: 'PUT',
      body: { ig_share_to_feed: checked ? 1 : 0 }
    });
    toast(checked ? 'Reel visibile anche nel feed' : 'Reel puro (solo tab Reels)');
  }

  function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  let SELECTED = new Set();

  function renderMedia() {
    const grid = document.getElementById('media-grid');
    document.getElementById('media-count').textContent = MEDIA.length ? '(' + MEDIA.length + ')' : '';
    // Pulisci la selezione dagli id non più presenti
    SELECTED = new Set([...SELECTED].filter(id => MEDIA.some(m => m.id === id)));
    grid.innerHTML = MEDIA.map((m, i) => {
      const url = m.url + (m.created_at ? '?v=' + encodeURIComponent(m.created_at) : '');
      // crossorigin="anonymous" anche sulla thumb: la cache del browser distingue
      // le risposte CORS da quelle no-CORS. Se la thumb è no-CORS e la lightbox
      // CORS, il browser non riusa la cache → l'<img> della lightbox fallisce.
      const thumb = m.kind === 'video'
        ? '<video src="' + url + (url.includes('#') ? '&t=0.5' : '#t=0.5') + '" muted preload="metadata" crossorigin="anonymous"></video>'
        : '<img src="' + url + '" alt="" crossorigin="anonymous">';
      const srcBadge = m.source !== 'upload' ? '<span class="media-source-badge ' + m.source + '">' + m.source + '</span>' : '';
      const posBadge = MEDIA.length > 1 ? '<span class="media-pos-badge">' + (i + 1) + ' / ' + MEDIA.length + '</span>' : '';
      // Warning proporzioni IG: se il cliente ha IG e il ratio è fuori range, mostra un badge rosso
      let ratioBadge = '';
      let ratioItemClass = '';
      if (HAS_IG && m.kind === 'image' && m.width && m.height) {
        const r = m.width / m.height;
        if (r < 0.8 || r > 1.91) {
          ratioBadge = '<span class="ratio-warn-badge" title="Proporzioni ' + r.toFixed(2) + ':1 (' + m.width + '×' + m.height + ') fuori range IG. Click sulla thumb per croppare a 1:1 o 4:5.">\u26A0 RATIO</span>';
          ratioItemClass = ' ratio-warn';
        }
      }
      let stylizeBtn;
      if (m.kind === 'image') {
        stylizeBtn = '';
        if (m.source !== 'styled') {
          stylizeBtn += '<button onclick="event.stopPropagation();stylizeMedia(\'' + m.id + '\')" title="Applica overlay branded (template Puppeteer)">\u2728 Stilizza</button>';
        }
        stylizeBtn += '<button onclick="event.stopPropagation();openAnimateImageModal(\'' + m.id + '\')" title="Trasforma questa immagine in un video Reel (Ken Burns + audio opzionale)">\uD83C\uDFAC Reel</button>';
      } else if (m.kind === 'video') {
        stylizeBtn = '<button onclick="event.stopPropagation();openReplaceAudioModal(\'' + m.id + '\')" title="Sostituisci la traccia audio del video">\uD83C\uDFB5 Audio</button>'
          + '<button onclick="event.stopPropagation();saveMediaToLibrary(\'' + m.id + '\')" title="Salva questo video nella libreria del cliente per riusarlo">\uD83D\uDCBE Libreria</button>';
      } else {
        stylizeBtn = '<span></span>';
      }
      const arrows = MEDIA.length > 1
        ? '<button class="btn-arrow" onclick="event.stopPropagation();moveMedia(\'' + m.id + '\', -1)" ' + (i === 0 ? 'disabled' : '') + ' title="Sposta a sinistra">\u2190</button>'
          + '<button class="btn-arrow" onclick="event.stopPropagation();moveMedia(\'' + m.id + '\', 1)" ' + (i === MEDIA.length - 1 ? 'disabled' : '') + ' title="Sposta a destra">\u2192</button>'
        : '';
      const checked = SELECTED.has(m.id) ? 'checked' : '';
      const selectedClass = SELECTED.has(m.id) ? ' selected' : '';
      return '<div class="media-item' + selectedClass + ratioItemClass + '">'
        + '<input type="checkbox" class="media-select" ' + checked + ' onclick="event.stopPropagation();toggleMediaSelect(\'' + m.id + '\')" title="Seleziona per rimozione massiva">'
        + '<div class="media-thumb" onclick="openLightbox(\'' + m.id + '\')" title="Clicca per ingrandire">' + thumb + srcBadge + posBadge + ratioBadge + '</div>'
        + '<div class="media-actions">'
        +   stylizeBtn
        +   '<div style="display:flex;gap:2px">' + arrows + '</div>'
        +   '<button class="danger" onclick="event.stopPropagation();deleteMedia(\'' + m.id + '\')" title="Rimuovi">\u00d7</button>'
        + '</div>'
        + '</div>';
    }).join('');
    updateSelectionToolbar();
    refreshPublishState();
    updateCarouselWarning();
    if (typeof renderPreview === 'function') renderPreview();
  }

  function updateSelectionToolbar() {
    const tb = document.getElementById('media-toolbar');
    if (!tb) return;
    const n = SELECTED.size;
    if (n === 0) {
      tb.style.display = 'none';
    } else {
      tb.style.display = 'flex';
      document.getElementById('media-sel-count').textContent = n;
    }
  }

  function toggleMediaSelect(id) {
    if (SELECTED.has(id)) SELECTED.delete(id);
    else                  SELECTED.add(id);
    // Aggiorna solo lo stile del singolo item invece di re-render completo
    const item = document.querySelector('.media-item input[onclick*="' + id + '"]');
    if (item) item.parentElement.classList.toggle('selected', SELECTED.has(id));
    updateSelectionToolbar();
  }

  function selectAllMedia() {
    MEDIA.forEach(m => SELECTED.add(m.id));
    renderMedia();
  }

  function clearMediaSelection() {
    SELECTED.clear();
    renderMedia();
  }

  async function bulkDeleteMedia() {
    if (SELECTED.size === 0) return;
    const n = SELECTED.size;
    if (!await showConfirm('Rimuovere ' + n + ' media? L\u2019operazione non si pu\u00f2 annullare.')) return;
    const ids = [...SELECTED];
    const results = await Promise.all(ids.map(id =>
      apiFetch('/dashboard/api/posts/' + POST_ID + '/media/' + id, { method: 'DELETE' })
        .then(() => ({ id, ok: true }))
        .catch(err => ({ id, ok: false, err: err.message }))
    ));
    const okCount = results.filter(r => r.ok).length;
    const failed  = results.filter(r => !r.ok);
    MEDIA = MEDIA.filter(m => !ids.includes(m.id) || failed.some(f => f.id === m.id));
    SELECTED.clear();
    renderMedia();
    if (failed.length === 0) {
      toast(okCount + ' media rimossi');
    } else {
      await showAlert('Rimossi: ' + okCount + '. Falliti: ' + failed.length + ' (' + failed.map(f => f.err).join('; ') + ')');
    }
  }

  // Valida media correnti vs media_type. Ritorna stringa errore o null.
  function validateMediaCoherence() {
    if (MEDIA_TYPE === 'story') {
      // Le storie non passano per il nostro publish backend. La validazione
      // serve solo per coerenza UI: ok averne 0 o 1, sono materiale di riferimento.
      if (MEDIA.length > 1) return 'Storia: massimo 1 media di riferimento';
      return null;
    }
    if (MEDIA_TYPE === 'single_image') {
      if (MEDIA.length === 0) return 'Carica una immagine';
      if (MEDIA.length > 1)   return 'Singola immagine: rimuovi i media in eccesso';
      if (MEDIA[0].kind !== 'image') return 'Singola immagine: il media deve essere image';
    } else if (MEDIA_TYPE === 'carousel') {
      if (MEDIA.length < 2)  return 'Carousel: servono almeno 2 media';
      if (MEDIA.length > 10) return 'Carousel: massimo 10 media';
      const kinds = new Set(MEDIA.map(m => m.kind));
      if (kinds.size > 1)    return 'Carousel: tutti i media devono essere dello stesso tipo';
    } else if (MEDIA_TYPE === 'video' || MEDIA_TYPE === 'reel') {
      if (MEDIA.length !== 1)        return MEDIA_TYPE + ': serve esattamente 1 video';
      if (MEDIA[0].kind !== 'video') return MEDIA_TYPE + ': il media deve essere video';
    }
    return null;
  }

  function selectedChannels() {
    const c = [];
    const fb = document.getElementById('chan-fb');
    const ig = document.getElementById('chan-ig');
    const li = document.getElementById('chan-linkedin');
    const tt = document.getElementById('chan-tiktok');
    if (fb && fb.checked) c.push('fb');
    if (ig && ig.checked) c.push('ig');
    if (li && li.checked) c.push('linkedin');
    if (tt && tt.checked) c.push('tiktok');
    return c;
  }

  const CHANNEL_LABELS = { fb: 'Facebook', ig: 'Instagram', linkedin: 'LinkedIn', tiktok: 'TikTok' };
  function channelNames(channels) {
    return channels.map(c => CHANNEL_LABELS[c] || c);
  }

  function publishLabel(channels) {
    const prefix = POST.status === 'published' ? 'Pubblica di nuovo' : 'Pubblica';
    if (!channels.length) return prefix;
    return prefix + ' su ' + channelNames(channels).join(' + ');
  }

  function refreshPublishState() {
    const btn  = document.getElementById('publish-btn');
    const help = document.getElementById('publish-help');
    if (!btn) return;

    // Le storie non si pubblicano dalla dashboard — task per il cliente
    if (MEDIA_TYPE === 'story') {
      btn.disabled = true;
      btn.textContent = 'Da pubblicare manualmente dal cliente';
      btn.style.opacity = '0.6';
      help.innerHTML = '\u2139\ufe0f Le storie sono suggerimenti per il cliente. Salva caption e media di riferimento, il cliente le pubblicher\u00e0 dalla sua app entro 24h.';
      return;
    }
    btn.style.opacity = '';

    const captionOk = !!document.getElementById('caption-text').value.trim();
    const err = validateMediaCoherence();
    const channels = selectedChannels();

    btn.textContent = publishLabel(channels);

    if (!channels.length) {
      btn.disabled = true;
      help.textContent = 'Seleziona almeno una piattaforma (Facebook, Instagram o LinkedIn)';
      return;
    }
    if (!captionOk) {
      btn.disabled = true;
      help.textContent = 'Scrivi/genera la caption prima di pubblicare';
      return;
    }
    if (err) {
      btn.disabled = true;
      help.textContent = err;
      return;
    }
    btn.disabled = false;
    help.textContent = '';
  }

  // ── Lightbox ──

  let cropperInstance = null;

  function openLightbox(mediaId) {
    const m = MEDIA.find(x => x.id === mediaId);
    if (!m) return;
    const box = document.getElementById('lightbox');
    const url = m.url + (m.created_at ? '?v=' + encodeURIComponent(m.created_at) : '');

    let bodyHtml, footerHtml, title;
    if (m.kind === 'image') {
      title = 'Anteprima immagine — ' + (m.source || 'upload');
      bodyHtml = '<img id="lb-img" class="cropper-target" crossorigin="anonymous" src="' + url + '" alt="">';
      footerHtml =
        '<div class="lightbox-ratios">'
        + '<button class="active" onclick="setCropRatio(NaN, this)" title="Ratio libero">Libero</button>'
        + '<button onclick="setCropRatio(1/1, this)" title="IG feed quadrato">1:1</button>'
        + '<button onclick="setCropRatio(4/5, this)" title="IG feed verticale">4:5</button>'
        + '<button onclick="setCropRatio(9/16, this)" title="IG Reel / Story">9:16</button>'
        + '<button onclick="setCropRatio(16/9, this)" title="FB orizzontale">16:9</button>'
        + '</div>'
        + '<div style="display:flex;gap:8px">'
        + '<button class="btn btn-sm btn-secondary" onclick="closeLightbox()">Annulla</button>'
        + '<button class="btn btn-sm btn-primary" onclick="saveCrop(\'' + m.id + '\')">Salva crop</button>'
        + '</div>';
    } else {
      title = 'Anteprima video — ' + (m.source || 'upload');
      bodyHtml = '<video id="lb-video" controls src="' + url + '" data-media-id="' + m.id + '"></video>';
      footerHtml =
        '<div style="display:flex;flex-direction:column;gap:8px;width:100%">'
        +   '<div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">'
        +     '<span style="font-size:11px;color:var(--gray-600);font-weight:600">\u2702 Trim:</span>'
        +     '<label style="font-size:11px;color:var(--gray-600);display:flex;align-items:center;gap:4px">Inizio (s)'
        +       '<input type="number" id="lb-trim-start" value="0" min="0" step="0.1" style="width:80px;padding:4px 6px;border:1px solid var(--gray-300);border-radius:4px;font-size:12px">'
        +     '</label>'
        +     '<label style="font-size:11px;color:var(--gray-600);display:flex;align-items:center;gap:4px">Fine (s)'
        +       '<input type="number" id="lb-trim-end" value="" min="0" step="0.1" placeholder="—" style="width:80px;padding:4px 6px;border:1px solid var(--gray-300);border-radius:4px;font-size:12px">'
        +     '</label>'
        +     '<button class="btn btn-sm btn-secondary" id="lb-trim-set-cur-start" type="button" title="Usa il tempo corrente del player come inizio">\u2191 da player</button>'
        +     '<button class="btn btn-sm btn-secondary" id="lb-trim-set-cur-end" type="button" title="Usa il tempo corrente del player come fine">\u2193 da player</button>'
        +     '<button class="btn btn-sm btn-secondary" id="lb-trim-preview" type="button">\u25B6 Anteprima</button>'
        +     '<span id="lb-trim-info" style="font-size:11px;color:var(--gray-500);margin-left:auto"></span>'
        +   '</div>'
        +   '<div style="display:flex;justify-content:flex-end;gap:8px">'
        +     '<label style="font-size:11px;color:var(--gray-600);display:flex;align-items:center;gap:4px;margin-right:auto">'
        +       '<input type="radio" name="lb-trim-mode" value="overwrite" checked> Sovrascrivi'
        +     '</label>'
        +     '<label style="font-size:11px;color:var(--gray-600);display:flex;align-items:center;gap:4px">'
        +       '<input type="radio" name="lb-trim-mode" value="duplicate"> Mantieni originale'
        +     '</label>'
        +     '<button class="btn btn-sm btn-secondary" onclick="closeLightbox()">Chiudi</button>'
        +     '<button class="btn btn-sm btn-primary" id="lb-trim-apply" type="button">\u2702 Applica trim</button>'
        +   '</div>'
        + '</div>';
    }

    box.innerHTML =
      '<div class="lightbox-backdrop" onclick="if(event.target===this) closeLightbox()">'
      +   '<div class="lightbox-card">'
      +     '<div class="lightbox-header">'
      +       '<h3>' + escapeHtml(title) + '</h3>'
      +       '<button class="lightbox-close" onclick="closeLightbox()" title="Chiudi">\u00d7</button>'
      +     '</div>'
      +     '<div class="lightbox-body">' + bodyHtml + '</div>'
      +     '<div class="lightbox-footer">' + footerHtml + '</div>'
      +   '</div>'
      + '</div>';
    box.style.display = 'block';

    if (m.kind === 'video') {
      requestAnimationFrame(() => {
        const v = document.getElementById('lb-video');
        const startInp = document.getElementById('lb-trim-start');
        const endInp = document.getElementById('lb-trim-end');
        const info = document.getElementById('lb-trim-info');
        const previewBtn = document.getElementById('lb-trim-preview');
        const applyBtn = document.getElementById('lb-trim-apply');
        const setStartBtn = document.getElementById('lb-trim-set-cur-start');
        const setEndBtn = document.getElementById('lb-trim-set-cur-end');
        if (!v || !applyBtn) return;

        let dur = 0;
        let previewTimer = null;

        const fmt = (s) => {
          if (!isFinite(s) || s < 0) return '0:00';
          const mm = Math.floor(s / 60), ss = Math.floor(s % 60);
          return mm + ':' + String(ss).padStart(2, '0');
        };

        v.addEventListener('loadedmetadata', () => {
          dur = v.duration || 0;
          info.textContent = 'Durata: ' + fmt(dur) + ' (' + dur.toFixed(1) + 's)';
          startInp.max = dur.toFixed(1);
          endInp.max = dur.toFixed(1);
          endInp.placeholder = dur.toFixed(1);
        });

        setStartBtn.addEventListener('click', () => {
          startInp.value = (v.currentTime || 0).toFixed(1);
        });
        setEndBtn.addEventListener('click', () => {
          endInp.value = (v.currentTime || 0).toFixed(1);
        });

        previewBtn.addEventListener('click', () => {
          if (previewTimer) { clearTimeout(previewTimer); previewTimer = null; }
          const s = Math.max(0, parseFloat(startInp.value) || 0);
          const e = parseFloat(endInp.value) || dur;
          if (e <= s) { showAlert('Fine deve essere maggiore di inizio'); return; }
          v.currentTime = s;
          v.play();
          previewTimer = setTimeout(() => { v.pause(); previewTimer = null; }, Math.round((e - s) * 1000));
        });

        applyBtn.addEventListener('click', async () => {
          const s = Math.max(0, parseFloat(startInp.value) || 0);
          const e = parseFloat(endInp.value);
          if (!isFinite(e) || e <= s) { await showAlert('Fine deve essere maggiore di inizio'); return; }
          if (e - s < 0.5) { await showAlert('Trim troppo corto (minimo 0.5s)'); return; }
          const mode = (document.querySelector('input[name="lb-trim-mode"]:checked') || {}).value || 'overwrite';

          applyBtn.disabled = true;
          applyBtn.innerHTML = '<span class="loading"></span> Elaborazione...';
          try {
            const r = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media/' + mediaId + '/trim', {
              method: 'POST',
              body: { start_sec: s, end_sec: e, mode }
            });
            if (r.error) { await showAlert(r.error); applyBtn.disabled = false; applyBtn.textContent = '\u2702 Applica trim'; return; }
            if (r.media) {
              if (r.mode === 'duplicate') {
                MEDIA.push(r.media);
              } else {
                const idx = MEDIA.findIndex(x => x.id === r.media.id);
                if (idx >= 0) {
                  r.media.url = r.media.url + (r.media.url.includes('?') ? '&' : '?') + '_t=' + Date.now();
                  MEDIA[idx] = r.media;
                }
              }
              renderMedia();
            }
            toast(r.mode === 'duplicate' ? 'Nuovo video creato (trimmato)' : 'Video trimmato (' + r.duration_sec.toFixed(1) + 's)');
            closeLightbox();
          } catch (err) {
            applyBtn.disabled = false;
            applyBtn.textContent = '\u2702 Applica trim';
            await showAlert('Errore: ' + err.message);
          }
        });
      });
    }

    if (m.kind === 'image') {
      // Aspetta il paint del modal prima di toccare il DOM
      requestAnimationFrame(() => {
        const img = document.getElementById('lb-img');
        if (!img) { console.error('[lightbox] img element missing'); return; }

        const initCropper = () => {
          if (typeof Cropper === 'undefined') {
            console.error('[lightbox] Cropper.js non caricato (CDN bloccata?)');
            showAlert('Cropper.js non caricato. Ricarica la pagina (Ctrl+F5).');
            return;
          }
          try {
            cropperInstance = new Cropper(img, {
              viewMode: 1,
              autoCropArea: 1,
              background: false,
              zoomable: true,
              aspectRatio: NaN
            });
            console.log('[lightbox] Cropper inizializzato');
          } catch (err) {
            console.error('[lightbox] Cropper init failed:', err);
            showAlert('Errore Cropper: ' + err.message);
          }
        };

        if (img.complete && img.naturalWidth > 0) {
          initCropper();
        } else {
          img.addEventListener('load', initCropper, { once: true });
          img.addEventListener('error', () => {
            console.error('[lightbox] img load failed:', img.src);
            showAlert('Impossibile caricare l\u2019immagine per il crop.');
          }, { once: true });
        }
      });
    }

    // ESC per chiudere
    document.addEventListener('keydown', onLightboxKey);
  }

  function onLightboxKey(e) {
    if (e.key === 'Escape') closeLightbox();
  }

  function setCropRatio(ratio, btn) {
    if (!cropperInstance) return;
    cropperInstance.setAspectRatio(ratio);
    document.querySelectorAll('.lightbox-ratios button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function closeLightbox() {
    if (cropperInstance) { try { cropperInstance.destroy(); } catch (_) {} cropperInstance = null; }
    const box = document.getElementById('lightbox');
    box.style.display = 'none';
    box.innerHTML = '';
    document.removeEventListener('keydown', onLightboxKey);
  }

  async function saveCrop(mediaId) {
    if (!cropperInstance) {
      await showAlert('Cropper non pronto. Aspetta che l\u2019immagine sia caricata o chiudi e riapri la finestra.');
      return;
    }
    let canvas;
    try {
      canvas = cropperInstance.getCroppedCanvas({
        imageSmoothingQuality: 'high',
        maxWidth: 4096,
        maxHeight: 4096
      });
    } catch (err) {
      console.error('[saveCrop] getCroppedCanvas threw:', err);
      await showAlert('Errore crop: ' + err.message);
      return;
    }
    if (!canvas) {
      await showAlert('Crop area vuota o immagine non leggibile dal browser.');
      return;
    }
    // toBlob puo' restituire null se il canvas e' "tainted" (CORS)
    canvas.toBlob(async (blob) => {
      if (!blob) {
        await showAlert('Impossibile generare il blob (immagine cross-origin non accessibile). Ricarica la pagina e riprova.');
        return;
      }
      try {
        const fd = new FormData();
        fd.append('file', blob, 'cropped.jpg');
        const res = await fetch('/dashboard/api/posts/' + POST_ID + '/media/' + mediaId + '/crop', {
          method: 'POST', body: fd,
          headers: { 'Authorization': 'Bearer ' + getToken() }
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.error) {
          await showAlert('Errore server: ' + (data.error || ('HTTP ' + res.status)));
          return;
        }
        const idx = MEDIA.findIndex(m => m.id === mediaId);
        if (idx >= 0 && data.media) MEDIA[idx] = data.media;
        renderMedia();
        closeLightbox();
        toast('Crop salvato');
      } catch (err) {
        console.error('[saveCrop] upload error:', err);
        await showAlert('Errore upload: ' + err.message);
      }
    }, 'image/jpeg', 0.92);
  }

  // ── API actions ──

  function fmtBytes(n) {
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' KB';
    return (n / 1024 / 1024).toFixed(1) + ' MB';
  }

  function showUploadProgress(loaded, total, fileCount) {
    const pct = total > 0 ? Math.min(100, Math.round((loaded / total) * 100)) : 0;
    document.getElementById('upload-progress-fill').style.width = pct + '%';
    document.getElementById('upload-progress-text').textContent = 'Caricamento... ' + pct + '%';
    document.getElementById('upload-progress-sub').textContent =
      fmtBytes(loaded) + ' / ' + fmtBytes(total) + ' (' + fileCount + ' file)';
  }

  function uploadFiles(files) {
    return new Promise((resolve) => {
      if (!files.length) return resolve();
      const dzEl = document.getElementById('uploader');
      const progressEl = document.getElementById('upload-progress');
      dzEl.classList.add('is-uploading');
      progressEl.style.display = 'flex';
      showUploadProgress(0, 1, files.length);

      const fd = new FormData();
      Array.from(files).forEach(f => fd.append('media', f));

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/dashboard/api/posts/' + POST_ID + '/media', true);
      xhr.setRequestHeader('Authorization', 'Bearer ' + getToken());

      xhr.upload.addEventListener('progress', (e) => {
        if (e.lengthComputable) {
          showUploadProgress(e.loaded, e.total, files.length);
        }
      });

      xhr.upload.addEventListener('load', () => {
        // Upload completato lato client, server sta processando
        document.getElementById('upload-progress-fill').style.width = '100%';
        document.getElementById('upload-progress-text').textContent = 'Elaborazione...';
        document.getElementById('upload-progress-sub').textContent = 'Il server sta salvando i file';
      });

      xhr.onload = async () => {
        let data = {};
        try { data = JSON.parse(xhr.responseText); } catch (_) {}
        const ok = xhr.status >= 200 && xhr.status < 300;
        if (!ok && (!data.media || !data.media.length)) {
          dzEl.classList.remove('is-uploading');
          progressEl.style.display = 'none';
          await showAlert('Upload fallito: ' + (data.error || ('HTTP ' + xhr.status)));
          return resolve();
        }
        if (data.errors && data.errors.length) {
          toast('Alcuni file scartati: ' + data.errors.map(e => e.file + ' (' + e.error + ')').join(', '));
        }
        MEDIA = MEDIA.concat(data.media || []);
        renderMedia();
        dzEl.classList.remove('is-uploading');
        progressEl.style.display = 'none';

        // Auto-switch del tipo post a "Reel" se è stato caricato un video e il tipo
        // attuale è ancora una variante statica (singola/carousel). Reel è il formato
        // social più comune per video verticali; se serve "Video" (feed classico) o
        // "Storia" l'utente può ancora cambiarlo dai chip.
        const uploadedVideo = (data.media || []).find(m => m.kind === 'video');
        if (uploadedVideo && MEDIA_TYPE !== 'reel' && MEDIA_TYPE !== 'video' && MEDIA_TYPE !== 'story') {
          const typeRes = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media-type', {
            method: 'PUT', body: { media_type: 'reel' }
          });
          if (!typeRes.error) {
            setType('reel');
            toast('Video rilevato: tipo post impostato su "Reel". Cambialo dai chip se preferisci un altro formato.');
          }
        }

        // Check warnings proporzioni Instagram: se il backend ha flaggato un media,
        // avvisa l'utente e proponi il crop tool subito (preset 1:1 quadrato = sempre OK).
        const withWarnings = (data.media || []).filter(m => m._warnings && m._warnings.length);
        if (withWarnings.length) {
          const first = withWarnings[0];
          const warn = first._warnings[0];
          const msg = withWarnings.length > 1
            ? `⚠️ ${withWarnings.length} immagini hanno proporzioni non adatte a Instagram.\n\nPrima immagine:\n${warn}\n\nVuoi aprire ora lo strumento di ritaglio per sistemarla a 1:1 (quadrato, sempre compatibile)?`
            : `⚠️ ${warn}\n\nVuoi aprire ora lo strumento di ritaglio per sistemarla a 1:1 (quadrato, sempre compatibile)?`;
          if (await showConfirm(msg)) {
            // Apri lightbox e dopo un tick imposta il ratio 1:1
            openLightbox(first.id);
            setTimeout(() => {
              if (typeof setCropRatio === 'function') setCropRatio(1);
              else if (typeof cropperInstance !== 'undefined' && cropperInstance) { try { cropperInstance.setAspectRatio(1); } catch (_) {} }
            }, 600);
          }
        }
        resolve();
      };

      xhr.onerror = async () => {
        dzEl.classList.remove('is-uploading');
        progressEl.style.display = 'none';
        await showAlert('Errore di rete durante l\u2019upload');
        resolve();
      };

      xhr.send(fd);
    });
  }

  document.getElementById('media-input').addEventListener('change', e => uploadFiles(e.target.files));
  const dz = document.getElementById('uploader');
  ['dragenter','dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('dragover'); }));
  ['dragleave','drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('dragover'); }));
  dz.addEventListener('drop', e => uploadFiles(e.dataTransfer.files));

  async function deleteMedia(id) {
    if (!await showConfirm('Rimuovere questo media?')) return;
    const res = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media/' + id, { method: 'DELETE' });
    if (res.error) { await showAlert(res.error); return; }
    MEDIA = MEDIA.filter(m => m.id !== id);
    renderMedia();
  }

  async function deleteCurrentPost() {
    if (!await showConfirm('Eliminare definitivamente questo post? L\u2019operazione non si pu\u00f2 annullare.')) return;
    try {
      const res = await apiFetch('/dashboard/api/posts/' + POST_ID, { method: 'DELETE' });
      if (res.error) { await showAlert(res.error); return; }
      // Flash toast che la pagina di destinazione mostrerà al load
      try { sessionStorage.setItem('flash_toast', 'Post eliminato'); } catch (_) {}
      // Torna alla vista mese del piano editoriale del post.
      // Usa monthUrl server-rendered (rotta corretta /dashboard/clients/:id/plan/:planId/month/:month).
      const target = (typeof MONTH_URL !== 'undefined' && MONTH_URL)
        ? MONTH_URL
        : '/dashboard/clients/' + CLIENT_ID;
      window.location.href = target;
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
