  async function markReady() {
    const caption = (document.getElementById('caption-text').value || '').trim();
    const mediaCount = (typeof MEDIA !== 'undefined' ? MEDIA.length : 0);
    const hasLegacyImage = !!POST.image_url;
    if (!caption) { await showAlert('Serve una caption prima di segnare il post come pronto.'); return; }
    if (mediaCount === 0 && !hasLegacyImage) { await showAlert('Serve almeno un media (immagine o video) prima di segnare il post come pronto.'); return; }
    const coherenceErr = validateMediaCoherence();
    if (coherenceErr) { await showAlert(coherenceErr + '. Il post non verrà pubblicato finché non risolvi questo problema.'); return; }
    // Validazione aspect ratio Instagram (solo se cliente ha IG configurato, assunto se HAS_IG è true)
    if (typeof HAS_IG !== 'undefined' && HAS_IG && typeof MEDIA !== 'undefined') {
      const badImage = (MEDIA || []).find(m => m.kind === 'image' && m.width && m.height && (m.width / m.height < 0.8 || m.width / m.height > 1.91));
      if (badImage) {
        const r = (badImage.width / badImage.height).toFixed(2);
        await showAlert(`L'immagine ha proporzioni ${r}:1 (${badImage.width}×${badImage.height}), fuori dal range accettato da Instagram (0.8-1.91). Croppa a 1:1 (quadrato) cliccando sulla thumbnail, poi riprova.`);
        return;
      }
    }
    if (!POST.scheduled_date) {
      if (!await showConfirm('Il post non ha una scheduled_date impostata: non verrà pubblicato automaticamente finché non gliela imposti. Vuoi comunque segnarlo come pronto?')) return;
    }
    try {
      const res = await apiFetch('/dashboard/api/posts/' + POST_ID, { method: 'PUT', body: { status: 'ready' } });
      if (res.error) { await showAlert(res.error); return; }
      toast('Post pronto per publish');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

