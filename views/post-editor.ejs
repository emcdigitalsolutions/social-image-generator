            <div style="display:flex;gap:14px;margin-bottom:12px">
              <div style="flex:1">
                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Aspect ratio</label>
                <select id="veo-aspect" style="width:100%;padding:7px 9px;border:1px solid var(--gray-300);border-radius:5px;font-size:13px">
                  <option value="9:16" selected>9:16 — Reel/Story</option>
                  <option value="16:9">16:9 — FB orizzontale</option>
                </select>
              </div>
              <div style="flex:1">
                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Durata (sec)</label>
                <select id="veo-dur" style="width:100%;padding:7px 9px;border:1px solid var(--gray-300);border-radius:5px;font-size:13px">
                  <option value="4">4 sec</option>
                  <option value="5">5 sec</option>
                  <option value="6">6 sec</option>
                  <option value="7">7 sec</option>
                  <option value="8" selected>8 sec</option>
                </select>
              </div>
              <div style="flex:1">
                <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Modello</label>
                <select id="veo-variant" style="width:100%;padding:7px 9px;border:1px solid var(--gray-300);border-radius:5px;font-size:13px">
                  <option value="fast" selected>Fast (720p, ~$0.40/s)</option>
                  <option value="standard">Standard (1080p, ~$0.75/s)</option>
                </select>
              </div>
            </div>

            <label style="font-size:12px;font-weight:600;display:block;margin-bottom:4px">Prompt cinematografico (inglese)</label>
            <textarea id="veo-prompt" style="width:100%;min-height:180px;padding:10px;border:1px solid var(--gray-300);border-radius:6px;font-family:inherit;font-size:13px;line-height:1.5;resize:vertical;box-sizing:border-box"></textarea>
            <div style="font-size:11px;color:var(--gray-500);margin-top:6px">Suggerimento: includi <strong>camera movement</strong> ("slow dolly in", "tracking shot"), <strong>ambient sound</strong> ("birds chirping", "soft acoustic guitar"), e <strong>action</strong> verbale (cosa succede negli 8 sec).</div>

            <div id="veo-cost" style="margin-top:10px;font-size:12px;font-weight:600;padding:8px 10px;background:#fef3c7;border-radius:5px;color:#92400e"></div>
          </div>
          <div style="padding:14px 20px;border-top:1px solid var(--gray-200);display:flex;gap:8px;justify-content:flex-end">
            <button id="veo-cancel" class="btn btn-sm" style="background:var(--gray-200)">Annulla</button>
            <button id="veo-confirm" class="btn btn-sm btn-primary" style="background:linear-gradient(135deg,#f59e0b,#dc2626);border:none">💎 Genera con Veo 3</button>
          </div>
        </div>`;
      document.body.appendChild(overlay);

      const promptTa = overlay.querySelector('#veo-prompt');
      promptTa.value = initialPrompt;
      promptTa.focus();

      const updateCost = () => {
        const dur = parseInt(overlay.querySelector('#veo-dur').value, 10);
        const variant = overlay.querySelector('#veo-variant').value;
        const ratePerSec = variant === 'fast' ? 0.40 : 0.75;
        const cost = (dur * ratePerSec).toFixed(2);
