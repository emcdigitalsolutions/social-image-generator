  // Chiude una richiesta di modifica cliente: può rimandare al cliente (pending)
  // o approvare direttamente (approved) come admin.
  // Usato anche per approvare admin-side post creati dopo l'approvazione mensile
  // (caso d'uso: nuovo post in mese già approved → cliente non lo rivedrà più).
  async function markApplied(newStatus) {
    const wasPending = (POST.approval_status === 'pending');
    const label = newStatus === 'approved' ? 'Approvare direttamente (admin)' : 'Rimandare al cliente (pending)';
    const note = newStatus === 'approved'
      ? (wasPending
          ? 'Il post verrà marcato come APPROVATO. Utile per post creati dopo l\u2019approvazione mensile: senza approvazione il publish guard lo bloccherebbe.'
          : 'Il post verrà marcato come APPROVATO definitivamente, la richiesta di modifica viene chiusa senza ripassare dal cliente.')
      : 'Il post tornerà in stato PENDING: Giuseppe Di Rosa (o altro cliente) lo rivedrà al prossimo accesso al link di approvazione e potrà approvarlo.';
    if (!await showConfirm(label + '?\n\n' + note)) return;
    const comment = newStatus === 'pending'
      ? (prompt('Commento opzionale per tracciare le modifiche (visibile al cliente):', 'Modifiche applicate, rivaluta.') || '')
      : '';
    try {
      const res = await apiFetch('/dashboard/api/approvals/admin/posts/' + POST_ID + '/set-approval', {
        method: 'POST', body: { status: newStatus, comment }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast(newStatus === 'approved' ? 'Post approvato' : 'Inviato al cliente per rivalutazione');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

