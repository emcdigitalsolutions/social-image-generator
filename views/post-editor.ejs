      const updatePreview = () => {
        if (!audioPreview) return;
        const opt = trackSel && trackSel.options[trackSel.selectedIndex];
        const url = opt && opt.dataset ? opt.dataset.url : '';
        if (url) { audioPreview.src = url; audioPreview.load(); }
        else audioPreview.removeAttribute('src');
      };
      if (trackSel) trackSel.onchange = updatePreview;
      updatePreview();

      // Refresh libreria (ri-carica sia globale sia audio del cliente, con data-url)
      overlay.querySelector('#vc-audio-refresh-btn').onclick = async () => {
        try {
          let tracks = [], cAudio = [];
          try { const lib = await apiFetch('/dashboard/api/music'); if (lib && Array.isArray(lib.tracks)) tracks = lib.tracks; } catch (_) {}
          try { const cl = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/library?kind=audio'); if (cl && Array.isArray(cl.items)) cAudio = cl.items; } catch (_) {}
          const cOpts = cAudio.length
            ? '<optgroup label="📚 Libreria del cliente">' + cAudio.map(a => `<option value="client:${a.id}" data-url="${escAttr(a.url)}">${escAttr(a.original_name || a.filename)} (${(a.bytes/1024).toFixed(0)} KB)</option>`).join('') + '</optgroup>'
            : '';
          const gOpts = tracks.length
            ? '<optgroup label="🌐 Libreria globale">' + tracks.map(t => `<option value="${escAttr(t.filename)}" data-url="/music/${encodeURIComponent(t.filename)}">${escAttr(t.filename)} (${(t.bytes/1024).toFixed(0)} KB)</option>`).join('') + '</optgroup>'
            : '';
          trackSel.innerHTML = (cOpts || gOpts) ? cOpts + gOpts : '<option value="">— Nessuna traccia disponibile —</option>';
          updatePreview();
        } catch (e) { console.warn('Refresh libreria fallito', e); }
      };

      // Upload audio
      const uploadInput = overlay.querySelector('#vc-audio-upload-input');
      overlay.querySelector('#vc-audio-upload-btn').onclick = () => uploadInput.click();
      uploadInput.onchange = async () => {
        const f = uploadInput.files[0];
        if (!f) return;
        try {
          const fd = new FormData();
          fd.append('file', f);
          const xhr = await fetch('/dashboard/api/music/upload', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + getToken() },
            body: fd
          });
          const data = await xhr.json();
          if (!xhr.ok) { await showAlert(data.error || 'Upload fallito'); return; }
          // Refresh + seleziona il nuovo file
          overlay.querySelector('#vc-audio-refresh-btn').click();
          setTimeout(() => {
            const opt = [...trackSel.options].find(o => o.value === data.filename);
            if (opt) { trackSel.value = data.filename; updatePreview(); }
          }, 200);
          toast('Caricato ' + data.filename);
        } catch (e) { await showAlert('Upload errore: ' + e.message); }
        uploadInput.value = '';
      };

      // Genera traccia AI
      const aiBtn = overlay.querySelector('#vc-audio-ai-btn');
      if (aiBtn) {
        aiBtn.onclick = async () => {
          const prompt = (overlay.querySelector('#vc-audio-prompt').value || '').trim();
          if (!prompt) { overlay.querySelector('#vc-audio-prompt').focus(); return; }
          const dur = parseInt(overlay.querySelector('#vc-audio-ai-dur').value, 10);
          const status = overlay.querySelector('#vc-audio-ai-status');
          aiBtn.disabled = true;
          status.textContent = 'Generazione (10-30s al cold start)...';
          try {
            const res = await apiFetch('/dashboard/api/music/generate', {
              method: 'POST',
              body: { prompt, duration_sec: dur, model_size: 'small' }
            });
            if (res.error) { status.textContent = 'Errore: ' + res.error; aiBtn.disabled = false; return; }
            status.textContent = '✓ ' + res.filename;
            // Switch a libreria + seleziona il nuovo file
            overlay.querySelector('input[name="vc-audio-mode"][value="library"]').checked = true;
            audioModeChange();
            overlay.querySelector('#vc-audio-refresh-btn').click();
            setTimeout(() => {
              const opt = [...trackSel.options].find(o => o.value === res.filename);
              if (opt) { trackSel.value = res.filename; updatePreview(); }
            }, 200);
          } catch (e) {
            status.textContent = 'Errore: ' + e.message;
          } finally {
            aiBtn.disabled = false;
          }
        };
      }

      const close = (val) => { document.body.removeChild(overlay); resolve(val); };
      overlay.querySelector('#vc-close').onclick = () => close(null);
      overlay.querySelector('#vc-cancel').onclick = () => close(null);
      overlay.querySelector('#vc-confirm').onclick = () => {
        const mode = overlay.querySelector('input[name="vc-audio-mode"]:checked').value;
        let audioFilename = null;
        if (mode === 'library' && trackSel.value) audioFilename = trackSel.value;
        // Se mode === 'ai' senza ancora aver generato, l'utente può comunque
        // cliccare "Genera Reel" e parte senza audio (silenzio).
        close({
          aspect_ratio: overlay.querySelector('#vc-aspect').value,
          num_clips: parseInt(overlay.querySelector('#vc-num').value, 10),
          clip_duration: parseInt(overlay.querySelector('#vc-dur').value, 10),
          audio_filename: audioFilename,
          save_to_library: overlay.querySelector('#vc-save-library').checked
        });
      };
      overlay.addEventListener('click', (e) => { if (e.target === overlay) close(null); });
    });
  }

  async function generateAIVideo() {
    const btn = document.getElementById('gen-aivid-btn');
    // Lock IMMEDIATO: disabilito il bottone PRIMA del modal per impedire che
    // doppi click aprano due modali e quindi due richieste backend (= doppia
    // generazione = doppia spesa Gemini).
    if (btn.disabled) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="loading"></span> Configurazione...';

    const cfg = await aiVideoConfigModal();
    if (!cfg) {
      btn.disabled = false;
      btn.innerHTML = '🎬 Reel AI';
      return;
    }

    btn.innerHTML = '<span class="loading"></span> Generazione Reel...';
    try {
      await saveDetails();
      // Set media_type a 'reel' se ancora 'single_image' (UX: il reel è probabile)
      if (MEDIA_TYPE === 'single_image' && cfg.aspect_ratio === '9:16') {
        MEDIA_TYPE = 'reel';
        await apiFetch('/dashboard/api/posts/' + POST_ID, { method: 'PUT', body: { media_type: 'reel' } });
      }
      const res = await apiFetch('/dashboard/api/posts/' + POST_ID + '/generate-ai-video', {
        method: 'POST',
        body: cfg
      });
      if (res.error) { await showAlert(res.error + (res.details ? '\n' + res.details : '')); return; }
      const mediaRes = await apiFetch('/dashboard/api/posts/' + POST_ID + '/media');
      MEDIA = mediaRes.media || [];
      renderMedia();
      const dur = typeof res.duration_sec === 'number' ? res.duration_sec.toFixed(1) : '?';
      const audioInfo = res.audio ? ' + 🎵 ' + res.audio : '';
      const libInfo = res.library_item ? ' · 💾 in libreria' : '';
      toast('Reel AI generato (' + dur + 's, ' + cfg.num_clips + ' clip' + audioInfo + libInfo + ')');
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '🎬 Reel AI';
    }
  }

