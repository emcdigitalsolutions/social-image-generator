<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — SMM Dashboard</title>
  <link rel="stylesheet" href="/dashboard/css/dashboard.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <link rel="stylesheet" href="/dashboard/css/dashboard-theme.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230f1e4a'/%3E%3Cpath d='M22 30 L42 50 L22 70 M36 30 L56 50 L36 70 M50 30 L70 50 L50 70' stroke='%23d4a574' stroke-width='6' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
  <style>
    /* Login: brand presence sopra la card */
    .login-brand-mark { display:flex; align-items:center; gap:14px; margin-bottom:24px; }
    .login-brand-mark svg { flex:none; }
    .login-brand-mark .lb-name { font-size:18px; font-weight:700; color:#fff; letter-spacing:-0.3px; }
    .login-brand-mark .lb-sub { font-size:11px; color:rgba(255,255,255,0.65); letter-spacing:1px; text-transform:uppercase; margin-top:2px; }
    .login-tagline {
      position:absolute; bottom:30px; left:30px; right:30px;
      text-align:center; color:rgba(255,255,255,0.55); font-size:12px;
      z-index:1; letter-spacing:0.3px;
    }
    .login-tagline strong { color:#d4a574; font-weight:600; }
  </style>
</head>
<body>
  <div class="login-page">
    <div class="login-card">
      <div class="login-brand-mark" style="margin-bottom:8px">
        <svg width="52" height="52" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <linearGradient id="lc-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#0f1e4a"/>
              <stop offset="1" stop-color="#1e3a8a"/>
            </linearGradient>
            <linearGradient id="lc-chev" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#e8c389"/>
              <stop offset="1" stop-color="#b8895d"/>
            </linearGradient>
          </defs>
          <rect width="100" height="100" rx="22" fill="url(#lc-bg)"/>
          <path d="M22 28 L44 50 L22 72 M38 28 L60 50 L38 72 M54 28 L76 50 L54 72"
                stroke="url(#lc-chev)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </div>
      <h1>SMM Dashboard</h1>
      <p>Accedi per gestire i tuoi clienti social media.<br><span style="font-size:12px;color:#94a3b8">EMC Digital Solutions · piattaforma interna</span></p>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>
      <form id="login-form">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required autocomplete="username">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password">
        </div>
        <div id="login-error" class="form-error" style="display:none"></div>
        <button type="submit" class="btn btn-primary btn-block">Accedi</button>
      </form>
    </div>
    <div class="login-tagline">
      Piattaforma per la gestione professionale dei social media · <strong>EMC Digital Solutions</strong>
    </div>
  </div>
  <script>
    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = document.getElementById('login-error');
      errEl.style.display = 'none';

      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;

      try {
        const res = await fetch('/dashboard/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (!res.ok) {
          errEl.textContent = data.error || 'Credenziali non valide';
          errEl.style.display = 'block';
          return;
        }
        localStorage.setItem('dashboard_token', data.token);
        document.cookie = 'dashboard_token=' + data.token + '; path=/; max-age=86400; SameSite=Strict';
        window.location.href = '/dashboard';
      } catch (err) {
        errEl.textContent = 'Errore di connessione';
        errEl.style.display = 'block';
      }
    });
  </script>
</body>
</html>
