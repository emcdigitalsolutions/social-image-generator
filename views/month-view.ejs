    wrap.innerHTML = `
      <div class="modal-card" onclick="event.stopPropagation()">
        <h3>\u{1f550} Imposta orario di pubblicazione</h3>
        <div class="modal-sub">Applica un orario in batch ai post di questo mese.</div>

        <div style="font-size:13px;font-weight:600;margin-bottom:6px">Preset best time (industry data)</div>
        <div class="preset-grid">${presetsHtml}</div>

        <div class="modal-row">
          <label for="tm-input"><strong>Orario:</strong></label>
          <input type="time" id="tm-input" value="14:30">
          <span style="font-size:12px;color:var(--gray-500)">(o digita personalizzato)</span>
        </div>
        <div class="modal-row">
          <label><input type="checkbox" id="tm-only-empty" checked> Applica solo ai post senza orario gi\u00e0 impostato</label>
        </div>

        <div style="font-size:11px;color:var(--gray-500);margin-top:10px">Saranno aggiornati fino a <strong>${totalCount}</strong> post di questo mese.</div>

        <div class="modal-actions">
          <button class="btn btn-sm btn-secondary" onclick="this.closest('.modal-backdrop').remove()">Annulla</button>
          <button class="btn btn-sm btn-primary" onclick="applyBulkTime()">Applica</button>
        </div>
      </div>`;
    document.body.appendChild(wrap);
  }

  async function applyBulkTime() {
    const time = document.getElementById('tm-input').value;
    const onlyEmpty = document.getElementById('tm-only-empty').checked;
    if (!time) { showAlert('Specifica un orario'); return; }
    const targetIds = onlyEmpty
      ? POSTS.filter(p => !p.scheduled_time).map(p => p.id)
      : POSTS.map(p => p.id);
    if (!targetIds.length) {
      showAlert('Tutti i post hanno gi\u00e0 un orario impostato. Deseleziona la checkbox per sovrascrivere.');
      return;
    }
    try {
      const res = await apiFetch('/dashboard/api/posts/bulk-time', {
        method: 'POST',
        body: { post_ids: targetIds, scheduled_time: time, only_unscheduled: onlyEmpty }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast(res.updated + ' post aggiornati con orario ' + time);
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  // ── Date bulk modal (distribuzione intelligente per giorni settimana) ──
  function fmtLocalDate(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }

  function openDateModal() {
    if (!POSTS.length) { showAlert('Nessun post in questo mese.'); return; }
    // Conta i post per settimana per aiutare l'admin a scegliere quanti weekday selezionare
    const byWeek = {};
    POSTS.forEach(p => { const w = p.week_number || 1; byWeek[w] = (byWeek[w] || 0) + 1; });
    const maxPerWeek = Math.max(...Object.values(byWeek), 1);
    const avgPerWeek = (POSTS.length / Math.max(Object.keys(byWeek).length, 1)).toFixed(1);

    const WEEKDAYS = [
      { n: 1, label: 'Lun' }, { n: 2, label: 'Mar' }, { n: 3, label: 'Mer' },
      { n: 4, label: 'Gio' }, { n: 5, label: 'Ven' }, { n: 6, label: 'Sab' }, { n: 7, label: 'Dom' }
    ];
    // Default: scelgo i primi N giorni infrasettimanali in base a maxPerWeek (Lun, Mer, Ven, Mar, Gio, Sab, Dom)
    const defaultOrder = [2, 4, 6, 1, 3, 5, 7]; // Mar, Gio, Sab, poi Lun, Mer, Ven, Dom
    const defaultSelected = new Set(defaultOrder.slice(0, Math.min(maxPerWeek, 7)));

    const wdHtml = WEEKDAYS.map(w =>
      `<label class="wd-chip${defaultSelected.has(w.n) ? ' active' : ''}" data-wd="${w.n}">
        <input type="checkbox" value="${w.n}" ${defaultSelected.has(w.n) ? 'checked' : ''} style="display:none">
        <span>${w.label}</span>
      </label>`
    ).join('');

    const today = new Date();
    const defaultStart = fmtLocalDate(today);

    // Modalità di default: calendar_month se il piano ha start_year_month, altrimenti weeks (legacy)
    const hasCalendar = !!PLAN_START_YM;
    const defaultMode = hasCalendar ? 'calendar_month' : 'weeks';
    const calLabelLine = hasCalendar && CAL_MONTH_LABEL
      ? `<div style="font-size:12px;color:var(--gray-600);margin-top:4px">📅 Mese calendario: <strong>${CAL_MONTH_LABEL}</strong></div>`
      : '';

    const wrap = document.createElement('div');
    wrap.className = 'modal-backdrop';
    wrap.onclick = (e) => { if (e.target === wrap) wrap.remove(); };
    wrap.innerHTML = `
      <div class="modal-card" onclick="event.stopPropagation()" style="max-width:560px">
        <h3>\u{1f4c5} Distribuisci date nel mese</h3>
        <div class="modal-sub">
          Ci sono <strong>${POSTS.length}</strong> post in ${Object.keys(byWeek).length} settimane (media ${avgPerWeek}/settimana, max ${maxPerWeek}/settimana).
        </div>

        <div style="font-size:13px;font-weight:600;margin:12px 0 6px">Modalità distribuzione</div>
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:10px;font-size:13px">
          <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer">
            <input type="radio" name="dm-mode" value="calendar_month" ${defaultMode === 'calendar_month' ? 'checked' : ''} ${hasCalendar ? '' : 'disabled'} onchange="toggleDistributeMode()">
            <span>
              <strong>Mese calendario</strong> ${hasCalendar ? '(consigliato)' : '<em>— richiede mese di partenza impostato sul piano</em>'}
              <div style="font-size:11px;color:var(--gray-500);font-weight:400">I post finiscono solo nei giorni del mese calendario. Nessun cavallo tra mesi.</div>
              ${calLabelLine}
            </span>
          </label>
          <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer">
            <input type="radio" name="dm-mode" value="weeks" ${defaultMode === 'weeks' ? 'checked' : ''} onchange="toggleDistributeMode()">
            <span>
              <strong>4 settimane consecutive</strong> (legacy)
              <div style="font-size:11px;color:var(--gray-500);font-weight:400">Distribuisce a partire da una data fissa: l'ultima settimana può sforare nel mese successivo.</div>
            </span>
          </label>
        </div>

        <div class="modal-row" id="dm-start-row">
          <label for="dm-start"><strong>Data di partenza:</strong></label>
          <input type="date" id="dm-start" value="${defaultStart}">
          <span style="font-size:12px;color:var(--gray-500)">Il lunedì di questa settimana segna la <em>Settimana 1</em></span>
        </div>

        <div style="font-size:13px;font-weight:600;margin:12px 0 6px">Giorni settimanali consentiti</div>
        <div style="font-size:11px;color:var(--gray-500);margin-bottom:8px">Seleziona almeno <strong>${maxPerWeek}</strong> giorni (tanti quanti i post della settimana più piena)</div>
        <div id="dm-weekdays" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">${wdHtml}</div>

        <div class="modal-row">
          <label><input type="checkbox" id="dm-only-empty" checked> Applica solo ai post senza data già impostata</label>
        </div>

        <div class="modal-actions" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
          <button class="btn btn-sm" style="background:#fee2e2;color:#991b1b;border-color:#fca5a5" onclick="clearDistributedDates()" title="Cancella tutte le scheduled_date dei post del mese (eccetto quelli già pubblicati). Utile per ridistribuire da zero.">🗑 Cancella date del mese</button>
          <div style="display:flex;gap:8px">
            <button class="btn btn-sm btn-secondary" onclick="this.closest('.modal-backdrop').remove()">Annulla</button>
            <button class="btn btn-sm btn-primary" onclick="applyBulkDistributeDates()">Distribuisci</button>
          </div>
        </div>
      </div>`;
    document.body.appendChild(wrap);

    // Toggle chip weekday
    wrap.querySelectorAll('.wd-chip').forEach(chip => {
      chip.addEventListener('click', (ev) => {
        ev.preventDefault();
        const cb = chip.querySelector('input');
        cb.checked = !cb.checked;
        chip.classList.toggle('active', cb.checked);
      });
    });
    // Inizializza visibilità riga start_date in base al default
    toggleDistributeMode();
  }

  function toggleDistributeMode() {
    const sel = document.querySelector('input[name="dm-mode"]:checked');
    if (!sel) return;
    const startRow = document.getElementById('dm-start-row');
    if (startRow) startRow.style.display = sel.value === 'calendar_month' ? 'none' : '';
  }

  async function clearDistributedDates() {
    if (!await showConfirm('Cancellare tutte le date di pubblicazione dei post di questo mese? I post pubblicati restano invariati.')) return;
    try {
      const res = await apiFetch('/dashboard/api/posts/bulk-clear-dates', {
        method: 'POST',
        body: { plan_id: PLAN_ID, month: MONTH }
      });
      if (res.error) { await showAlert(res.error); return; }
      toast(res.cleared + ' date cancellate');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function applyBulkDistributeDates() {
    const modeEl = document.querySelector('input[name="dm-mode"]:checked');
    const mode = modeEl ? modeEl.value : 'weeks';
    const onlyEmpty = document.getElementById('dm-only-empty').checked;
    const weekdays = Array.from(document.querySelectorAll('#dm-weekdays input:checked')).map(i => parseInt(i.value, 10));
    if (!weekdays.length) { showAlert('Seleziona almeno un giorno della settimana.'); return; }
    const body = { plan_id: PLAN_ID, month: MONTH, weekdays, only_unscheduled: onlyEmpty, mode };
    if (mode === 'weeks') {
      const startDate = document.getElementById('dm-start').value;
      if (!startDate) { showAlert('Specifica una data di partenza'); return; }
      body.start_date = startDate;
    }
    try {
      const res = await apiFetch('/dashboard/api/posts/bulk-distribute-dates', { method: 'POST', body });
      if (res.error) { await showAlert(res.error); return; }
      const suffix = res.calendar_month ? ` (${res.calendar_month})` : '';
      toast(res.updated + ' post distribuiti su ' + weekdays.length + ' giorni settimanali' + suffix);
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function deletePost(postId, ev) {
    if (ev) { ev.preventDefault(); ev.stopPropagation(); }
    if (!await showConfirm('Eliminare definitivamente questo post? L\u2019operazione non si pu\u00f2 annullare.')) return;
    try {
      const res = await apiFetch('/dashboard/api/posts/' + postId, { method: 'DELETE' });
      if (res.error) {
        // Caso speciale: post pubblicato, blocco lato server con messaggio specifico.
        // Mostriamo un alert più visibile (il messaggio è già verbose dal backend).
        await showAlert(res.error);
        return;
      }
      toast('Post eliminato');
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }
</script>

<%- include('layout-end') %>
