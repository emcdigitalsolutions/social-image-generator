    try {
      const created = await apiFetch('/dashboard/api/posts', {
        method: 'POST',
        body: {
          client_id: CLIENT_ID,
          editorial_plan_id: PLAN_ID,
          month_number: MONTH,
          week_number: weekNumber,
          category: cat || null,
          sub_topic: sub,
          media_type: mt,
          scheduled_date: iso,
          scheduled_time: time || null
