<%- include('layout', { title, user }) %>

<style>
  .view-toggle { display:inline-flex; border:1px solid var(--gray-200); border-radius:6px; overflow:hidden; }
  .view-toggle button { background:white; border:0; padding:6px 14px; font-size:13px; cursor:pointer; color:var(--gray-500); }
  .view-toggle button.active { background:var(--blue); color:white; }
  .filter-chips { display:flex; gap:6px; flex-wrap:wrap; margin:16px 0; align-items:center; }
  .filter-chips .label { font-size:12px; color:var(--gray-500); margin-right:4px; }
  .chip { padding:4px 10px; font-size:12px; border-radius:12px; border:1px solid var(--gray-200); background:white; cursor:pointer; user-select:none; }
  .chip.active { background:var(--blue); color:white; border-color:var(--blue); }
  .chip .count { opacity:0.7; margin-left:4px; }

  .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:6px; margin-top:8px; }
  .cal-head { font-size:11px; font-weight:600; color:var(--gray-500); text-transform:uppercase; padding:4px 6px; }
  .cal-cell { min-height:110px; border:1px solid var(--gray-200); border-radius:6px; padding:6px; background:white; display:flex; flex-direction:column; gap:4px; cursor:pointer; transition:background .12s, border-color .12s; }
  .cal-cell:hover { background:#f8fafc; border-color:var(--blue); }
  .cal-cell.empty { background:var(--gray-50); border-style:dashed; }
  .cal-cell.empty:hover { background:#eff6ff; }
  .cal-cell .day { font-size:11px; color:var(--gray-400); font-weight:600; }
  .cal-cell.today .day { color:var(--blue); }
  .cal-cell .day-row { display:flex; justify-content:space-between; align-items:center; gap:4px; }
  .cal-cell .day-add { background:none; border:1px solid var(--gray-200); color:var(--gray-400); font-size:11px; line-height:1; padding:1px 5px; border-radius:3px; cursor:pointer; opacity:0; transition:opacity .15s, color .15s, border-color .15s; font-weight:600; }
  .cal-cell:hover .day-add { opacity:1; }
  .cal-cell .day-add:hover { color:var(--blue); border-color:var(--blue); }
  .cal-post { display:block; padding:4px 6px; border-radius:4px; font-size:11px; line-height:1.3; text-decoration:none; border-left:3px solid; background:var(--gray-50); color:var(--gray-700); }
  .cal-post:hover { background:var(--gray-100); }
  .cal-post.s-draft           { border-left-color:#9ca3af; }
  .cal-post.s-caption_generated,
  .cal-post.s-image_generated { border-left-color:#3b82f6; }
  .cal-post.s-ready           { border-left-color:#10b981; }
  .cal-post.s-published       { border-left-color:#059669; background:#ecfdf5; }
  .cal-post.s-failed          { border-left-color:#dc2626; background:#fef2f2; }

  .unscheduled-bar { margin-top:24px; padding:12px; background:#fef9c3; border:1px solid #fde047; border-radius:6px; font-size:13px; }

  /* Drag & drop tra settimane e riordino interno */
  .post-card[draggable="true"] { cursor:grab; }
  .post-card[draggable="true"]:active { cursor:grabbing; }
  .post-card.dragging { opacity:0.3; }
  .week-group.drop-target > .posts-grid { outline:2px dashed var(--blue); outline-offset:4px; border-radius:8px; background:#eff6ff; }
  .post-card.drop-before { box-shadow:-4px 0 0 0 var(--blue); }
  .post-card.drop-after  { box-shadow: 4px 0 0 0 var(--blue); }
  .drag-hint { font-size:11px; color:var(--gray-400); font-weight:400; margin-left:8px; }

  /* Menu azioni avanzate */
  .adv-dropdown {
    display:none; position:absolute; top:calc(100% + 4px); right:0; min-width:260px;
    background:white; border:1px solid var(--gray-200); border-radius:6px;
    box-shadow:0 6px 18px rgba(0,0,0,.12); padding:4px; z-index:50;
  }
  .adv-dropdown.open { display:block; }
  .adv-dropdown button {
    display:block; width:100%; text-align:left; padding:8px 12px; font-size:13px;
    background:none; border:0; cursor:pointer; border-radius:4px; color:var(--gray-700);
  }
  .adv-dropdown button:hover { background:var(--gray-50); color:var(--blue); }

  /* Marcatori immagini fuori range Instagram */
  .cal-post.bad-ratio, #view-list .post-card.bad-ratio { box-shadow: inset 4px 0 0 #dc2626; }
  #view-list .post-card.bad-ratio { outline: 2px solid #dc2626; outline-offset: -2px; }
  .ratio-card-badge { display:inline-block; font-size:9px; font-weight:700; padding:1px 5px; border-radius:3px; margin-left:4px; vertical-align:middle; background:#dc2626; color:white; letter-spacing:0.3px; }

  /* Marcatori approvazione cliente (Giuseppe Di Rosa ecc.) */
  .cal-post.ap-change_requested, #view-list .post-card.ap-change_requested { box-shadow: inset 4px 0 0 #d97706; background:#fffbeb; }
  .cal-post.ap-rejected, #view-list .post-card.ap-rejected { box-shadow: inset 4px 0 0 #dc2626; background:#fef2f2; }
  .cal-post.ap-approved, #view-list .post-card.ap-approved { box-shadow: inset 4px 0 0 #16a34a; }
  .ap-badge { display:inline-block; font-size:9px; font-weight:700; padding:1px 5px; border-radius:3px; margin-left:4px; vertical-align:middle; }
  .ap-badge.ap-change_requested { background:#fef3c7; color:#92400e; }
  .ap-badge.ap-rejected { background:#fee2e2; color:#991b1b; }
  .ap-badge.ap-approved { background:#dcfce7; color:#14532d; }
  .client-comment {
    background:#fef3c7; border-left:3px solid #d97706; padding:6px 8px; margin:4px 0 0;
    font-size:10.5px; color:#92400e; border-radius:0 4px 4px 0; font-style:italic; line-height:1.35;
    max-height:60px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical;
  }
  .client-comment::before { content:'✏️ '; font-style:normal; }

  /* Card compatte nella vista lista (override del globale .post-card) */
  #view-list .posts-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(210px, 1fr)); gap:10px; }
  #view-list .post-card { border-radius:6px; }
  #view-list .post-card-image { height:110px; }
  #view-list .post-card-body { padding:8px 10px; }
  #view-list .post-card-body h4 { font-size:12px; font-weight:600; margin-bottom:3px; line-height:1.25; }
  #view-list .post-card-body p { font-size:11px; margin-bottom:5px; -webkit-line-clamp:2; }
  #view-list .post-card-body .post-card-footer { margin-top:2px; }
  #view-list .post-card .badge { font-size:10px; padding:1px 6px; }
  #view-list .post-card .cat-code { display:inline-block; background:var(--gray-100); color:var(--gray-600); font-size:9px; font-weight:700; padding:1px 5px; border-radius:3px; margin-right:4px; vertical-align:middle; }

  /* ── Vista TABELLA: editor caption inline rapido ── */
  #view-table table { width:100%; border-collapse:separate; border-spacing:0; background:white; border:1px solid var(--gray-200); border-radius:8px; overflow:hidden; font-size:13px; }
  #view-table th { background:var(--gray-50); text-align:left; padding:10px 12px; font-size:11px; font-weight:600; color:var(--gray-600); text-transform:uppercase; letter-spacing:0.4px; border-bottom:1px solid var(--gray-200); position:sticky; top:0; z-index:3; }
  #view-table td { padding:10px 12px; border-bottom:1px solid var(--gray-100); vertical-align:top; }
  #view-table tr:last-child td { border-bottom:0; }
  #view-table tr.dirty td { background:#fef9c3; }
  #view-table tr.saved td { background:#ecfdf5; transition:background 1.5s; }
  #view-table tr.has-changes td { background:#fffbeb; }
  #view-table .col-week { width:60px; color:var(--gray-500); font-weight:600; text-align:center; }
  #view-table .col-cat { width:140px; }
  #view-table .col-cat .cat-pill { display:inline-block; background:var(--gray-100); color:var(--gray-700); padding:2px 6px; border-radius:3px; font-size:10px; font-weight:700; margin-bottom:2px; }
  #view-table .col-cat .cat-name { font-size:11px; color:var(--gray-500); }
  #view-table .col-cat .sub { font-size:11px; color:var(--gray-700); margin-top:2px; line-height:1.3; }
  #view-table .col-status { width:90px; }
  #view-table .col-status .badge { font-size:10px; }
  #view-table .col-caption { min-width:380px; }
  #view-table .col-caption textarea { width:100%; min-height:90px; padding:8px 10px; font-family:inherit; font-size:12.5px; line-height:1.45; border:1px solid var(--gray-200); border-radius:5px; resize:vertical; box-sizing:border-box; background:white; transition:border-color 0.15s; }
  #view-table .col-caption textarea:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 2px rgba(37,99,235,0.1); }
  #view-table .col-caption .empty-cap { color:var(--gray-400); font-style:italic; font-size:12px; padding:6px 0; }
  #view-table .col-actions { width:140px; text-align:right; white-space:nowrap; }
  #view-table .col-actions .btn { font-size:11px; padding:4px 8px; }
  #view-table .col-actions .save-status { font-size:10px; color:var(--gray-400); margin-top:4px; }
  #view-table .col-actions .save-status.error { color:var(--red); }
  #view-table .col-actions .save-status.saved { color:var(--green); }
  #view-table .week-sep { background:var(--gray-50); }
  #view-table .week-sep td { padding:6px 12px; font-size:11px; font-weight:700; color:var(--gray-500); text-transform:uppercase; letter-spacing:0.5px; }
  #view-table-toolbar { margin-bottom:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  #view-table-toolbar .help { font-size:11px; color:var(--gray-500); flex:1; }

  /* Ghost pulito da usare come drag image (rimpiazza screenshot default brutto) */
  .drag-ghost {
    position:absolute; top:-9999px; left:-9999px;
    padding:8px 14px; background:white; border:1px solid var(--blue);
    border-radius:6px; box-shadow:0 6px 18px rgba(0,0,0,.18);
    font-size:12px; font-weight:600; color:var(--gray-800);
    display:flex; align-items:center; gap:8px; max-width:240px;
    pointer-events:none;
  }
  .drag-ghost .dg-icon { font-size:14px; }
  .drag-ghost .dg-text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  /* Chip selezione giorni settimana (modal distribuzione date) */
  .wd-chip {
    display:inline-flex; align-items:center; justify-content:center;
    min-width:44px; padding:6px 12px; font-size:12px; font-weight:600;
    border:1px solid var(--gray-200); border-radius:20px; background:white;
    cursor:pointer; user-select:none; color:var(--gray-600);
  }
  .wd-chip:hover { border-color:var(--blue); color:var(--blue); }
  .wd-chip.active { background:var(--blue); color:white; border-color:var(--blue); }

  /* Time modal */
  .modal-backdrop { position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:1000; display:flex; align-items:center; justify-content:center; }
  .modal-card { background:white; border-radius:10px; max-width:500px; width:92vw; max-height:90vh; overflow:auto; padding:22px 24px; }
  .modal-card h3 { margin:0 0 4px; font-size:17px; }
  .modal-card .modal-sub { font-size:12px; color:var(--gray-500); margin-bottom:18px; }
  .preset-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; margin-bottom:14px; }
  .preset-btn { display:flex; flex-direction:column; gap:2px; padding:10px 8px; border:1px solid var(--gray-200); border-radius:6px; background:white; cursor:pointer; font-size:12px; text-align:center; }
  .preset-btn:hover { border-color:var(--blue); background:#eff6ff; }
  .preset-btn .ico { font-size:18px; }
  .preset-btn .time { font-weight:700; font-size:14px; color:var(--gray-800); }
  .preset-btn .lab { color:var(--gray-500); }
  .modal-row { display:flex; gap:10px; align-items:center; margin-bottom:10px; }
  .modal-row input[type=time] { padding:6px 10px; font-size:14px; border:1px solid var(--gray-200); border-radius:5px; }
  .modal-row label { font-size:13px; cursor:pointer; }
  .modal-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:18px; }
</style>

<% const calCurrent = resolveCalendarMonth(month, plan.start_year_month); %>
<div class="breadcrumb">
  <a href="/dashboard">Clienti</a> /
  <a href="/dashboard/clients/<%= client.id %>"><%= client.display_name %></a> /
  <a href="/dashboard/clients/<%= client.id %>/plan/<%= plan.id %>">Piano</a> /
  <%= calCurrent ? `Mese ${month} · ${calCurrent.label}` : `Mese ${month}` %>
</div>

<div class="page-header">
  <h1>
    Mese <%= month %>
    <% if (calCurrent) { %><span style="color:var(--gray-500);font-weight:500;font-size:0.7em">· <%= calCurrent.label %></span><% } %>
    — <%= client.display_name %>
  </h1>
  <div style="display:flex;gap:8px;align-items:center">
    <% if (schedule && schedule.is_active) { %>
      <span class="badge badge-active" title="L'auto-publish è attivo per questo mese: i post con stato 'ready' verranno pubblicati alla loro scheduled_date">Schedule attivo</span>
    <% } %>
  </div>
</div>

<% if (!plan.start_year_month) { %>
  <div style="margin-bottom:12px;padding:10px 14px;background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px">
    <span>📅 <strong>Mese calendario non impostato</strong> per questo piano (Mese 1 = ?). Imposta il mese di partenza per orientarti meglio.</span>
    <a href="/dashboard/clients/<%= client.id %>/plan/<%= plan.id %>" class="btn btn-sm btn-primary" style="padding:3px 10px;font-size:12px;text-decoration:none">Vai al piano per impostarlo →</a>
  </div>
<% } %>

<div class="month-buttons" style="margin-bottom:16px">
  <% const totalMonths = (plan.plan_data && plan.plan_data.months) ? plan.plan_data.months.length : (client.editorial_months || 6); %>
  <% for (let m = 1; m <= totalMonths; m++) {
       const calM = resolveCalendarMonth(m, plan.start_year_month);
     %>
    <a href="/dashboard/clients/<%= client.id %>/plan/<%= plan.id %>/month/<%= m %>"
       class="month-btn <%= m === month ? 'active' : '' %>"
       title="<%= calM ? calM.label : ('Mese ' + m) %>">Mese <%= m %><% if (calM) { %> <span style="opacity:.65;font-size:.85em">· <%= calM.short %></span><% } %></a>
  <% } %>
</div>

<div class="actions-bar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
  <button class="btn btn-secondary btn-sm" onclick="openDateModal()" title="Distribuisce in massa le date di pubblicazione sui giorni della settimana scelti. Da qui puoi anche cancellare e ridistribuire le date del mese.">&#x1f4c5; Distribuisci date</button>
  <button class="btn btn-secondary btn-sm" onclick="bulkGenerate('caption')" title="Genera la caption AI per tutti i post draft del mese">✨ Genera tutte le caption</button>
  <button class="btn btn-secondary btn-sm" onclick="bulkGenerate('image')" title="Renderizza l'immagine per tutti i post che hanno una caption">✨ Genera tutte le immagini</button>
  <button class="btn btn-secondary btn-sm" onclick="bulkGenerate('both')" title="Genera caption + immagine per tutti i post del mese">✨ Genera caption + immagini</button>
  <button class="btn btn-secondary btn-sm" onclick="openTimeModal()" title="Imposta in massa l'orario di pubblicazione (best time per FB / IG)">&#x1f550; Orario default</button>
  <% if (!schedule || !schedule.is_active) { %>
    <button class="btn btn-primary btn-sm" onclick="goLiveMonth()" title="Avvia tutto in sequenza: segna pronti i post validi, approva come admin, attiva l'auto-publish.">&#9654; Avvia pubblicazione mese</button>
  <% } %>
  <div class="adv-menu" style="position:relative;display:inline-block">
    <button class="btn btn-secondary btn-sm" onclick="document.getElementById('adv-dropdown').classList.toggle('open')" title="Azioni singole per controllo fine">▾ Azioni avanzate</button>
    <div id="adv-dropdown" class="adv-dropdown">
      <button onclick="bulkReady();closeAdv()" title="STEP 1 di 3 — Cambia lo status di tutti i post validi da 'draft' a 'ready'. Un post è 'valido' se ha caption + almeno un media + proporzioni immagine adatte a Instagram. I post incompleti vengono saltati con il motivo specifico (manca caption / nessun media / ratio fuori range IG). Da solo NON pubblica: serve anche approvare e attivare lo schedule.">
        &#9654; Step 1 — Segna pronti
      </button>
      <button onclick="approveAllAsAdmin();closeAdv()" title="STEP 2 di 3 — Imposta 'approval_status=approved' su tutti i post del mese. Scavalca il link di approvazione cliente: utile quando gestisci in autonomia o quando il cliente non risponde. Se non hai mai creato un link approvazione per il mese, questo step è tecnicamente non necessario (il guard è trasparente) ma non fa danni.">
        &#10003; Step 2 — Approva mese (admin)
      </button>
      <% if (!schedule || !schedule.is_active) { %>
        <button onclick="confirmMonth();closeAdv()" title="STEP 3 di 3 — Attiva il flag 'schedule.is_active=1' per il mese. Solo dopo questo step il cron ogni 60s comincia a cercare post pubblicabili. Senza questo step, i post possono anche essere 'ready' ma il sistema non li tocca. Una volta attivato, resta acceso finché non clicchi 'Disattiva'.">
          &#128337; Step 3 — Attiva auto-publish
        </button>
      <% } %>
    </div>
  </div>
  <div style="flex:1"></div>
  <div class="view-toggle" role="tablist">
    <button id="vt-cal"   class="active" onclick="setView('cal')">Calendario</button>
    <button id="vt-list"             onclick="setView('list')">Lista</button>
    <button id="vt-table"            onclick="setView('table')" title="Editor caption tabellare per modifiche rapide">Tabella</button>
  </div>
</div>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <h3>Nessun post per questo mese</h3>
    <button class="btn btn-primary" onclick="addPost(1)" style="margin-top:12px">+ Aggiungi primo post</button>
  </div>
<% } else { %>

  <div class="filter-chips">
    <span class="label">Filtra:</span>
    <span class="chip active" data-filter="all">Tutti <span class="count" id="cnt-all"></span></span>
    <span class="chip" data-filter="todo">Da generare <span class="count" id="cnt-todo"></span></span>
    <span class="chip" data-filter="ready">Pronti <span class="count" id="cnt-ready"></span></span>
    <span class="chip" data-filter="published">Pubblicati <span class="count" id="cnt-published"></span></span>
    <span class="chip" data-filter="failed">Falliti <span class="count" id="cnt-failed"></span></span>
    <span class="chip" data-filter="changes" id="chip-changes" style="border-color:#d97706;color:#92400e;display:none">✏️ Da rivedere (cliente) <span class="count" id="cnt-changes"></span></span>
    <span class="chip" data-filter="ratio" id="chip-ratio" style="border-color:#dc2626;color:#991b1b;display:none">⚠️ Immagini da ricroppare <span class="count" id="cnt-ratio"></span></span>
  </div>

  <div id="view-cal"></div>
  <div id="view-list" style="display:none"></div>
  <div id="view-table" style="display:none"></div>

  <div id="unscheduled" class="unscheduled-bar" style="display:none">
    <strong id="unscheduled-count">0</strong> post senza data programmata. <a href="#" onclick="setView('list');return false">Vedi nella lista</a> e imposta una <em>scheduled_date</em>.
  </div>
<% } %>

<script>
  const PLAN_ID = '<%= plan.id %>';
  const CLIENT_ID = '<%= client.id %>';
  const MONTH = <%= month %>;
  const PLAN_START_YM = <%- JSON.stringify(plan.start_year_month || null) %>;
  const CAL_MONTH_LABEL = <%- JSON.stringify((calCurrent && calCurrent.label) || null) %>;
  const POSTS = <%- JSON.stringify(posts) %>;
  const POST_IDS = POSTS.map(p => p.id);
  // Mappa code → nome leggibile categoria (da plan.plan_data.categories)
  const CATEGORIES_MAP = <%- JSON.stringify(categoriesMap || {}) %>;
  // Lista ordinata categorie per dropdown selezione (code + name)
  const CATEGORIES_LIST = <%- JSON.stringify(
    (plan.plan_data && Array.isArray(plan.plan_data.categories))
      ? plan.plan_data.categories.filter(c => c && c.code).map(c => ({ code: c.code, name: c.name || c.code }))
      : []
  ) %>;
  function categoryName(code) {
    if (!code) return 'Post';
    return CATEGORIES_MAP[code] || code;
  }
  // Costruisce le <option> per un select categoria. Se currentCode è presente
  // ma non esiste più nel piano, lo aggiunge come "(orfana)" selezionato.
  function categorySelectOptions(currentCode) {
    const escAttr = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]));
    let html = '<option value="">— Senza categoria —</option>';
    let foundCurrent = false;
    CATEGORIES_LIST.forEach(c => {
      const sel = c.code === currentCode ? 'selected' : '';
      if (sel) foundCurrent = true;
      html += `<option value="${escAttr(c.code)}" ${sel}>${escAttr(c.name)}</option>`;
    });
    if (currentCode && !foundCurrent) {
      html += `<option value="${escAttr(currentCode)}" selected>${escAttr(currentCode)} (orfana)</option>`;
    }
    return html;
  }

  // Filtro stato corrente
  let activeFilter = 'all';

  // Categoria di stato per filtri
  function bucket(status) {
    if (status === 'published') return 'published';
    if (status === 'failed')    return 'failed';
    if (status === 'ready')     return 'ready';
    return 'todo'; // draft, caption_generated, image_generated, ecc.
  }

  function matchesFilter(post) {
    if (activeFilter === 'all') return true;
    if (activeFilter === 'changes') return post.approval_status === 'change_requested' || post.approval_status === 'rejected';
    if (activeFilter === 'ratio') return !!post.has_bad_ratio;
    return bucket(post.status) === activeFilter;
  }

  // Aggiorna i conteggi sulle chip
  function updateCounts() {
    const counts = { all: POSTS.length, todo: 0, ready: 0, published: 0, failed: 0, changes: 0, ratio: 0 };
    POSTS.forEach(p => {
      counts[bucket(p.status)]++;
      if (p.approval_status === 'change_requested' || p.approval_status === 'rejected') counts.changes++;
      if (p.has_bad_ratio) counts.ratio++;
    });
    Object.entries(counts).forEach(([k, v]) => {
      const el = document.getElementById('cnt-' + k);
      if (el) el.textContent = v ? '(' + v + ')' : '';
    });
    // La chip "Da rivedere (cliente)" è inutile se non ci sono richieste: nascondila.
    const chipChanges = document.getElementById('chip-changes');
    if (chipChanges) {
      chipChanges.style.display = counts.changes > 0 ? '' : 'none';
      // Se l'utente era sul filtro 'changes' e ora è vuoto, torna a 'all'
      if (counts.changes === 0 && activeFilter === 'changes') setFilter('all');
    }
    const chipRatio = document.getElementById('chip-ratio');
    if (chipRatio) {
      chipRatio.style.display = counts.ratio > 0 ? '' : 'none';
      if (counts.ratio === 0 && activeFilter === 'ratio') setFilter('all');
    }
  }

  function setFilter(f) {
    activeFilter = f;
    document.querySelectorAll('.chip').forEach(c => c.classList.toggle('active', c.dataset.filter === f));
    renderViews();
  }

  // Calcola range di date dei post del mese (basato su scheduled_date)
  function dateRange() {
    const dates = POSTS.map(p => p.scheduled_date).filter(Boolean).sort();
    if (!dates.length) return null;
    return { min: dates[0], max: dates[dates.length - 1] };
  }

  function parseDate(s) { const [y,m,d] = s.split('-').map(Number); return new Date(y, m-1, d); }
  function fmtIso(d) { return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }

  // Renderizza vista calendario
  function renderCalendar() {
    const root = document.getElementById('view-cal');
    if (!root) return;
    const range = dateRange();
    if (!range) {
      root.innerHTML = '<div class="empty-state"><h3>Nessun post ha una data programmata</h3><p>Imposta una <em>scheduled_date</em> da ciascun post per vederlo nel calendario.</p></div>';
      return;
    }
    // Allarga al lunedì precedente / domenica successiva
    const start = parseDate(range.min);
    while (start.getDay() !== 1) start.setDate(start.getDate() - 1); // lunedì = 1
    const end = parseDate(range.max);
    while (end.getDay() !== 0) end.setDate(end.getDate() + 1);       // domenica = 0

    const today = fmtIso(new Date());
    const byDate = {};
    POSTS.filter(matchesFilter).forEach(p => {
      if (!p.scheduled_date) return;
      (byDate[p.scheduled_date] = byDate[p.scheduled_date] || []).push(p);
    });

    let html = '';
    const dayNames = ['Lun','Mar','Mer','Gio','Ven','Sab','Dom'];
    dayNames.forEach(n => html += '<div class="cal-head">' + n + '</div>');

    for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
      const iso = fmtIso(d);
      const dayPosts = byDate[iso] || [];
      const cls = ['cal-cell'];
      if (!dayPosts.length) cls.push('empty');
      if (iso === today) cls.push('today');
      html += '<div class="' + cls.join(' ') + '" onclick="addPostForDate(\'' + iso + '\')" title="Clicca per aggiungere un post in questo giorno">';
      html += '<div class="day-row"><span class="day">' + d.getDate() + '</span>'
           +  '<button class="day-add" onclick="event.stopPropagation();addPostForDate(\'' + iso + '\')" title="Aggiungi un post in questo giorno">+</button></div>';
      dayPosts.forEach(p => {
        const label = categoryName(p.category) + (p.scheduled_time ? ' · ' + p.scheduled_time.slice(0,5) : '');
        let titleAttr = p.sub_topic || p.status;
        if (p.last_client_comment) titleAttr += '\n\n✏️ Cliente: ' + p.last_client_comment;
        if (p.has_bad_ratio) titleAttr += '\n\n⚠️ Immagine da ricroppare: ' + (p.bad_ratio_detail || 'fuori range IG');
        const apClass = p.approval_status ? ' ap-' + p.approval_status : '';
        const ratioClass = p.has_bad_ratio ? ' bad-ratio' : '';
        // stopPropagation: il click sul link non deve aprire anche il modal "nuovo post"
        html += '<a href="/dashboard/posts/' + p.id + '" onclick="event.stopPropagation()" class="cal-post s-' + p.status + apClass + ratioClass + '" title="' + escapeHtml(titleAttr) + '">' + escapeHtml(label) + '</a>';
      });
      html += '</div>';
    }
    root.innerHTML = '<div class="cal-grid">' + html + '</div>';

    // Avviso post non schedulati
    const noDate = POSTS.filter(matchesFilter).filter(p => !p.scheduled_date).length;
    const bar = document.getElementById('unscheduled');
    if (noDate > 0) {
      document.getElementById('unscheduled-count').textContent = noDate;
      bar.style.display = 'block';
    } else {
      bar.style.display = 'none';
    }
  }

  // Renderizza vista lista per settimana (storica).
  // Mostra sempre le settimane 1..maxWeek così il drop target esiste anche per settimane vuote.
  function renderList() {
    const root = document.getElementById('view-list');
    if (!root) return;
    const visible = POSTS.filter(matchesFilter);
    if (!POSTS.length) { root.innerHTML = '<div class="empty-state"><h3>Nessun post in questo mese</h3></div>'; return; }
    const weeks = {};
    visible.forEach(p => { const w = p.week_number || 1; (weeks[w] = weeks[w] || []).push(p); });
    // Ordina ogni settimana per position (stabile, con fallback scheduled_date/id)
    Object.keys(weeks).forEach(k => weeks[k].sort(byWeekPosOrder));
    // Max week: o la più alta presente nei post (anche non filtrati) o 4 (default mese di 4 settimane)
    const maxWeekInPosts = POSTS.reduce((acc, p) => Math.max(acc, p.week_number || 1), 1);
    const maxWeek = Math.max(4, maxWeekInPosts);
    let html = '';
    const TYPE_LABEL = {
      single_image: '\ud83d\uddbc Singola',
      carousel:     '\ud83c\udfa0 Carousel',
      reel:         '\ud83c\udfac Reel',
      video:        '\ud83c\udfac Video',
      story:        '\u2728 Storia (cliente)'
    };
    for (let wn = 1; wn <= maxWeek; wn++) {
      const weekPosts = weeks[wn] || [];
      html += '<div class="week-group" data-week="' + wn + '"><h3 style="display:flex;align-items:center;justify-content:space-between;gap:8px">Settimana ' + wn
        + '<span><span class="drag-hint">trascina i post per cambiare settimana</span>'
        + '<button class="btn btn-sm btn-secondary" onclick="addPost(' + wn + ')" title="Aggiungi un post draft a questa settimana" style="margin-left:8px">+ Nuovo post</button></span>'
        + '</h3><div class="posts-grid">';
      if (!weekPosts.length) {
        html += '<div style="grid-column:1/-1;padding:20px;text-align:center;color:var(--gray-400);font-size:12px;border:1px dashed var(--gray-200);border-radius:6px">Nessun post in questa settimana (puoi trascinarne uno qui)</div>';
      }
      weekPosts.forEach(p => {
        const mt = p.media_type || 'single_image';
        const typeBadge = TYPE_LABEL[mt] || mt;
        let schedLine = '';
        const t = p.scheduled_time ? p.scheduled_time.slice(0,5) : '';
        if (p.scheduled_date && t) {
          schedLine = '<p style="font-size:11px;color:var(--blue);margin:3px 0 4px;font-weight:500">\ud83d\udcc5 ' + escapeHtml(p.scheduled_date) + ' \u00b7 ' + escapeHtml(t) + '</p>';
        } else if (p.scheduled_date) {
          schedLine = '<p style="font-size:11px;color:var(--blue);margin:3px 0 4px;font-weight:500">\ud83d\udcc5 ' + escapeHtml(p.scheduled_date) + '</p>';
        } else if (t) {
          // Solo orario (es. cadenza settimanale del post, data non ancora fissata)
          schedLine = '<p style="font-size:11px;color:var(--gray-500);margin:3px 0 4px;font-weight:500">\ud83d\udd52 ' + escapeHtml(t) + '</p>';
        }
        const catName = categoryName(p.category);
        const titleHtml = p.category
          ? '<span class="cat-code" title="Codice categoria">' + escapeHtml(p.category) + '</span>' + escapeHtml(catName)
          : 'Post';
        const apClass = p.approval_status ? ' ap-' + p.approval_status : '';
        const ratioClass = p.has_bad_ratio ? ' bad-ratio' : '';
        const apBadge = p.approval_status && p.approval_status !== 'pending'
          ? '<span class="ap-badge ap-' + p.approval_status + '" title="Stato approvazione cliente">' + ({ approved:'✓ OK', change_requested:'✏ mod.', rejected:'✗ NO' }[p.approval_status] || p.approval_status) + '</span>'
          : '';
        const ratioBadge = p.has_bad_ratio
          ? '<span class="ratio-card-badge" title="' + escapeHtml('Immagine fuori range IG: ' + (p.bad_ratio_detail || '') + ' — apri il post e ricroppa a 1:1 o 4:5') + '">⚠ RATIO</span>'
          : '';
        const commentHtml = p.last_client_comment
          ? '<div class="client-comment" title="' + escapeHtml(p.last_client_comment) + '">' + escapeHtml(p.last_client_comment) + '</div>'
          : '';
        html += '<div class="post-card' + apClass + ratioClass + '" draggable="true" data-post-id="' + p.id + '" style="position:relative">';
        html += '<button onclick="deletePost(\'' + p.id + '\', event)" title="Elimina post" style="position:absolute;top:4px;right:4px;z-index:2;width:20px;height:20px;background:rgba(255,255,255,.92);border:1px solid var(--gray-200);border-radius:3px;cursor:pointer;color:var(--red);font-weight:600;line-height:1;font-size:12px;padding:0">\u00d7</button>';
        html += '<a href="/dashboard/posts/' + p.id + '" style="text-decoration:none;color:inherit;display:block">';
        html += '<div class="post-card-image">' + (p.image_url ? '<img src="' + escapeHtml(p.image_url) + '" alt="">' : '<span style="font-size:10px;color:var(--gray-400)">Nessuna immagine</span>') + '</div>';
        html += '<div class="post-card-body"><h4 title="' + escapeHtml(catName) + '">' + titleHtml + apBadge + ratioBadge + '</h4>';
        html += '<p>' + escapeHtml(p.sub_topic || (p.caption ? p.caption.substring(0,80) + '...' : 'Nessun contenuto')) + '</p>';
        html += schedLine;
        html += commentHtml;
        html += '<div class="post-card-footer"><span class="badge badge-' + p.status + '">' + p.status + '</span>';
        html += '<span style="font-size:10px;color:var(--gray-500)">' + typeBadge + '</span></div></div></a></div>';
      });
      html += '</div></div>';
    }
    root.innerHTML = html;
    attachDragHandlers();
  }

  // ── Vista TABELLA: editor caption inline rapido ──
  // Mostra TUTTI i post del mese in una tabella: textarea modificabili
  // direttamente, save al blur (o con Ctrl+S), bottone "rigenera caption"
  // per chiamare l'AI senza aprire l'editor del post.
  function renderTable() {
    const root = document.getElementById('view-table');
    if (!root) return;
    if (!POSTS.length) { root.innerHTML = '<div class="empty-state"><h3>Nessun post in questo mese</h3></div>'; return; }
    const visible = POSTS.filter(matchesFilter);
    // Raggruppa per settimana per leggibilità
    const weeks = {};
    visible.forEach(p => { const w = p.week_number || 1; (weeks[w] = weeks[w] || []).push(p); });
    Object.keys(weeks).forEach(k => weeks[k].sort(byWeekPosOrder));

    let html = '<div id="view-table-toolbar">'
      + '<span class="help">Modifica le caption inline. Salva con <kbd>Tab</kbd>/click fuori, oppure <kbd>Ctrl+S</kbd>. ✨ "Rigenera" chiama l\'AI senza aprire l\'editor.</span>'
      + '</div>'
      + '<table>'
      + '<thead><tr>'
      + '<th class="col-week">Sett.</th>'
      + '<th class="col-cat">Categoria</th>'
      + '<th class="col-status">Stato</th>'
      + '<th class="col-caption">Caption</th>'
      + '<th class="col-actions">Azioni</th>'
      + '</tr></thead><tbody>';

    Object.keys(weeks).sort((a,b) => a-b).forEach(wn => {
      html += '<tr class="week-sep"><td colspan="5">Settimana ' + wn + '</td></tr>';
      weeks[wn].forEach(p => {
        const catCode = p.category || '';
        const catName = categoryName(p.category);
        const sub = p.sub_topic || '';
        const captionVal = p.caption || '';
        const placeholder = captionVal ? '' : 'Nessuna caption ancora generata. Scrivi qui o clicca ✨ Rigenera.';
        const sched = (p.scheduled_date || '') + (p.scheduled_time ? ' · ' + p.scheduled_time.slice(0,5) : '');
        html += '<tr data-post-id="' + p.id + '" data-orig-caption="' + escapeHtml(captionVal) + '">'
          + '<td class="col-week">' + (p.week_number || '—') + '</td>'
          + '<td class="col-cat">'
            + (catCode ? '<span class="cat-pill">' + escapeHtml(catCode) + '</span> <span class="cat-name">' + escapeHtml(catName) + '</span>' : '<span class="cat-name">—</span>')
            + (sub ? '<div class="sub" title="' + escapeHtml(sub) + '">' + escapeHtml(sub.substring(0, 100)) + '</div>' : '')
            + (sched ? '<div class="cat-name" style="margin-top:3px">📅 ' + escapeHtml(sched) + '</div>' : '')
          + '</td>'
          + '<td class="col-status">'
            + '<span class="badge badge-' + p.status + '">' + p.status + '</span>'
            + (p.approval_status && p.approval_status !== 'pending'
                ? '<div style="margin-top:4px"><span class="ap-badge ap-' + p.approval_status + '">' + ({approved:'✓', change_requested:'✏', rejected:'✗'}[p.approval_status] || '') + '</span></div>'
                : '')
          + '</td>'
          + '<td class="col-caption">'
            + '<textarea data-post-id="' + p.id + '" placeholder="' + escapeHtml(placeholder) + '">' + escapeHtml(captionVal) + '</textarea>'
          + '</td>'
          + '<td class="col-actions">'
            + '<button class="btn btn-sm btn-secondary" onclick="regenerateCaptionInline(\'' + p.id + '\')" title="Rigenera con AI">✨ Rigenera</button>'
            + '<div style="margin-top:6px"><a href="/dashboard/posts/' + p.id + '" style="font-size:11px;color:var(--blue)">Apri post →</a></div>'
            + '<div class="save-status" data-status-for="' + p.id + '"></div>'
          + '</td>'
          + '</tr>';
      });
    });
    html += '</tbody></table>';
    root.innerHTML = html;
    attachTableHandlers();
  }

  function attachTableHandlers() {
    document.querySelectorAll('#view-table textarea[data-post-id]').forEach(ta => {
      const tr = ta.closest('tr');
      const orig = tr.dataset.origCaption || '';
      ta.addEventListener('input', () => {
        const dirty = ta.value !== orig;
        tr.classList.toggle('dirty', dirty);
      });
      ta.addEventListener('blur', () => {
        if (ta.value !== orig) saveCaptionInline(ta.dataset.postId, ta.value);
      });
      ta.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
          e.preventDefault();
          if (ta.value !== orig) saveCaptionInline(ta.dataset.postId, ta.value);
        }
      });
    });
  }

  async function saveCaptionInline(postId, newCaption) {
    const tr = document.querySelector('#view-table tr[data-post-id="' + postId + '"]');
    const status = tr ? tr.querySelector('.save-status') : null;
    if (status) { status.textContent = 'Salvo…'; status.className = 'save-status'; }
    try {
      const res = await apiFetch('/dashboard/api/posts/' + postId, {
        method: 'PUT',
        body: { caption: newCaption }
      });
      if (res && res.error) throw new Error(res.error);
      // Aggiorna stato in memoria
      const p = POSTS.find(x => x.id === postId);
      if (p) p.caption = newCaption;
      if (tr) {
        tr.dataset.origCaption = newCaption;
        tr.classList.remove('dirty');
        tr.classList.add('saved');
        setTimeout(() => tr.classList.remove('saved'), 1500);
      }
      if (status) { status.textContent = '✓ Salvato'; status.className = 'save-status saved'; setTimeout(() => { status.textContent = ''; }, 2000); }
    } catch (err) {
      if (status) { status.textContent = 'Errore: ' + (err.message || err); status.className = 'save-status error'; }
    }
  }

  async function regenerateCaptionInline(postId) {
    const tr = document.querySelector('#view-table tr[data-post-id="' + postId + '"]');
    const status = tr ? tr.querySelector('.save-status') : null;
    const btn = tr ? tr.querySelector('button') : null;
    if (status) { status.textContent = 'Genero con AI…'; status.className = 'save-status'; }
    if (btn) btn.disabled = true;
    try {
      const res = await apiFetch('/dashboard/api/posts/' + postId + '/generate-caption', { method: 'POST' });
      if (res && res.error) throw new Error(res.error);
      const newCaption = (res && res.caption) || (res && res.post && res.post.caption) || '';
      const ta = tr ? tr.querySelector('textarea') : null;
      if (ta) {
        ta.value = newCaption;
        tr.dataset.origCaption = newCaption;
        tr.classList.remove('dirty');
      }
      const p = POSTS.find(x => x.id === postId);
      if (p) p.caption = newCaption;
      if (status) { status.textContent = '✓ Generata'; status.className = 'save-status saved'; setTimeout(() => { status.textContent = ''; }, 2000); }
    } catch (err) {
      if (status) { status.textContent = 'Errore: ' + (err.message || err); status.className = 'save-status error'; }
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  // ── Drag & drop: spostamento tra settimane + riordino DENTRO la settimana ──
  // L'ordine visivo di una settimana è l'ordine dei POSTS filtrati per week_number.
  // Al drop ricalcoliamo position 0..N per le settimane coinvolte e mandiamo un
  // bulk-reorder al server.
  let draggedPostId = null;
  let dragGhostEl = null;

  function attachDragHandlers() {
    document.querySelectorAll('#view-list .post-card[draggable="true"]').forEach(card => {
      card.addEventListener('dragstart', onCardDragStart);
      card.addEventListener('dragend',   onCardDragEnd);
      card.addEventListener('dragover',  onCardDragOver);
      card.addEventListener('dragleave', onCardDragLeave);
      card.addEventListener('drop',      onCardDrop);
    });
    document.querySelectorAll('#view-list .week-group').forEach(group => {
      group.addEventListener('dragover',  onWeekDragOver);
      group.addEventListener('dragleave', onWeekDragLeave);
      group.addEventListener('drop',      onWeekDrop);
    });
  }

  function buildDragGhost(post) {
    // Ghost pulito: categoria + sub_topic troncato, niente bottoni o immagine
    const g = document.createElement('div');
    g.className = 'drag-ghost';
    const label = (post.category || 'Post') + (post.sub_topic ? ' · ' + post.sub_topic.substring(0, 50) : '');
    g.innerHTML = '<span class="dg-icon">\u2630</span><span class="dg-text"></span>';
    g.querySelector('.dg-text').textContent = label;
    document.body.appendChild(g);
    return g;
  }

  function onCardDragStart(ev) {
    draggedPostId = ev.currentTarget.dataset.postId;
    const post = POSTS.find(p => p.id === draggedPostId);
    ev.currentTarget.classList.add('dragging');
    try { ev.dataTransfer.setData('text/plain', draggedPostId); } catch (_) {}
    ev.dataTransfer.effectAllowed = 'move';
    // Drag image pulita (sostituisce lo screenshot default della card con bottoni)
    if (post && ev.dataTransfer.setDragImage) {
      dragGhostEl = buildDragGhost(post);
      ev.dataTransfer.setDragImage(dragGhostEl, 10, 10);
    }
  }

  function onCardDragEnd(ev) {
    ev.currentTarget.classList.remove('dragging');
    draggedPostId = null;
    if (dragGhostEl) { dragGhostEl.remove(); dragGhostEl = null; }
    document.querySelectorAll('#view-list .week-group.drop-target').forEach(g => g.classList.remove('drop-target'));
    document.querySelectorAll('#view-list .post-card.drop-before, #view-list .post-card.drop-after')
      .forEach(c => c.classList.remove('drop-before', 'drop-after'));
  }

  function onCardDragOver(ev) {
    if (!draggedPostId) return;
    if (ev.currentTarget.dataset.postId === draggedPostId) return; // no-op su se stessa
    ev.preventDefault();
    ev.stopPropagation();
    ev.dataTransfer.dropEffect = 'move';
    const rect = ev.currentTarget.getBoundingClientRect();
    const midX = rect.left + rect.width / 2;
    const before = ev.clientX < midX;
    ev.currentTarget.classList.toggle('drop-before', before);
    ev.currentTarget.classList.toggle('drop-after',  !before);
    // Previeni highlight del week-group sottostante
    const group = ev.currentTarget.closest('.week-group');
    if (group) group.classList.remove('drop-target');
  }

  function onCardDragLeave(ev) {
    if (ev.currentTarget.contains(ev.relatedTarget)) return;
    ev.currentTarget.classList.remove('drop-before', 'drop-after');
  }

  async function onCardDrop(ev) {
    if (!draggedPostId) return;
    if (ev.currentTarget.dataset.postId === draggedPostId) return;
    ev.preventDefault();
    ev.stopPropagation();
    const targetPostId = ev.currentTarget.dataset.postId;
    const insertBefore = ev.currentTarget.classList.contains('drop-before');
    ev.currentTarget.classList.remove('drop-before', 'drop-after');
    const group = ev.currentTarget.closest('.week-group');
    const targetWeek = group ? parseInt(group.dataset.week, 10) : null;
    await commitReorder(draggedPostId, targetWeek, targetPostId, insertBefore);
  }

  function onWeekDragOver(ev) {
    if (!draggedPostId) return;
    ev.preventDefault();
    ev.dataTransfer.dropEffect = 'move';
    ev.currentTarget.classList.add('drop-target');
  }

  function onWeekDragLeave(ev) {
    if (ev.currentTarget.contains(ev.relatedTarget)) return;
    ev.currentTarget.classList.remove('drop-target');
  }

  async function onWeekDrop(ev) {
    ev.preventDefault();
    ev.currentTarget.classList.remove('drop-target');
    const targetWeek = parseInt(ev.currentTarget.dataset.week, 10);
    const postId = draggedPostId;
    if (!postId || !Number.isInteger(targetWeek)) return;
    // Drop sulla week-group = appendi in fondo alla settimana
    await commitReorder(postId, targetWeek, null, false);
  }

  // Calcola il nuovo ordine, aggiorna UI optimistic e sincronizza col server.
  async function commitReorder(postId, targetWeek, targetPostId, insertBefore) {
    const post = POSTS.find(p => p.id === postId);
    if (!post) return;
    const originalWeek = post.week_number || 1;
    const originalPosition = post.position || 0;

    // Ordinamento corrente della settimana di origine (escluso il post spostato)
    const sourceList = POSTS
      .filter(p => (p.week_number || 1) === originalWeek && p.id !== postId)
      .sort(byWeekPosOrder);
    // Ordinamento corrente della settimana di destinazione (con post spostato inserito)
    const destList = POSTS
      .filter(p => (p.week_number || 1) === targetWeek && p.id !== postId)
      .sort(byWeekPosOrder);

    let insertIndex;
    if (targetPostId) {
      const idx = destList.findIndex(p => p.id === targetPostId);
      if (idx < 0) { insertIndex = destList.length; }
      else { insertIndex = insertBefore ? idx : idx + 1; }
    } else {
      insertIndex = destList.length; // drop su week-group = append
    }
    destList.splice(insertIndex, 0, post);

    // Stessa settimana o cross-week?
    const crossWeek = originalWeek !== targetWeek;
    const newWeekForPost = targetWeek;
    // No-op check: stessa week, stessa position
    if (!crossWeek && originalPosition === insertIndex) return;

    // Optimistic update: aggiorna position e week_number in memoria
    post.week_number = newWeekForPost;
    destList.forEach((p, i) => { p.position = i; });
    if (crossWeek) sourceList.forEach((p, i) => { p.position = i; });
    renderList();

    // Costruisci payload bulk
    const items = [];
    destList.forEach((p, i) => items.push({ id: p.id, week_number: targetWeek, position: i }));
    if (crossWeek) sourceList.forEach((p, i) => items.push({ id: p.id, week_number: originalWeek, position: i }));

    try {
      const res = await apiFetch('/dashboard/api/posts/bulk-reorder', {
        method: 'POST',
        body: { items }
      });
      if (res.error) throw new Error(res.error);
      toast(crossWeek ? ('Post spostato in settimana ' + targetWeek) : 'Ordine aggiornato');
    } catch (err) {
      // Rollback: reload completo per ripristinare lo stato corretto dal server
      showAlert('Spostamento fallito: ' + err.message);
      window.location.reload();
    }
  }

  function byWeekPosOrder(a, b) {
    const pa = (a.position == null) ? 0 : a.position;
    const pb = (b.position == null) ? 0 : b.position;
    if (pa !== pb) return pa - pb;
    // Fallback per ordine deterministico se position uguale
    const da = a.scheduled_date || '';
    const db = b.scheduled_date || '';
    if (da !== db) return da < db ? -1 : 1;
    return (a.id || '') < (b.id || '') ? -1 : 1;
  }

  function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

