  // Azione unica "Avvia pubblicazione mese": esegue in sequenza
  //  1) bulk-ready (segna ready i post validi)
  //  2) approve-all come admin (sblocca publish guard)
  //  3) confirm schedule (attiva auto-publish)
  async function goLiveMonth() {
    if (!POSTS.length) { showAlert('Nessun post in questo mese.'); return; }
    const msg = 'Avviare la pubblicazione del mese ' + MONTH + '?\n\n' +
      'Verrà eseguito in automatico:\n' +
      '1) Segno come "pronti" tutti i post con caption + media validi per IG\n' +
      '2) Li approvo come amministratore (sblocco il guard approvazioni)\n' +
      '3) Attivo l\'auto-publish: il cron pubblicherà su FB/IG i post ready con data passata\n\n' +
      'I post incompleti (senza caption, media o con proporzioni sbagliate per IG) verranno SALTATI e te li elenco.\n\n' +
      'Procedere?';
    if (!await showConfirm(msg)) return;
    try {
      toast('Avvio in corso...');
      // 1) Bulk-ready validati (NO force: salta i post invalidi)
      const target = POSTS.filter(p => p.status !== 'ready' && p.status !== 'published').map(p => p.id);
      let readyRes = { updated: 0, skipped: [] };
      if (target.length) {
        readyRes = await apiFetch('/dashboard/api/posts/bulk-ready', { method: 'POST', body: { post_ids: target, force: false } });
        if (readyRes.error) throw new Error('Bulk-ready: ' + readyRes.error);
      }
      // 2) Approve-all come admin
      const approveRes = await apiFetch('/dashboard/api/approvals/admin/plans/' + PLAN_ID + '/months/' + MONTH + '/approve-all', { method: 'POST', body: {} });
      if (approveRes.error) throw new Error('Approve: ' + approveRes.error);
      // 3) Attiva schedule
      const schedRes = await apiFetch('/dashboard/api/schedules/' + PLAN_ID + '/month/' + MONTH + '/confirm', { method: 'POST' });
      if (schedRes && schedRes.error) throw new Error('Schedule: ' + schedRes.error);

      // Riepilogo
      const lines = [];
      lines.push('✅ Pubblicazione avviata');
      lines.push('• ' + readyRes.updated + ' post pronti');
      lines.push('• ' + approveRes.approved + ' post approvati');
      lines.push('• Auto-publish attivo');
      if (readyRes.skipped && readyRes.skipped.length) {
        const byReason = readyRes.skipped.reduce((a, s) => { a[s.reason] = (a[s.reason] || 0) + 1; return a; }, {});
        lines.push('');
        lines.push('⚠ Saltati (da sistemare manualmente):');
        Object.entries(byReason).forEach(([r, n]) => lines.push('  • ' + n + ' post: ' + r));
      }
      await showAlert(lines.join('\n'));
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

  async function bulkReady() {
    const target = POSTS.filter(p => p.status !== 'ready' && p.status !== 'published').map(p => p.id);
    if (!target.length) { await showAlert('Nessun post da segnare come pronto (già tutti ready o published).'); return; }
    const force = await showConfirm('Segnare come "ready" ' + target.length + ' post del mese?\n\nI post senza caption o senza media verranno SALTATI automaticamente (li sistemi uno alla volta dopo).\n\nVuoi forzare anche quelli incompleti? [OK = forza tutti / Annulla = solo quelli validi]');
    try {
      const res = await apiFetch('/dashboard/api/posts/bulk-ready', {
        method: 'POST',
        body: { post_ids: target, force: force === true }
      });
      if (res.error) { await showAlert(res.error); return; }
      const skipReasons = (res.skipped || []).reduce((acc, s) => { acc[s.reason] = (acc[s.reason] || 0) + 1; return acc; }, {});
      const skipSummary = Object.entries(skipReasons).map(([r, n]) => n + ' ' + r).join(', ');
      const msg = 'Pronti: ' + res.updated + (res.skipped.length ? ' · Saltati: ' + res.skipped.length + ' (' + skipSummary + ')' : '');
      toast(msg);
      window.location.reload();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }

