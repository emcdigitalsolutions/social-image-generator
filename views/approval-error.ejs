<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<style>
  body { margin: 0; background: #f7f8fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, system-ui, sans-serif; color: #111827; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .card { background: white; padding: 36px 32px; border-radius: 12px; max-width: 480px; box-shadow: 0 4px 16px rgba(0,0,0,.05); text-align: center; }
  h1 { margin: 0 0 12px; color: #dc2626; font-size: 22px; }
  p { color: #6b7280; line-height: 1.5; }
</style>
</head>
<body>
<div class="card">
  <h1>&#9888; <%= title %></h1>
  <p><%- message %></p>
</div>
</body>
</html>
