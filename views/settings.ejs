<%- include('layout', { title, user, activeNav: 'settings' }) %>

<div class="page-header">
  <h1>Impostazioni</h1>
</div>

<!-- API Keys globali -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-header">
    <h3>API Keys globali</h3>
  </div>
  <p style="font-size:13px; color:var(--gray-500); margin-bottom:16px;">
    Chiavi usate come fallback quando un cliente non ha la propria. Lasciare vuoto per usare le variabili d'ambiente.
  </p>
  <div id="apiAlert" style="display:none; padding:10px 14px; border-radius:6px; font-size:13px; margin-bottom:16px;"></div>
  <form id="apiForm" onsubmit="saveApi(event)">
    <div class="form-group">
      <label>Anthropic API Key</label>
      <input type="password" id="setAnthropicKey" placeholder="sk-ant-...">
    </div>
    <div class="form-group">
      <label>Gemini API Key <span style="font-weight:400;color:var(--gray-500);font-size:12px">(globale, fallback per clienti senza key propria)</span></label>
      <input type="password" id="setGeminiKey" placeholder="AIza...">
    </div>
    <div class="form-group">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
        <input type="checkbox" id="setGeminiForceGlobal" style="width:auto">
        <span>🔒 <strong>Usa sempre la key globale</strong> (ignora le key per cliente)</span>
      </label>
      <p style="font-size:11px;color:var(--gray-500);margin-top:4px;margin-left:24px">Utile quando billing è attivo solo sulla key globale: tutti i clienti useranno questa key indipendentemente da quella loro configurata.</p>
    </div>
    <div class="form-group">
      <label>Replicate API Token <span style="font-weight:400;color:var(--gray-500);font-size:12px">(consigliato, per generare musica AI)</span></label>
      <input type="password" id="setReplicateKey" placeholder="r8_...">
      <p style="font-size:11px;color:var(--gray-500);margin-top:4px">Token: <a href="https://replicate.com/account/api-tokens" target="_blank">replicate.com/account/api-tokens</a> ($5 free credit ≈ 100 tracce). Usa MusicGen di Meta.</p>
    </div>
    <div class="form-group">
      <label>Hugging Face API Key <span style="font-weight:400;color:var(--gray-500);font-size:12px">(opzionale, fallback)</span></label>
      <input type="password" id="setHfKey" placeholder="hf_...">
      <p style="font-size:11px;color:var(--gray-500);margin-top:4px">⚠ HF Inference API gratuita ha deprecato MusicGen — molto probabile 404. Tieni come fallback se hai accesso.</p>
    </div>
    <button type="submit" class="btn btn-primary">Salva</button>
    <button type="button" class="btn btn-secondary" onclick="testAi()">🔍 Verifica stato AI (credito/connessione)</button>
    <p style="font-size:11px;color:var(--gray-500);margin-top:8px">Google non espone il saldo in € via API: questo test fa una chiamata reale e indica se la generazione funziona (credito attivo) o perché no.</p>
    <div id="aiStatus" style="margin-top:14px;display:none"></div>
  </form>
</div>

<!-- Generale -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-header">
    <h3>Generale</h3>
  </div>
  <p style="font-size:13px; color:var(--gray-500); margin-bottom:16px;">
    Modifiche a Base URL richiedono un restart per essere visibili nei link al di fuori delle email.
  </p>
  <div id="genAlert" style="display:none; padding:10px 14px; border-radius:6px; font-size:13px; margin-bottom:16px;"></div>
  <form id="genForm" onsubmit="saveGen(event)">
    <div class="form-group">
      <label>Base URL pubblica</label>
      <input type="url" id="setBaseUrl" placeholder="https://media.emcdigitalsolutions.it">
    </div>
    <button type="submit" class="btn btn-primary">Salva</button>
  </form>
</div>

<!-- SMTP -->
<div class="card" style="margin-bottom: 24px;">
  <div class="card-header">
    <h3>Configurazione SMTP</h3>
  </div>
  <p style="font-size:13px; color:var(--gray-500); margin-bottom:16px;">
    Configura il server SMTP per l'invio di notifiche email. Se non configurato, il sistema utilizza le variabili d'ambiente.
  </p>
  <div id="smtpAlert" style="display:none; padding:10px 14px; border-radius:6px; font-size:13px; margin-bottom:16px;"></div>
  <form id="smtpForm" onsubmit="saveSmtp(event)">
    <div style="display:grid; grid-template-columns:1fr 200px; gap:16px;">
      <div class="form-group">
        <label>Host SMTP</label>
        <input type="text" id="setSmtpHost" placeholder="Es. smtp.gmail.com">
      </div>
      <div class="form-group">
        <label>Porta</label>
        <input type="number" id="setSmtpPort" placeholder="587" value="587">
      </div>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <div class="form-group">
        <label>Username</label>
        <input type="text" id="setSmtpUser" placeholder="email@esempio.it">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="setSmtpPass" placeholder="Password o App Password">
      </div>
    </div>
    <div class="form-group">
      <label>Email destinatario notifiche</label>
      <input type="email" id="setSmtpNotifyTo" placeholder="Es. admin@esempio.it (lasciare vuoto per usare lo username)">
    </div>

    <hr style="margin:20px 0; border:0; border-top:1px dashed var(--gray-200)">
    <h4 style="margin:0 0 6px; font-size:14px">Canale alternativo — Google Apps Script</h4>
    <p style="font-size:12px; color:var(--gray-500); margin-bottom:10px;">
      Se il server non riesce a connettersi a un SMTP (es. Hetzner blocca outbound SMTP), puoi inviare le notifiche tramite un webhook Google Apps Script che usa MailApp via HTTPS:443.
      Se questo campo è compilato ha <strong>priorità</strong> su SMTP. Formato: <code>https://script.google.com/macros/s/…/exec</code>.
    </p>
    <div class="form-group">
      <label>Google Apps Script URL <small style="color:var(--gray-400);font-weight:400">(per notifiche admin, no allegati)</small></label>
      <input type="url" id="setGoogleScriptUrl" placeholder="https://script.google.com/macros/s/…/exec">
    </div>
    <div class="form-group">
      <label>CC di test (opzionale)</label>
      <input type="email" id="setGoogleScriptTestCc" placeholder="indirizzo@esempio.it — solo per il bottone 'Test Google Script'">
      <small style="color:var(--gray-500); font-size:12px">Se valorizzato, la mail di test viene inviata anche in CC a questo indirizzo. Utile per verificare che il GAS propaghi correttamente il campo <code>cc</code>. Non viene salvato.</small>
    </div>

    <hr style="margin:20px 0; border:0; border-top:1px dashed var(--gray-200)">
    <h4 style="margin:0 0 6px; font-size:14px">GAS Email Relay (con allegati e destinatario custom)</h4>
    <p style="font-size:12px; color:var(--gray-500); margin-bottom:10px;">
      Necessario per email cliente con allegato PDF (report mensile) e per il link approvazione cliente.
      Crea un nuovo Apps Script con il codice <code>emcdigitalsolutions/sig-email-relay.gs</code> del repo, deploya come Web App e incolla URL+secret qui.
    </p>
    <div class="form-group">
      <label>GAS Email URL</label>
      <input type="url" id="setGasEmailUrl" placeholder="https://script.google.com/macros/s/…/exec">
    </div>
    <div class="form-group">
      <label>GAS Email Secret</label>
      <input type="password" id="setGasEmailSecret" placeholder="Stessa stringa SHARED_SECRET nel codice GAS">
    </div>

    <div style="display:flex; gap:8px; flex-wrap:wrap">
      <button type="submit" class="btn btn-primary">Salva</button>
      <button type="button" class="btn btn-secondary" onclick="testSmtp()">Invia Email di Test (SMTP)</button>
      <button type="button" class="btn btn-secondary" onclick="testGoogleScript()">Test Google Script</button>
    </div>
  </form>
</div>

<script>
async function loadSettings() {
  try {
    const res = await fetch('/dashboard/api/settings', {
      headers: { 'Authorization': 'Bearer ' + getToken() }
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);
    const s = data.settings || {};
    document.getElementById('setSmtpHost').value = s.smtp_host || '';
    document.getElementById('setSmtpPort').value = s.smtp_port || '587';
    document.getElementById('setSmtpUser').value = s.smtp_user || '';
    document.getElementById('setSmtpPass').value = s.smtp_pass || '';
    document.getElementById('setSmtpNotifyTo').value = s.smtp_notify_to || '';
    document.getElementById('setGoogleScriptUrl').value = s.google_script_url || '';
    document.getElementById('setGasEmailUrl').value = s.gas_email_url || '';
    document.getElementById('setGasEmailSecret').value = s.gas_email_secret || '';
    document.getElementById('setAnthropicKey').value = s.anthropic_api_key || '';
    document.getElementById('setGeminiKey').value = s.gemini_api_key || '';
    document.getElementById('setHfKey').value = s.huggingface_api_key || '';
    document.getElementById('setReplicateKey').value = s.replicate_api_key || '';
    document.getElementById('setGeminiForceGlobal').checked = s.gemini_force_global === '1';
    document.getElementById('setBaseUrl').value = s.base_url || '';
  } catch (err) {
    setBanner('smtpAlert','error', 'Errore nel caricamento: ' + err.message);
  }
}

async function saveApi(e) {
  e.preventDefault();
  try {
    const res = await fetch('/dashboard/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
      body: JSON.stringify({ settings: {
        anthropic_api_key: document.getElementById('setAnthropicKey').value,
        gemini_api_key: document.getElementById('setGeminiKey').value,
        huggingface_api_key: document.getElementById('setHfKey').value,
        replicate_api_key: document.getElementById('setReplicateKey').value,
        gemini_force_global: document.getElementById('setGeminiForceGlobal').checked ? '1' : '0'
      }})
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);
    setBanner('apiAlert', 'success', 'API keys salvate.');
  } catch (err) {
    setBanner('apiAlert', 'error', 'Errore: ' + err.message);
  }
}

async function saveGen(e) {
  e.preventDefault();
  try {
    const res = await fetch('/dashboard/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
      body: JSON.stringify({ settings: {
        base_url: document.getElementById('setBaseUrl').value
      }})
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);
    setBanner('genAlert', 'success', 'Impostazioni generali salvate.');
  } catch (err) {
    setBanner('genAlert', 'error', 'Errore: ' + err.message);
  }
}

async function saveSmtp(e) {
  e.preventDefault();
  try {
    const res = await fetch('/dashboard/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
      body: JSON.stringify({ settings: {
        smtp_host: document.getElementById('setSmtpHost').value,
        smtp_port: document.getElementById('setSmtpPort').value,
        smtp_user: document.getElementById('setSmtpUser').value,
        smtp_pass: document.getElementById('setSmtpPass').value,
        smtp_notify_to: document.getElementById('setSmtpNotifyTo').value,
        google_script_url: document.getElementById('setGoogleScriptUrl').value,
        gas_email_url: document.getElementById('setGasEmailUrl').value,
        gas_email_secret: document.getElementById('setGasEmailSecret').value
      }})
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);
    setBanner('smtpAlert','success', 'Impostazioni salvate con successo.');
  } catch (err) {
    setBanner('smtpAlert','error', 'Errore: ' + err.message);
  }
}

async function testSmtp() {
  try {
    setBanner('smtpAlert','info', 'Invio email di test in corso...');
    const res = await fetch('/dashboard/api/settings/test-smtp', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + getToken() }
    });
    // Risposta può essere non-JSON se il proxy davanti all'app (Traefik/Coolify)
    // chiude la connessione con un Bad Gateway. In quel caso mostra un messaggio utile.
    const ct = res.headers.get('content-type') || '';
    const text = await res.text();
    let data = {};
    if (ct.includes('application/json')) {
      try { data = JSON.parse(text); } catch (_) { data = {}; }
    }
    if (!res.ok) {
      if (res.status === 502 || res.status === 504) {
        throw new Error('Il proxy del server ha chiuso la connessione (HTTP ' + res.status + '). Il server SMTP probabilmente non risponde o le credenziali bloccano la connessione a lungo. Verifica host/porta/credenziali.');
      }
      throw new Error(data.error || text.slice(0, 200) || ('HTTP ' + res.status));
    }
    setBanner('smtpAlert', 'success', data.message || 'Email inviata.');
  } catch (err) {
    setBanner('smtpAlert','error', 'Errore: ' + err.message);
  }
}

async function testAi() {
  const box = document.getElementById('aiStatus');
  box.style.display = 'block';
  box.innerHTML = '<div style="padding:10px 14px;border-radius:6px;background:#eef2ff;color:#3538cd;font-size:13px">⏳ Verifica in corso (chiamata reale ai provider)...</div>';
  try {
    const res = await fetch('/dashboard/api/settings/test-ai', { method: 'POST', headers: { 'Authorization': 'Bearer ' + getToken() } });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
    const colors = { ok: ['#e7f6ec', '#1a7f37'], warn: ['#fff6e5', '#9a6700'], error: ['#fdecea', '#b42318'], muted: ['#f1f1f1', '#666'] };
    const icon = { ok: '✅', warn: '⚠️', error: '❌', muted: '➖' };
    box.innerHTML = (data.results || []).map(function (r) {
      var c = colors[r.level] || colors.muted;
      return '<div style="padding:10px 14px;border-radius:6px;margin-bottom:8px;background:' + c[0] + ';color:' + c[1] + ';font-size:13px"><strong>' + (icon[r.level] || '') + ' ' + r.provider + '</strong> — ' + r.message + (r.status ? ' <span style="opacity:.55">(HTTP ' + r.status + ')</span>' : '') + '</div>';
    }).join('');
  } catch (err) {
    box.innerHTML = '<div style="padding:10px 14px;border-radius:6px;background:#fdecea;color:#b42318;font-size:13px">Errore: ' + err.message + '</div>';
  }
}

async function testGoogleScript() {
  try {
    setBanner('smtpAlert','info', 'Invio via Google Script in corso...');
    const cc = (document.getElementById('setGoogleScriptTestCc').value || '').trim();
    const res = await fetch('/dashboard/api/settings/test-google-script', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
      body: JSON.stringify({ cc })
    });
    const ct = res.headers.get('content-type') || '';
    const text = await res.text();
    let data = {};
    if (ct.includes('application/json')) { try { data = JSON.parse(text); } catch (_) {} }
    if (!res.ok) {
      if (res.status === 502 || res.status === 504) throw new Error('Proxy timeout (HTTP ' + res.status + ').');
      throw new Error(data.error || text.slice(0, 200) || ('HTTP ' + res.status));
    }
    setBanner('smtpAlert','success', data.message || 'Richiesta inviata.');
  } catch (err) {
    setBanner('smtpAlert','error', 'Errore: ' + err.message);
  }
}

// NB: rinominata per evitare conflitto con la showAlert globale (modale) di dashboard.js
// che accetta un solo argomento (message) e aprirebbe la modale mostrando il primo
// argomento literale (es. "smtpAlert") invece del messaggio reale.
function setBanner(elId, type, msg) {
  const el = document.getElementById(elId);
  if (!el) return;
  const colors = {
    success: { bg: 'var(--green-light)', color: 'var(--green)' },
    error: { bg: 'var(--red-light)', color: 'var(--red)' },
    info: { bg: 'var(--blue-50)', color: 'var(--blue)' }
  };
  const c = colors[type] || colors.info;
  el.style.display = 'block';
  el.style.background = c.bg;
  el.style.color = c.color;
  el.textContent = msg;
}

function getToken() {
  const c = document.cookie.split(';').find(c => c.trim().startsWith('dashboard_token='));
  return c ? c.split('=')[1] : '';
}

loadSettings();
</script>

<%- include('layout-end') %>
