<%- include('layout', { title, user }) %>

<div class="breadcrumb">
  <a href="/dashboard">Clienti</a> / <%= client.display_name %>
</div>

<div class="page-header" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
  <h1 style="margin:0"><%= client.display_name %></h1>
  <span class="badge badge-<%= client.status %>"><%= client.status %></span>
  <% if (typeof currentMonthShortcut !== 'undefined' && currentMonthShortcut) { %>
    <a href="<%= currentMonthShortcut %>" class="btn btn-primary btn-sm" style="margin-left:auto" title="Apri direttamente la vista del mese in corso del piano editoriale">📅 Mese in corso</a>
  <% } %>
</div>

<div class="tabs">
  <button class="tab active" data-tab="profilo">Profilo</button>
  <button class="tab" data-tab="impostazioni">Impostazioni</button>
  <button class="tab" data-tab="questionario">Questionario</button>
  <button class="tab" data-tab="piano">Piano Editoriale</button>
  <button class="tab" data-tab="libreria">📚 Libreria Media</button>
  <button class="tab" data-tab="performance">Performance</button>
</div>

<!-- Tab: Profilo -->
<div class="tab-content active" id="tab-profilo">
  <div class="card">
    <div class="card-header"><h3>Informazioni Brand</h3></div>
    <form id="profile-form">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Nome visualizzato</label>
          <input type="text" name="display_name" value="<%= client.display_name || '' %>">
        </div>
        <div class="form-group">
          <label>Brand name</label>
          <input type="text" name="brand_name" value="<%= client.brand_name || '' %>">
        </div>
        <div class="form-group">
          <label>Settore</label>
          <select name="sector">
            <option value="">— Seleziona —</option>
            <% sectors.forEach(s => { %>
              <option value="<%= s.key %>" <%= client.sector === s.key ? 'selected' : '' %>><%= s.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Località</label>
          <input type="text" name="location" value="<%= client.location || '' %>">
        </div>
        <div class="form-group">
          <label>Sito web</label>
          <input type="text" name="website" value="<%= client.website || '' %>">
        </div>
        <div class="form-group">
          <label>Tagline</label>
          <input type="text" name="tagline" value="<%= client.tagline || '' %>">
        </div>
        <div class="form-group">
          <label title="Se impostata, il reminder mensile notifica direttamente il cliente quando ha un piano da approvare">Email di contatto cliente</label>
          <input type="email" name="contact_email" value="<%= client.contact_email || '' %>" placeholder="cliente@esempio.it">
        </div>
        <div class="form-group">
          <label title="Usato come {{phone}} nei template piano. Es: 0922 911100 oppure +39 328 968 5670">Telefono / WhatsApp</label>
          <input type="text" name="phone" value="<%= client.phone || '' %>" placeholder="+39 328 968 5670">
        </div>
      </div>
      <div class="form-group">
        <label>Stato</label>
        <select name="status">
          <option value="active" <%= client.status === 'active' ? 'selected' : '' %>>Attivo</option>
          <option value="paused" <%= client.status === 'paused' ? 'selected' : '' %>>In pausa</option>
          <option value="archived" <%= client.status === 'archived' ? 'selected' : '' %>>Archiviato</option>
        </select>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Piano commerciale</label>
          <input type="text" name="subscription_plan" value="<%= client.subscription_plan || '' %>" placeholder="es. Social Basic, Social Pro">
        </div>
        <div class="form-group">
          <label>Prezzo mensile (&euro;)</label>
          <input type="number" name="subscription_price" value="<%= client.subscription_price || '' %>" step="0.01" min="0" placeholder="0.00">
        </div>
        <div class="form-group">
          <label title="Quanti mesi il piano editoriale generato dall'AI deve coprire">Mesi piano editoriale</label>
          <input type="number" name="editorial_months" value="<%= client.editorial_months || 6 %>" step="1" min="1" max="24" placeholder="6">
        </div>
      </div>
      <div class="form-group">
        <label>Note commerciali</label>
        <textarea name="subscription_notes" rows="2" placeholder="es. canone 80&euro;/anno, social 150&euro;+IVA"><%= client.subscription_notes || '' %></textarea>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <button type="button" class="btn btn-secondary" id="scan-website-btn" onclick="scanWebsite()" title="Analizza il sito e compila automaticamente i campi"><span style="margin-right:3px">✨</span>Scansiona Sito</button>
        <button type="submit" class="btn btn-primary">Salva Profilo</button>
      </div>
    </form>
  </div>
</div>

<!-- Tab: Questionario -->
<div class="tab-content" id="tab-questionario">
  <div class="card">
    <div class="card-header">
      <h3>Questionari</h3>
      <div style="display:flex;gap:8px">
        <button class="btn btn-primary btn-sm" onclick="createQuestionnaire()">+ Nuovo Questionario</button>
        <label class="btn btn-secondary btn-sm" style="cursor:pointer;margin:0">
          Importa CSV
          <input type="file" accept=".csv" style="display:none" onchange="importCsv(this)">
        </label>
      </div>
    </div>
    <% if (questionnaires.length === 0) { %>
      <div class="empty-state"><p>Nessun questionario creato</p></div>
    <% } else { %>
      <table>
        <thead><tr><th>ID</th><th>Settore</th><th>Stato</th><th>Inviato</th><th>Link</th><th>Azioni</th></tr></thead>
        <tbody>
          <% questionnaires.forEach(q => {
            const qUrl = `/dashboard/q/${q.token}`;
          %>
          <tr style="cursor:pointer" onclick="if(!event.target.closest('button,a')) window.open('<%= qUrl %>', '_blank')" title="Apri questo questionario in una nuova scheda">
            <td><code><%= q.id.substring(0, 8) %></code></td>
            <td><%= q.sector ? q.sector.replace(/_/g, ' ') : '—' %></td>
            <td><span class="badge badge-<%= q.status %>"><%= q.status %></span></td>
            <td><%= q.submitted_at || '—' %></td>
            <td><a href="<%= qUrl %>" target="_blank" class="btn btn-sm btn-secondary">Apri</a></td>
            <td style="display:flex;gap:4px">
              <% if (q.status === 'submitted') { %>
                <button class="btn btn-sm btn-secondary" onclick="viewResponses('<%= q.id %>')">Risposte</button>
              <% } %>
              <button class="btn btn-sm" style="background:#ef4444;color:#fff" onclick="deleteQuestionnaire('<%= q.id %>')">Elimina</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- Tab: Piano Editoriale -->
<div class="tab-content" id="tab-piano">
  <div class="card">
    <div class="card-header">
      <h3>Piani Editoriali</h3>
      <div style="display:flex;gap:8px;align-items:center">
        <select id="plan-months-select" style="padding:6px 10px;border:1px solid var(--gray-300);border-radius:6px;font-size:13px;font-family:inherit">
          <option value="3">3 mesi</option>
          <option value="6" selected>6 mesi</option>
          <option value="12">12 mesi</option>
        </select>
        <button class="btn btn-primary btn-sm" onclick="generatePlan()" id="gen-plan-btn"><span style="margin-right:3px">✨</span>Genera Piano con AI</button>
        <button class="btn btn-secondary btn-sm" onclick="applyTemplateToClient()" title="Crea piano da un template salvato (più veloce della generazione AI)">&#9881; Da template</button>
        <button class="btn btn-secondary btn-sm" onclick="document.getElementById('import-plan-file').click()" title="Carica un piano editoriale preparato offline (JSON)">&uarr; Importa JSON</button>
        <input type="file" id="import-plan-file" accept="application/json,.json" style="display:none" onchange="importPlanFromFile(event)">
      </div>
    </div>
    <% if (plans.length === 0) { %>
      <div class="empty-state"><p>Nessun piano editoriale. Genera il primo dal questionario compilato.</p></div>
    <% } else { %>
      <table>
        <thead><tr><th>Titolo</th><th>Durata</th><th>Stato</th><th>Creato</th><th>Azioni</th></tr></thead>
        <tbody>
          <% plans.forEach(p => {
            const planData = typeof p.plan_data === 'string' ? JSON.parse(p.plan_data) : p.plan_data;
            const monthCount = planData && planData.months ? planData.months.length : '—';
            const planUrl = `/dashboard/clients/${client.id}/plan/${p.id}`;
          %>
          <tr style="cursor:pointer" onclick="if(!event.target.closest('button,a')) window.location.href='<%= planUrl %>'" title="Apri questo piano editoriale">
            <td><%= p.title || 'Piano senza titolo' %></td>
            <td><%= monthCount %> mesi</td>
            <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
            <td><%= fmtRome(p.created_at) %></td>
            <td style="display:flex;gap:4px;align-items:center" onclick="event.stopPropagation()">
              <button class="btn btn-sm" style="background:#ef4444;color:#fff" onclick="deletePlan('<%= p.id %>', '<%= p.status %>')">Elimina</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- Tab: Libreria Media -->
<div class="tab-content" id="tab-libreria">
  <div class="card" style="margin-bottom:16px">
    <div class="card-header">
      <h3>📚 Libreria Media</h3>
    </div>
    <p style="font-size:13px;color:var(--gray-600);margin:0 0 14px">
      Video e audio riusabili per questo cliente. Quando crei un nuovo post puoi
      selezionarli senza ri-caricarli. Cancellando un file qui non viene rimosso
      dai post che lo stavano già usando (ognuno mantiene la propria copia).
    </p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <!-- VIDEO -->
      <fieldset style="border:1px solid var(--gray-200);border-radius:6px;padding:12px">
        <legend style="font-size:13px;font-weight:600;padding:0 6px">🎥 Video</legend>
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
          <input type="file" id="lib-video-input" accept="video/mp4,video/quicktime" multiple style="flex:1;font-size:12px">
          <button class="btn btn-sm btn-primary" onclick="uploadLibraryFile('video')" id="lib-video-btn">Carica</button>
        </div>
        <div style="font-size:10px;color:var(--gray-500);margin-bottom:10px">MP4/MOV · max 100MB · selezione multipla supportata</div>
        <div id="lib-video-progress" style="display:none;font-size:11px;color:var(--gray-600);margin-bottom:10px"></div>
        <div id="lib-video-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;min-height:60px">
          <div class="lib-empty" style="grid-column:1/-1;color:var(--gray-400);font-size:12px;text-align:center;padding:18px 0">— Nessun video —</div>
        </div>
        <div id="lib-video-pagination" style="margin-top:10px"></div>
      </fieldset>

      <!-- AUDIO -->
      <fieldset style="border:1px solid var(--gray-200);border-radius:6px;padding:12px">
        <legend style="font-size:13px;font-weight:600;padding:0 6px">🎵 Audio</legend>
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
          <input type="file" id="lib-audio-input" accept="audio/mpeg,audio/wav,audio/mp4,audio/x-m4a,audio/ogg" multiple style="flex:1;font-size:12px">
          <button class="btn btn-sm btn-primary" onclick="uploadLibraryFile('audio')" id="lib-audio-btn">Carica</button>
        </div>
        <div style="font-size:10px;color:var(--gray-500);margin-bottom:10px">MP3/WAV/M4A/OGG · max 15MB · selezione multipla supportata · solo musica royalty-free</div>
        <div id="lib-audio-progress" style="display:none;font-size:11px;color:var(--gray-600);margin-bottom:10px"></div>
        <div id="lib-audio-list" style="display:flex;flex-direction:column;gap:8px;min-height:60px">
          <div class="lib-empty" style="color:var(--gray-400);font-size:12px;text-align:center;padding:18px 0">— Nessun audio —</div>
        </div>
        <div id="lib-audio-pagination" style="margin-top:10px"></div>
      </fieldset>
    </div>
  </div>
</div>

<!-- Tab: Performance -->
<div class="tab-content" id="tab-performance">
  <div class="card" style="margin-bottom:16px">
    <div class="card-header">
      <h3>Dashboard Insights cliente</h3>
      <button class="btn btn-primary btn-sm" onclick="createInsightsShare()">
        <span style="margin-right:3px">🔗</span>Genera link condivisibile
      </button>
    </div>
    <p style="font-size:13px;color:var(--gray-500);margin-bottom:14px">
      Crea un link da inviare al cliente. Aprendolo, vedrà una dashboard con la crescita follower (FB+IG), il reach giornaliero e i suoi post più performanti.
      I dati si aggiornano ogni giorno automaticamente.
    </p>
    <div id="insights-share-list">
      <p style="font-size:13px;color:var(--gray-400)">Caricamento link…</p>
    </div>
  </div>

  <div class="card" style="margin-bottom:16px">
    <div class="card-header"><h3>Report PDF mensile</h3></div>
    <p style="font-size:13px;color:var(--gray-500);margin-bottom:14px">
      Genera un PDF brandizzato con KPI, grafici di crescita e top post. Puoi scaricarlo subito o inviarlo automaticamente via email al cliente.
    </p>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <select id="report-days" onchange="updateReportPdfHref()" style="padding:6px 10px;border:1px solid var(--gray-300);border-radius:6px;font-size:13px;font-family:inherit;background:white">
        <option value="7">Ultimi 7 giorni</option>
        <option value="30" selected>Ultimi 30 giorni</option>
        <option value="90">Ultimi 90 giorni</option>
        <option value="365">Ultimo anno</option>
      </select>
      <a id="report-pdf-link" href="/dashboard/api/clients/<%= client.id %>/insights/report.pdf?days=30" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">⬇ Scarica PDF</a>
      <button class="btn btn-primary btn-sm" onclick="emailReportToClient()">✉ Invia via email al cliente</button>
    </div>
    <p style="font-size:11px;color:var(--gray-400);margin-top:8px" id="report-email-info">
      Email cliente: <span id="contact-email-display">—</span>. Per cambiarla vai in tab Profilo.
    </p>
    <div id="report-result" style="font-size:12px;color:var(--gray-500);margin-top:10px"></div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3>Snapshot dati Meta</h3>
      <button class="btn btn-secondary btn-sm" onclick="triggerInsightsSnapshot()">
        <span style="margin-right:3px">⟳</span>Aggiorna ora
      </button>
    </div>
    <p style="font-size:13px;color:var(--gray-500);margin-bottom:6px">
      Il sistema raccoglie automaticamente le metriche ogni giorno alle 04:00. Usa "Aggiorna ora" per forzare un fetch immediato (utile dopo un cambio credenziali).
    </p>
    <div id="snapshot-result" style="font-size:12px;color:var(--gray-500);margin-top:10px"></div>
  </div>
</div>

<!-- Tab: Impostazioni -->
<div class="tab-content" id="tab-impostazioni">
  <div class="card" style="margin-bottom:16px">
    <div class="card-header"><h3>Credenziali Social</h3></div>
    <form id="social-form">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="form-group">
          <label>Facebook Page ID</label>
          <div style="display:flex;gap:4px"><input type="text" name="fb_page_id" value="<%= client.fb_page_id || '' %>" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
        </div>
        <div class="form-group">
          <label>FB System User Token</label>
          <div style="display:flex;gap:4px"><input type="password" name="fb_system_user_token" value="<%= client.fb_system_user_token || '' %>" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
        </div>
        <div class="form-group">
          <label>Instagram User ID</label>
          <div style="display:flex;gap:4px"><input type="text" name="ig_user_id" value="<%= client.ig_user_id || '' %>" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
        </div>
        <div class="form-group">
          <label>LinkedIn Organization ID <span style="font-weight:400;color:var(--gray-400);font-size:11px">(es. 12345678)</span></label>
          <div style="display:flex;gap:4px"><input type="text" name="linkedin_org_id" value="<%= client.linkedin_org_id || '' %>" placeholder="ID numerico Page LinkedIn" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
        </div>
        <div class="form-group">
          <label>LinkedIn Access Token <span style="font-weight:400;color:var(--gray-400);font-size:11px">(scope w_organization_social)</span></label>
          <div style="display:flex;gap:4px"><input type="password" name="linkedin_access_token" value="<%= client.linkedin_access_token || '' %>" placeholder="OAuth 2.0 user token" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
        </div>
        <div class="form-group">
          <label>LinkedIn Token scade il <span style="font-weight:400;color:var(--gray-400);font-size:11px">(opzionale, per warning)</span></label>
          <input type="date" name="linkedin_token_expires_at" value="<%= client.linkedin_token_expires_at ? client.linkedin_token_expires_at.slice(0,10) : '' %>" style="width:100%">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Salva Credenziali</button>
    </form>
  </div>
  <div class="card" style="margin-bottom:16px">
    <div class="card-header"><h3>AI Provider</h3></div>
    <form id="ai-form">
      <div class="form-group">
        <label>Provider AI</label>
        <select name="ai_provider" id="ai-provider-select">
          <option value="gemini" <%= client.ai_provider === 'gemini' || !client.ai_provider ? 'selected' : '' %>>Gemini 2.5 Flash (gratuito)</option>
          <option value="claude" <%= client.ai_provider === 'claude' ? 'selected' : '' %>>Claude Opus (premium)</option>
        </select>
      </div>
      <div class="form-group" id="gemini-key-group">
        <label>Gemini API Key</label>
        <div style="display:flex;gap:4px"><input type="password" name="gemini_api_key" value="<%= client.gemini_api_key || '' %>" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
      </div>
      <div class="form-group" id="anthropic-key-group">
        <label>Anthropic API Key</label>
        <div style="display:flex;gap:4px"><input type="password" name="anthropic_api_key" value="<%= client.anthropic_api_key || '' %>" style="flex:1"><button type="button" class="btn-copy" onclick="copyField(this)" title="Copia"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button></div>
      </div>
      <div class="form-group">
        <label>System Instruction (prompt personalizzato)</label>
        <textarea name="system_instruction" id="system-instruction-textarea" rows="8"><%= client.system_instruction || '' %></textarea>
        <button type="button" class="btn btn-secondary btn-sm" id="generate-si-btn" onclick="generateSystemInstruction()" style="margin-top:8px"><span style="margin-right:3px">✨</span>Genera con AI</button>
      </div>
      <button type="submit" class="btn btn-primary">Salva AI Config</button>
    </form>
  </div>
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center">
      <h3>Logo e Tema</h3>
      <div style="display:flex;align-items:center;gap:8px">
        <span id="branding-status" style="font-size:12px;display:none"></span>
        <button type="button" class="btn btn-sm btn-primary" id="scan-branding-btn" onclick="scanBranding()"><span style="margin-right:3px">✨</span>Importa da Sito</button>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <!-- Logo Section -->
      <div>
        <p style="font-size:13px;color:var(--gray-500);margin-bottom:8px" id="logo-status-text">Logo: <span id="logo-status-value"><%- client.logo_filename ? '<span style="color:#16a34a">&#10003;</span> ' + client.logo_filename : 'non caricato' %></span></p>
        <div id="logo-preview-container" style="margin-bottom:12px;padding:12px;background:repeating-conic-gradient(#808080 0% 25%, #a0a0a0 0% 50%) 50% / 16px 16px;border-radius:8px;border:1px solid var(--gray-200);display:none">
          <img id="logo-preview-img" style="max-width:80px;max-height:80px;display:block">
        </div>
        <form id="logo-form" enctype="multipart/form-data">
          <input type="file" name="logo" accept=".svg,.jpg,.jpeg,.png">
          <button type="submit" class="btn btn-sm btn-secondary" style="margin-top:8px">Carica Logo</button>
        </form>
        <p style="font-size:11px;color:var(--gray-400);margin-top:4px">Formati: SVG, JPG, PNG (max 5MB)</p>
      </div>
      <!-- Theme Section -->
      <div>
        <p style="font-size:13px;color:var(--gray-500);margin-bottom:12px" id="theme-status-text">Tema CSS: <span id="theme-status-value"><%- client.theme_filename ? '<span style="color:#16a34a">&#10003;</span> ' + client.theme_filename : 'non caricato' %></span></p>
        <!-- Brand colors pickers for theme generation -->
        <div style="margin-bottom:12px">
          <p style="font-size:12px;font-weight:600;color:var(--gray-600);margin-bottom:8px">Colori Brand</p>
          <div id="brand-colors-pickers" style="display:flex;flex-direction:column;gap:8px">
            <div class="color-picker-row" style="display:flex;align-items:center;gap:10px">
              <input type="color" id="brand-color-1" value="#6b9ef7" style="width:36px;height:36px;border:2px solid var(--gray-200);border-radius:8px;cursor:pointer;padding:2px">
              <div style="flex:1"><label style="font-size:11px;color:var(--gray-400);display:block">Colore primario</label><input type="text" id="brand-hex-1" value="#6b9ef7" style="font-size:13px;font-family:monospace;width:100%;padding:4px 8px;border:1px solid var(--gray-200);border-radius:4px" maxlength="7"></div>
            </div>
            <div class="color-picker-row" style="display:flex;align-items:center;gap:10px">
              <input type="color" id="brand-color-2" value="#1a1f2e" style="width:36px;height:36px;border:2px solid var(--gray-200);border-radius:8px;cursor:pointer;padding:2px">
              <div style="flex:1"><label style="font-size:11px;color:var(--gray-400);display:block">Colore secondario</label><input type="text" id="brand-hex-2" value="#1a1f2e" style="font-size:13px;font-family:monospace;width:100%;padding:4px 8px;border:1px solid var(--gray-200);border-radius:4px" maxlength="7"></div>
            </div>
            <div class="color-picker-row" style="display:flex;align-items:center;gap:10px">
              <input type="color" id="brand-color-3" value="#e8eaed" style="width:36px;height:36px;border:2px solid var(--gray-200);border-radius:8px;cursor:pointer;padding:2px">
              <div style="flex:1"><label style="font-size:11px;color:var(--gray-400);display:block">Colore terziario (opzionale)</label><input type="text" id="brand-hex-3" value="#e8eaed" style="font-size:13px;font-family:monospace;width:100%;padding:4px 8px;border:1px solid var(--gray-200);border-radius:4px" maxlength="7"></div>
            </div>
          </div>
          <button type="button" class="btn btn-sm btn-primary" id="generate-theme-btn" onclick="generateTheme()" style="margin-top:10px;width:100%"><span style="margin-right:3px">✨</span>Genera Tema da colori</button>
        </div>
        <!-- Theme CSS variables editor (visible when theme exists) -->
        <div id="theme-colors-container" style="display:none;border-top:1px solid var(--gray-200);padding-top:12px;margin-bottom:12px">
          <p style="font-size:12px;font-weight:600;color:var(--gray-600);margin-bottom:8px">Variabili Tema CSS</p>
          <div id="theme-color-swatches" style="display:flex;flex-direction:column;gap:4px"></div>
          <button type="button" class="btn btn-sm btn-primary" id="save-colors-btn" onclick="saveThemeColors()" style="display:none;margin-top:10px;width:100%">Salva colori tema</button>
        </div>
        <form id="theme-form" enctype="multipart/form-data" style="border-top:1px solid var(--gray-200);padding-top:12px">
          <p style="font-size:11px;color:var(--gray-400);margin-bottom:6px">Oppure carica un file CSS manualmente</p>
          <input type="file" name="theme" accept=".css">
          <button type="submit" class="btn btn-sm btn-secondary" style="margin-top:8px">Carica Tema CSS</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Responses modal -->
<div class="modal-overlay" id="responses-modal">
  <div class="modal" style="max-width:700px">
    <h2>Risposte Questionario</h2>
    <pre id="responses-content" style="white-space:pre-wrap;font-size:13px;max-height:60vh;overflow-y:auto;background:var(--gray-50);padding:16px;border-radius:6px"></pre>
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="closeModal('responses-modal')">Chiudi</button>
    </div>
  </div>
</div>

<style>.btn-copy{display:flex;align-items:center;justify-content:center;width:34px;min-width:34px;height:34px;border:1px solid var(--gray-200);border-radius:6px;background:var(--gray-50);color:var(--gray-400);cursor:pointer;transition:all .15s}.btn-copy:hover{background:var(--gray-100);color:var(--gray-600)}.btn-copy.copied{background:#dcfce7;border-color:#86efac;color:#16a34a}</style>
<script>
  const CLIENT_ID = '<%= client.id %>';

  function copyField(btn) {
    const input = btn.closest('div').querySelector('input');
    if (!input || !input.value) return;
    navigator.clipboard.writeText(input.value).then(() => {
      btn.classList.add('copied');
      const orig = btn.innerHTML;
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = orig; }, 1500);
    });
  }

  // Tabs — persist active tab in location.hash so reloads/deletes keep context
  function activateTab(name) {
    const btn = document.querySelector('.tab[data-tab="' + name + '"]');
    const pane = document.getElementById('tab-' + name);
    if (!btn || !pane) return false;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    pane.classList.add('active');
    return true;
  }
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      activateTab(tab.dataset.tab);
      history.replaceState(null, '', '#' + tab.dataset.tab);
    });
  });
  // Honor hash on load (e.g. after reload from deletePlan)
  const initialTab = (location.hash || '').replace(/^#/, '');
  if (initialTab) activateTab(initialTab);

  // ─────────────── Libreria Media ───────────────
  function fmtBytes(n) {
    if (!n) return '—';
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' KB';
    return (n / (1024 * 1024)).toFixed(1) + ' MB';
  }
  function escAttr(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c])); }

  // Paginazione client-side della libreria.
  // PAGE_SIZE differente per video (grid 2D) vs audio (lista 1D).
  const LIB_PAGE_SIZE = { video: 12, audio: 10 };
  const libCache = { video: [], audio: [] };
  const libPage  = { video: 1, audio: 1 };

  async function loadLibrary() {
    try {
      const data = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/library');
      const items = (data && data.items) || [];
      libCache.video = items.filter(i => i.kind === 'video');
      libCache.audio = items.filter(i => i.kind === 'audio');
      // Reset alla prima pagina ogni volta che ricarico (es. dopo upload/delete)
      libPage.video = 1;
      libPage.audio = 1;
      renderLibPage('video');
      renderLibPage('audio');
    } catch (err) {
      console.warn('[library] load failed:', err.message);
    }
  }

  function renderLibPage(kind) {
    const all = libCache[kind] || [];
    const pageSize = LIB_PAGE_SIZE[kind];
    const totalPages = Math.max(1, Math.ceil(all.length / pageSize));
    if (libPage[kind] > totalPages) libPage[kind] = totalPages;
    const page = libPage[kind];
    const start = (page - 1) * pageSize;
    const slice = all.slice(start, start + pageSize);
    renderLibList(kind, slice);
    renderLibPagination(kind, all.length, page, totalPages);
  }

  function renderLibPagination(kind, total, page, totalPages) {
    const box = document.getElementById('lib-' + kind + '-pagination');
    if (!box) return;
    if (total <= LIB_PAGE_SIZE[kind]) { box.innerHTML = ''; return; }
    const prevDis = page <= 1 ? 'disabled' : '';
    const nextDis = page >= totalPages ? 'disabled' : '';
    const fromN = total === 0 ? 0 : (page - 1) * LIB_PAGE_SIZE[kind] + 1;
    const toN = Math.min(page * LIB_PAGE_SIZE[kind], total);
    box.innerHTML =
      '<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:11px;color:var(--gray-600);padding-top:8px;border-top:1px solid var(--gray-100)">'
      + '<span>' + fromN + '–' + toN + ' di ' + total + '</span>'
      + '<div style="display:flex;gap:6px;align-items:center">'
      +   '<button class="btn btn-sm btn-secondary" ' + prevDis + ' onclick="libGoPage(\'' + kind + '\', ' + (page - 1) + ')" style="padding:3px 8px;font-size:11px">← Prev</button>'
      +   '<span>Pag. ' + page + ' / ' + totalPages + '</span>'
      +   '<button class="btn btn-sm btn-secondary" ' + nextDis + ' onclick="libGoPage(\'' + kind + '\', ' + (page + 1) + ')" style="padding:3px 8px;font-size:11px">Next →</button>'
      + '</div>'
      + '</div>';
  }

  function libGoPage(kind, n) {
    const total = (libCache[kind] || []).length;
    const totalPages = Math.max(1, Math.ceil(total / LIB_PAGE_SIZE[kind]));
    if (n < 1 || n > totalPages) return;
    libPage[kind] = n;
    renderLibPage(kind);
  }
  window.libGoPage = libGoPage;

  function renderLibList(kind, items) {
    const root = document.getElementById('lib-' + kind + '-list');
    if (!root) return;
    if (!items.length) {
      root.innerHTML = '<div class="lib-empty" style="' + (kind === 'video'
        ? 'grid-column:1/-1;'
        : '') + 'color:var(--gray-400);font-size:12px;text-align:center;padding:18px 0">— Nessun ' + kind + ' —</div>';
      return;
    }
    if (kind === 'video') {
      root.innerHTML = items.map(it => `
        <div style="border:1px solid var(--gray-200);border-radius:6px;overflow:hidden;background:#000;position:relative">
          <div onclick="openLibraryVideoPreview('${escAttr(it.url)}', '${escAttr(it.original_name || it.filename)}')" style="position:relative;cursor:pointer;background:#000;aspect-ratio:9/16" title="Click per vedere l'anteprima">
            <video src="${escAttr(it.url)}#t=0.5" muted preload="metadata" style="width:100%;height:100%;object-fit:contain;display:block;background:#000;pointer-events:none"></video>
            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.15);transition:background 0.15s" onmouseover="this.style.background='rgba(0,0,0,0.35)'" onmouseout="this.style.background='rgba(0,0,0,0.15)'">
              <div style="width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,0.9);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,0.3)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="#1f2937"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <div style="padding:6px 8px;background:#fff;border-top:1px solid var(--gray-200)">
            <div style="font-size:11px;font-weight:600;color:var(--gray-700);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${escAttr(it.original_name || it.filename)}">${escAttr(it.original_name || it.filename)}</div>
            <div style="font-size:10px;color:var(--gray-500);display:flex;justify-content:space-between;align-items:center;margin-top:3px">
              <span>${fmtBytes(it.bytes)}</span>
              <button onclick="deleteLibraryItem('${escAttr(it.id)}', '${escAttr(it.original_name || it.filename)}')" title="Elimina dalla libreria" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:14px;padding:0 2px;line-height:1">🗑</button>
            </div>
          </div>
        </div>
      `).join('');
    } else {
      root.innerHTML = items.map(it => `
        <div style="border:1px solid var(--gray-200);border-radius:6px;padding:8px 10px;display:flex;flex-direction:column;gap:6px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
            <span style="font-size:12px;font-weight:600;color:var(--gray-700);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${escAttr(it.original_name || it.filename)}">${escAttr(it.original_name || it.filename)}</span>
            <span style="font-size:10px;color:var(--gray-500);flex-shrink:0">${fmtBytes(it.bytes)}</span>
            <button onclick="deleteLibraryItem('${escAttr(it.id)}', '${escAttr(it.original_name || it.filename)}')" title="Elimina dalla libreria" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:14px;padding:0 2px;line-height:1">🗑</button>
          </div>
          <audio src="${escAttr(it.url)}" controls preload="none" style="width:100%;height:30px"></audio>
        </div>
      `).join('');
    }
  }

  async function uploadLibraryFile(kind) {
    const input = document.getElementById('lib-' + kind + '-input');
    const btn = document.getElementById('lib-' + kind + '-btn');
    const progress = document.getElementById('lib-' + kind + '-progress');
    if (!input.files || !input.files.length) {
      await showAlert('Seleziona uno o più file ' + kind);
      return;
    }
    const files = Array.from(input.files);
    btn.disabled = true;
    const orig = btn.textContent;
    btn.textContent = 'Caricando…';
    progress.style.display = 'block';
    progress.textContent = 'Upload di ' + files.length + ' file in corso…';

    const fd = new FormData();
    files.forEach(f => fd.append('files', f));

    try {
      const r = await fetch('/dashboard/api/clients/' + CLIENT_ID + '/library/upload', {
        method: 'POST',
        body: fd
      });
      const data = await r.json();
      const ok = (data.items || []).length;
      const errs = data.errors || [];
      if (!r.ok && !ok) {
        await showAlert(data.error || 'Upload fallito');
        return;
      }
      input.value = '';
      if (errs.length) {
        const detail = errs.map(e => '• ' + e.filename + ': ' + e.error).join('\n');
        await showAlert(ok + ' file caricati, ' + errs.length + ' falliti:\n\n' + detail);
      } else {
        toast(ok === 1
          ? (kind === 'video' ? 'Video aggiunto in libreria' : 'Audio aggiunto in libreria')
          : ok + ' ' + kind + ' aggiunti in libreria');
      }
      loadLibrary();
    } catch (err) {
      await showAlert('Errore upload: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = orig;
      progress.style.display = 'none';
      progress.textContent = '';
    }
  }
  window.uploadLibraryFile = uploadLibraryFile;

  async function deleteLibraryItem(itemId, name) {
    if (!await showConfirm('Eliminare "' + name + '" dalla libreria? I post che lo stanno usando NON saranno modificati (mantengono la propria copia).')) return;
    try {
      const res = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/library/' + itemId, { method: 'DELETE' });
      if (res.error) { await showAlert(res.error); return; }
      toast('Eliminato dalla libreria');
      loadLibrary();
    } catch (err) {
      await showAlert('Errore: ' + err.message);
    }
  }
  window.deleteLibraryItem = deleteLibraryItem;

  // Apre una lightbox con il player video grande (controls + autoplay).
  // Più affidabile dell'inline preview nelle card piccole della grid.
  function openLibraryVideoPreview(url, name) {
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
    const escAttr = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;"}[c]));
    overlay.innerHTML = `
      <div style="position:relative;max-width:90vw;max-height:90vh;display:flex;flex-direction:column;gap:8px">
        <div style="display:flex;justify-content:space-between;align-items:center;color:#fff;font-size:13px">
          <span style="font-weight:600;max-width:70vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escAttr(name)}</span>
          <button id="lvp-close" style="background:rgba(255,255,255,0.15);border:none;color:#fff;font-size:18px;width:32px;height:32px;border-radius:50%;cursor:pointer;line-height:1">×</button>
        </div>
        <video src="${escAttr(url)}" controls autoplay style="max-width:90vw;max-height:80vh;background:#000;border-radius:8px;box-shadow:0 10px 40px rgba(0,0,0,0.5)"></video>
      </div>
    `;
    document.body.appendChild(overlay);
    const close = () => overlay.remove();
    overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
    overlay.querySelector('#lvp-close').onclick = close;
    const onKey = e => { if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onKey); } };
    document.addEventListener('keydown', onKey);
  }
  window.openLibraryVideoPreview = openLibraryVideoPreview;

  // Lazy-load alla prima apertura del tab Libreria
  let libraryLoaded = false;
  function ensureLibraryLoaded() {
    if (libraryLoaded) return;
    libraryLoaded = true;
    loadLibrary();
  }
  document.querySelectorAll('.tab[data-tab="libreria"]').forEach(b => {
    b.addEventListener('click', ensureLibraryLoaded);
  });
  if (initialTab === 'libreria') ensureLibraryLoaded();

  // Profile form
  document.getElementById('profile-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = {};
    new FormData(form).forEach((v, k) => { if (v) data[k] = v; });
    await apiFetch('/dashboard/api/clients/' + CLIENT_ID, { method: 'PUT', body: data });
    window.location.reload();
  });

  // Social form
  document.getElementById('social-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {};
    new FormData(e.target).forEach((v, k) => { data[k] = v; });
    await apiFetch('/dashboard/api/clients/' + CLIENT_ID, { method: 'PUT', body: data });
    toast('Credenziali salvate');
  });

  // AI provider toggle
  function toggleAiKeyFields() {
    const provider = document.getElementById('ai-provider-select').value;
    document.getElementById('gemini-key-group').style.display = provider === 'gemini' ? '' : 'none';
    document.getElementById('anthropic-key-group').style.display = provider === 'claude' ? '' : 'none';
  }
  document.getElementById('ai-provider-select').addEventListener('change', toggleAiKeyFields);
  toggleAiKeyFields();

  // AI form
  document.getElementById('ai-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {};
    new FormData(e.target).forEach((v, k) => { data[k] = v; });
    await apiFetch('/dashboard/api/clients/' + CLIENT_ID, { method: 'PUT', body: data });
    toast('Configurazione AI salvata');
  });

  // Logo preview loader (uses authenticated fetch → blob URL)
  async function loadLogoPreview() {
    const token = localStorage.getItem('dashboard_token');
    try {
      const res = await fetch('/dashboard/api/clients/' + CLIENT_ID + '/logo-preview', {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      if (!res.ok) return;
      const blob = await res.blob();
      const img = document.getElementById('logo-preview-img');
      img.src = URL.createObjectURL(blob);
      document.getElementById('logo-preview-container').style.display = 'inline-block';
    } catch (err) { /* no logo, container stays hidden */ }
  }
  <% if (client.logo_filename) { %>loadLogoPreview();<% } %>

  // Logo upload with FileReader preview
  document.getElementById('logo-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fileInput = e.target.querySelector('input[type="file"]');
    const file = fileInput.files[0];
    if (!file) return;

    const formData = new FormData(e.target);
    const token = localStorage.getItem('dashboard_token');
    const res = await fetch('/dashboard/api/clients/' + CLIENT_ID + '/logo', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token },
      body: formData
    });
    if (res.ok) {
      // Show preview using FileReader (no endpoint dependency)
      const reader = new FileReader();
      reader.onload = function(ev) {
        const img = document.getElementById('logo-preview-img');
        img.src = ev.target.result;
        document.getElementById('logo-preview-container').style.display = 'inline-block';
      };
      reader.readAsDataURL(file);
      document.getElementById('logo-status-value').innerHTML = '<span style="color:#16a34a">&#10003;</span> logo-' + CLIENT_ID + '.svg';
      updateBrandingStatus();
      toast('Logo caricato');
    }
  });

  // Theme upload
  document.getElementById('theme-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const token = localStorage.getItem('dashboard_token');
    const res = await fetch('/dashboard/api/clients/' + CLIENT_ID + '/theme', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + token },
      body: formData
    });
    if (res.ok) {
      document.getElementById('theme-status-value').innerHTML = '<span style="color:#16a34a">&#10003;</span> ' + CLIENT_ID + '.css';
      loadThemeColors();
      updateBrandingStatus();
      toast('Tema caricato');
    }
  });

  // --- Brand color pickers sync ---
  for (let i = 1; i <= 3; i++) {
    const picker = document.getElementById('brand-color-' + i);
    const hex = document.getElementById('brand-hex-' + i);
    picker.addEventListener('input', () => { hex.value = picker.value; });
    hex.addEventListener('input', () => {
      const v = hex.value.trim();
      if (/^#[0-9a-fA-F]{6}$/.test(v)) picker.value = v;
    });
  }

  function setBrandColors(colors) {
    for (let i = 0; i < 3; i++) {
      if (colors[i]) {
        const c = colors[i].length === 4 ? '#' + colors[i][1]+colors[i][1]+colors[i][2]+colors[i][2]+colors[i][3]+colors[i][3] : colors[i];
        document.getElementById('brand-color-' + (i + 1)).value = c;
        document.getElementById('brand-hex-' + (i + 1)).value = c;
      }
    }
  }

  function getBrandColors() {
    const colors = [];
    for (let i = 1; i <= 3; i++) {
      const v = document.getElementById('brand-hex-' + i).value.trim();
      if (/^#[0-9a-fA-F]{6}$/.test(v)) colors.push(v);
    }
    return colors;
  }

  // --- Theme CSS variables management ---

  const CSS_VAR_LABELS = {
    '--bg-deep': 'Sfondo profondo', '--bg-primary': 'Sfondo principale', '--bg-card': 'Sfondo card', '--bg-elevated': 'Sfondo elevato',
    '--accent': 'Accent', '--accent-light': 'Accent chiaro', '--accent-silver': 'Accent argento', '--accent-bright': 'Accent brillante',
    '--text-primary': 'Testo primario', '--text-light': 'Testo chiaro', '--text-medium': 'Testo medio', '--text-muted': 'Testo muto',
    '--border-cool': 'Bordo cool', '--border-elevated': 'Bordo elevato',
    '--glass-bg': 'Glass bg', '--overlay-top': 'Overlay top', '--overlay-bottom': 'Overlay bottom'
  };

  const CSS_VAR_GROUPS = {
    'Backgrounds': ['--bg-deep', '--bg-primary', '--bg-card', '--bg-elevated'],
    'Accents': ['--accent', '--accent-light', '--accent-silver', '--accent-bright'],
    'Testi': ['--text-primary', '--text-light', '--text-medium', '--text-muted'],
    'Bordi': ['--border-cool', '--border-elevated'],
    'Effetti': ['--glass-bg', '--overlay-top', '--overlay-bottom']
  };

  let currentThemeColors = {};

  function hexFromValue(val) {
    val = val.trim();
    if (val.startsWith('#')) return val.substring(0, 7);
    const rgbaMatch = val.match(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/);
    if (rgbaMatch) {
      return '#' + parseInt(rgbaMatch[1]).toString(16).padStart(2, '0') +
        parseInt(rgbaMatch[2]).toString(16).padStart(2, '0') +
        parseInt(rgbaMatch[3]).toString(16).padStart(2, '0');
    }
    return '#888888';
  }

  function renderThemeSwatches(colors) {
    const container = document.getElementById('theme-color-swatches');
    const wrapper = document.getElementById('theme-colors-container');
    container.innerHTML = '';

    if (!Object.keys(colors).length) { wrapper.style.display = 'none'; return; }
    wrapper.style.display = 'block';

    for (const [groupName, vars] of Object.entries(CSS_VAR_GROUPS)) {
      const header = document.createElement('div');
      header.style.cssText = 'font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.5px;margin-top:8px;margin-bottom:2px';
      header.textContent = groupName;
      container.appendChild(header);

      vars.forEach(varName => {
        if (!colors[varName]) return;
        const hex = hexFromValue(colors[varName]);
        const row = document.createElement('div');
        row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:3px 0';
        row.innerHTML =
          '<input type="color" value="' + hex + '" data-var="' + varName + '" style="width:30px;height:30px;border:2px solid var(--gray-200);border-radius:6px;cursor:pointer;padding:1px">' +
          '<div style="flex:1"><label style="font-size:11px;color:var(--gray-400);display:block">' + (CSS_VAR_LABELS[varName] || varName) + '</label>' +
          '<input type="text" value="' + colors[varName] + '" data-var="' + varName + '" style="font-size:12px;font-family:monospace;width:100%;padding:2px 6px;border:1px solid var(--gray-200);border-radius:4px" maxlength="30"></div>';

        const colorInput = row.querySelector('input[type="color"]');
        const textInput = row.querySelector('input[type="text"]');

        colorInput.addEventListener('input', function() {
          textInput.value = this.value;
          currentThemeColors[varName] = this.value;
          document.getElementById('save-colors-btn').style.display = '';
        });
        textInput.addEventListener('input', function() {
          const v = this.value.trim();
          const h = hexFromValue(v);
          colorInput.value = h;
          currentThemeColors[varName] = v;
          document.getElementById('save-colors-btn').style.display = '';
        });
        container.appendChild(row);
      });
    }
  }

