  async function loadInsightsShareLinks() {
    const container = document.getElementById('insights-share-list');
    if (!container) return;
    // dashboard.js (apiFetch) è caricato da layout-end DOPO questo script inline.
    // Se siamo veloci nel cliccare il tab Performance, può non essere ancora pronto.
    if (typeof apiFetch !== 'function') {
      container.innerHTML = '<p style="font-size:13px;color:var(--gray-400)">Caricamento…</p>';
      window.addEventListener('load', loadInsightsShareLinks, { once: true });
      return;
    }
    try {
      const res = await apiFetch('/dashboard/api/insights-share/admin/clients/' + CLIENT_ID, { method: 'GET' });
      const links = (res && res.links) || [];
      const active = links.filter(l => l.status === 'active');
      if (!active.length) {
        container.innerHTML = '<p style="font-size:13px;color:var(--gray-400)">Nessun link attivo. Clicca "Genera link condivisibile" per crearne uno.</p>';
        return;
      }
      container.innerHTML = active.map(l => {
        const url = window.location.origin + '/dashboard/insights/' + l.token;
        const expires = l.expires_at ? new Date(l.expires_at).toLocaleDateString('it-IT') : 'Nessuna';
        const lastView = l.last_viewed_at ? new Date(l.last_viewed_at.replace(' ','T')+'Z').toLocaleString('it-IT') : 'Mai aperto';
        return `
          <div style="border:1px solid var(--gray-200);border-radius:8px;padding:12px 14px;margin-bottom:10px">
            <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px">
              <input type="text" readonly value="${url}" style="flex:1;font-family:monospace;font-size:12px;padding:6px 10px;border:1px solid var(--gray-200);border-radius:6px;background:var(--gray-50)">
              <button class="btn btn-sm btn-secondary" onclick="navigator.clipboard.writeText(this.previousElementSibling.value);toast('Link copiato')">Copia</button>
              <button class="btn btn-sm btn-secondary" onclick="window.open('${url}','_blank')">Apri</button>
              <button class="btn btn-sm" style="color:var(--red);border-color:var(--red)" onclick="revokeInsightsShare('${l.id}')">Revoca</button>
            </div>
            <div style="font-size:11px;color:var(--gray-500)">
              Periodo dati: ultimi ${l.period_days}gg · Scade: ${expires} · Ultimo accesso: ${lastView} · Visite: ${l.view_count || 0}
              ${l.label ? ' · "'+escapeHtmlSafe(l.label)+'"' : ''}
            </div>
          </div>
        `;
      }).join('');
    } catch (err) {
      container.innerHTML = '<p style="font-size:13px;color:var(--red)">Errore: ' + (err.message || err) + '</p>';
    }
  }

  function escapeHtmlSafe(s) {
    return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  }

  async function createInsightsShare() {
    const periodDays = prompt('Periodo dati da mostrare (giorni)', '30');
    if (periodDays === null) return;
    const expiresDays = prompt('Scadenza link (giorni, 0 = nessuna)', '90');
    if (expiresDays === null) return;
    const label = prompt('Etichetta opzionale (es. "Report 2026")', '');
    try {
      const res = await apiFetch('/dashboard/api/insights-share/admin/clients/' + CLIENT_ID, {
        method: 'POST',
        body: {
          period_days: parseInt(periodDays, 10) || 30,
          expires_days: parseInt(expiresDays, 10) || 0,
          label: label || null
        }
      });
      if (res && res.link) {
        toast('Link creato');
        loadInsightsShareLinks();
      } else {
        await showAlert('Errore: ' + (res && res.error ? res.error : 'risposta inattesa'));
      }
    } catch (err) { await showAlert('Errore: ' + (err.message || err)); }
  }

  async function revokeInsightsShare(linkId) {
    if (!await showConfirm('Sicuro di voler revocare il link? Il cliente non potrà più accedere alla dashboard.')) return;
    try {
      await apiFetch('/dashboard/api/insights-share/admin/' + linkId, { method: 'DELETE' });
      toast('Link revocato');
      loadInsightsShareLinks();
    } catch (err) { await showAlert('Errore: ' + (err.message || err)); }
  }

  // Mantiene href del link "Scarica PDF" sincronizzato col selettore periodo.
  // Usiamo un vero <a> invece di window.open() perché su mobile i popup
  // programmatici spesso vengono bloccati dal browser.
  function updateReportPdfHref() {
    const link = document.getElementById('report-pdf-link');
    const sel = document.getElementById('report-days');
    if (!link || !sel) return;
    link.href = '/dashboard/api/clients/' + encodeURIComponent(CLIENT_ID) + '/insights/report.pdf?days=' + encodeURIComponent(sel.value);
  }

  async function emailReportToClient() {
    const days = document.getElementById('report-days').value;
    const out = document.getElementById('report-result');
    const ce = document.getElementById('contact-email-display').textContent.trim();
    if (!ce || ce === '—' || ce === 'non impostata') {
      if (!await showConfirm('Il cliente non ha contact_email configurata. Inserire un indirizzo manualmente?')) return;
      const customTo = prompt('Email destinatario:');
      if (!customTo) return;
      out.innerHTML = '<span style="color:var(--gray-400)">Generazione PDF + invio email…</span>';
      try {
        const res = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/insights/email-report?days=' + days, {
          method: 'POST', body: { to: customTo }
        });
        if (res && res.ok) {
          out.innerHTML = '<span style="color:var(--green)">✓ Email inviata a ' + escapeHtmlSafe(res.sent_to) + ' (' + Math.round(res.bytes/1024) + ' KB)</span>';
        } else {
          out.innerHTML = '<span style="color:var(--red)">Errore: ' + (res && res.error ? res.error : 'sconosciuto') + '</span>';
        }
      } catch (err) { out.innerHTML = '<span style="color:var(--red)">Errore: ' + (err.message || err) + '</span>'; }
      return;
    }
    if (!await showConfirm('Inviare il report a ' + ce + '?')) return;
    out.innerHTML = '<span style="color:var(--gray-400)">Generazione PDF + invio email…</span>';
    try {
      const res = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/insights/email-report?days=' + days, { method: 'POST' });
      if (res && res.ok) {
        out.innerHTML = '<span style="color:var(--green)">✓ Email inviata a ' + escapeHtmlSafe(res.sent_to) + ' (' + Math.round(res.bytes/1024) + ' KB)</span>';
      } else {
        out.innerHTML = '<span style="color:var(--red)">Errore: ' + (res && res.error ? res.error : 'sconosciuto') + '</span>';
      }
    } catch (err) { out.innerHTML = '<span style="color:var(--red)">Errore: ' + (err.message || err) + '</span>'; }
  }

  // Popola contact_email mostrato nel tab Performance (lettura dal form Profilo)
  document.addEventListener('DOMContentLoaded', () => {
    const inp = document.querySelector('input[name="contact_email"]');
    const span = document.getElementById('contact-email-display');
    if (inp && span) span.textContent = inp.value || 'non impostata';
  });

  async function triggerInsightsSnapshot() {
    const out = document.getElementById('snapshot-result');
    out.innerHTML = '<span style="color:var(--gray-400)">Snapshot in corso…</span>';
    try {
      const res = await apiFetch('/dashboard/api/clients/' + CLIENT_ID + '/insights/snapshot', { method: 'POST' });
      if (!res || !res.results) {
        if (res && res.error) out.innerHTML = '<span style="color:var(--red)">Errore: ' + res.error + '</span>';
        return;
      }
      // Mappa nomi tecnici → label human-friendly italiane
      const FIELD_LABELS = {
        fans: 'Fan/Follower pagina',
        followers: 'Follower',
        media_count: 'Post pubblicati totali',
        reach: 'Persone raggiunte (oggi)',
        impressions: 'Visualizzazioni (oggi)',
        profile_views: 'Visite al profilo (oggi)',
        engaged_users: 'Utenti coinvolti (oggi)'
      };
      const PLATFORM_INFO = {
        fb: { label: 'Facebook', color: '#1877f2' },
        ig: { label: 'Instagram', color: '#e4405f' }
      };
      const fmt = n => (n == null) ? '—' : Number(n).toLocaleString('it-IT');

      const cards = res.results.map(r => {
        const info = PLATFORM_INFO[r.platform] || { label: r.platform.toUpperCase(), color: '#6b7280' };
        const rows = Object.entries(r)
          .filter(([k,v]) => FIELD_LABELS[k] && v != null)
          .map(([k,v]) => `
            <div style="display:flex;align-items:baseline;gap:8px;padding:5px 0;border-bottom:1px solid var(--gray-100);font-size:13px">
              <span style="flex:1 1 auto;color:var(--gray-500);min-width:0">${FIELD_LABELS[k]}</span>
              <span style="flex:0 0 auto;font-weight:700;color:var(--gray-700);font-size:15px">${fmt(v)}</span>
            </div>`).join('');
        const errLine = r.error ? `<div style="margin-top:6px;padding:6px 8px;background:#fef2f2;color:var(--red);font-size:11px;border-radius:4px">⚠ ${escapeHtmlSafe(r.error)}</div>` : '';
        return `
          <div style="border:1px solid var(--gray-200);border-radius:8px;padding:10px 14px;margin-bottom:8px;background:white">
            <div style="display:inline-block;font-size:10px;font-weight:700;color:white;background:${info.color};padding:2px 8px;border-radius:3px;margin-bottom:8px;letter-spacing:0.5px">${info.label.toUpperCase()}</div>
            ${rows || '<div style="color:var(--gray-400);font-size:12px;font-style:italic;padding:6px 0">Nessun dato</div>'}
            ${errLine}
          </div>`;
      }).join('');

      const ts = new Date().toLocaleString('it-IT');
      out.innerHTML = cards + `<div style="font-size:11px;color:var(--gray-400);margin-top:6px">Aggiornato il ${ts}</div>`;
    } catch (err) { out.innerHTML = '<span style="color:var(--red)">Errore: ' + (err.message || err) + '</span>'; }
  }

  // Carica i link all'apertura del tab Performance (lazy se viene cliccato)
  document.querySelectorAll('.tab[data-tab="performance"]').forEach(b => {
    b.addEventListener('click', () => loadInsightsShareLinks());
  });
  // Se la pagina apre direttamente il tab performance via hash
  if (window.location.hash === '#performance') loadInsightsShareLinks();

</script>

<%- include('layout-end') %>
