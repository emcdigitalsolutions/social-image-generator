{
  "name": "social-image-generator",
  "version": "1.0.0",
  "description": "Self-hosted social media image generator with Puppeteer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.test.js"],
    "testPathIgnorePatterns": ["/node_modules/"]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^5.0.2",
    "express": "^4.21.0",
    "file-type": "^16.5.4",
    "image-size": "^1.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "puppeteer-core": "^23.5.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
